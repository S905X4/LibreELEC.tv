From 6f5b4b21f9cd59f29fff7b32103d2998e9b0b7b9 Mon Sep 17 00:00:00 2001
From: hiper25 <whydonit@gmail.com>
Date: Mon, 16 Nov 2026 01:59:19 +0800
Subject: [PATCH] media: meson: sc2: decouple VP9 repeats from held capture
 buffers

A renderer can hold the previous picture until the next presentation
arrives. Reusing that still-DONE CAPTURE for show-existing makes the
producer wait for requeue while the consumer waits for the repeat;
Kodi consequently fails drain with ETIMEDOUT.

Use the existing bounded compressed-display copy when a reference has
an outstanding presentation, not only when its old queue is detached.
Keep the original DPB and MV storage and never forcibly recycle a
consumer-owned buffer. Returned same-queue references remain zero-copy.

A native consumer holding picture10 until repeat11 now returns all12
pictures with exact pixels, genuine EOF and 909312 retained bytes
unchanged after close. The same input reaches natural Kodi EOF with
actual native FBC8 imagery. Production integration remains pending.

Change-Id: I090c4839dfdec41e881c655302b256a42c8e7c86
---
 .../platform/amlogic/meson-sc2-vdec/meson_sc2_vp9.h    | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_vp9.h b/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_vp9.h
index 7a3c78118150..2e953bdc9732 100644
--- a/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_vp9.h
+++ b/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_vp9.h
@@ -516,11 +516,11 @@ static int sc2_vp9_run(struct meson_sc2_hevc_context *ctx,
    smp_load_acquire(&hw->irq_sequence) != seq, remaining);
  }
 }
-/* An orphaned CAPTURE reference still owns its original FBC and MV storage.
- * A repeat needs a buffer in the current queue. Relocate only the compressed
+/* A reference may have left CAPTURE or still be held by a consumer.
+ * A repeat needs an available current-queue buffer. Copy only compressed
  * display bytes; the original DPB/MV and previous-picture identity stay put.
  */
-static int sc2_vp9_display_detached(struct meson_sc2_hevc_context *ctx,
+static int sc2_vp9_prepare_display(struct meson_sc2_hevc_context *ctx,
                                   const struct meson_sc2_vp9_job *job,
                                   struct sc2_surface_owner *owner, int *slot_index)
 {
@@ -539,7 +539,7 @@ static int sc2_vp9_display_detached(struct meson_sc2_hevc_context *ctx,
  int n;
 
  source_owner = container_of(src, struct sc2_surface_owner, surface);
- if (!source_owner->detached)
+ if (!source_owner->detached && !picture->outstanding)
   return 0;
  if (src->dma == dst->dma || src->size != dst->size ||
      src->width != dst->width || src->height != dst->height ||
@@ -627,7 +627,7 @@ static int sc2_vp9_repeat(struct meson_sc2_hevc_context *ctx,
  if (!dst || dst->width != ref->width || dst->height != ref->height ||
      dst->depth != ref->depth)
   return -EPIPE;
- ret = sc2_vp9_display_detached(ctx, job, owner, &slot);
+ ret = sc2_vp9_prepare_display(ctx, job, owner, &slot);
  if (ret)
   return ret;
  if (!sc2_surface_guards(st->slot[slot].surface))
