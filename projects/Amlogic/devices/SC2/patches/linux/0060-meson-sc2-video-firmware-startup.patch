From eee8e44df5157924b6f7c339555fe621436f428f Mon Sep 17 00:00:00 2001
From: hiper25 <whydonit@gmail.com>
Date: Thu, 22 Oct 2026 02:37:50 +0800
Subject: [PATCH] firmware: meson: add explicit SC2 video startup ABI

---
 .../ABI/testing/sysfs-firmware-meson-sc2      | 27 ++++++
 .../firmware/amlogic,meson-gxbb-sm.yaml       | 11 ++-
 drivers/firmware/meson/meson_sm.c             | 91 ++++++++++++++++++-
 include/linux/firmware/meson/meson_sm.h       |  4 +
 4 files changed, 131 insertions(+), 2 deletions(-)
 create mode 100644 Documentation/ABI/testing/sysfs-firmware-meson-sc2

diff --git a/Documentation/ABI/testing/sysfs-firmware-meson-sc2 b/Documentation/ABI/testing/sysfs-firmware-meson-sc2
new file mode 100644
index 0000000000000000000000000000000000000000..cead83bdc33e1c5f0425542891abd17dfddc889f
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-firmware-meson-sc2
@@ -0,0 +1,27 @@
+What:		/sys/bus/platform/devices/firmware:secure-monitor/boot_complete
+Date:		October 2026
+Contact:	Linux Amlogic mailing list <linux-amlogic@lists.infradead.org>
+Description:
+		Available only with amlogic,meson-sc2-sm firmware. Root-only
+		read/write (0600). Write exactly "1" (optional trailing newline)
+		only after validating the original local video TA and package.
+		The driver never issues this notification during probe.
+
+		The first valid write issues SMC 0xb200e060 with a1-a7 zero.
+		A mutex serializes writers, and the attempt is consumed before
+		entering firmware. A nonzero secure a0 returns EIO. Later writes
+		return the recorded result without issuing another SMC, including
+		after an interrupted/lost userspace reply or a nonzero status.
+		There is no reset/retry operation. The module is pinned after
+		the attempt so unload/reload cannot bypass the per-boot guard.
+
+		Before an attempt, reading returns:
+		  not-attempted
+		After an attempt has returned, reading returns:
+		  attempted a0=<hex> a1=<hex> a2=<hex> a3=<hex>
+		Each value is the complete native unsigned-long return register
+		(%#lx, zero is "0"); a newline terminates both forms. The raw
+		registers remain readable even if the write returned an error.
+		Neither notification success nor package preload constitutes
+		decode acceptance. Secure-world autonomous persistent effects
+		are not constrained by userspace RPC denial.
diff --git a/Documentation/devicetree/bindings/firmware/amlogic,meson-gxbb-sm.yaml b/Documentation/devicetree/bindings/firmware/amlogic,meson-gxbb-sm.yaml
index 8f50e698760e5aafacd916824ee783982e9485ae..b155072ce30f24d0acb0fa7f804bd75c9086f256 100644
--- a/Documentation/devicetree/bindings/firmware/amlogic,meson-gxbb-sm.yaml
+++ b/Documentation/devicetree/bindings/firmware/amlogic,meson-gxbb-sm.yaml
@@ -6,10 +6,16 @@ $schema: http://devicetree.org/meta-schemas/core.yaml#
 
 title: Amlogic Secure Monitor (SM)
 
-description:
+description: |
   In the Amlogic SoCs the Secure Monitor code is used to provide access to the
   NVMEM, enable JTAG, set USB boot, etc...
 
+  SC2 vendor firmware additionally provides video firmware-index loading and
+  an explicit boot-complete notification. The notification must not be issued
+  during probe: userspace validates its original local TA and firmware package
+  before requesting it through the secure-monitor device's boot_complete
+  attribute. It is consumed once per boot, including a nonzero secure status.
+
 maintainers:
   - Neil Armstrong <neil.armstrong@linaro.org>
 
@@ -20,6 +26,9 @@ properties:
       - items:
           - const: amlogic,meson-gx-sm
           - const: amlogic,meson-gxbb-sm
+      - items:
+          - const: amlogic,meson-sc2-sm
+          - const: amlogic,meson-gxbb-sm
 
   power-controller:
     type: object
diff --git a/drivers/firmware/meson/meson_sm.c b/drivers/firmware/meson/meson_sm.c
index 3ab67aaa9e5da9da7bd7ee66bf9da4f922d39d10..9935c0cbd74b435324f2e0c0ad4b86cbb74863f1 100644
--- a/drivers/firmware/meson/meson_sm.c
+++ b/drivers/firmware/meson/meson_sm.c
@@ -12,6 +12,7 @@
 #include <linux/bug.h>
 #include <linux/io.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
@@ -51,6 +52,28 @@ static const struct meson_sm_chip gxbb_chip = {
 	},
 };
 
+/* Function 15 is the SC2 video-index ABI, not OP-TEE GET_THREAD_COUNT. */
+static const struct meson_sm_chip sc2_chip = {
+	.shmem_size		= SZ_4K,
+	.cmd_shmem_in_base	= 0x82000020,
+	.cmd_shmem_out_base	= 0x82000021,
+	.cmd = {
+		CMD(SM_EFUSE_READ,	0x82000030),
+		CMD(SM_EFUSE_WRITE,	0x82000031),
+		CMD(SM_EFUSE_USER_MAX,	0x82000033),
+		CMD(SM_GET_CHIP_ID,	0x82000044),
+		CMD(SM_A1_PWRC_SET,	0x82000093),
+		CMD(SM_A1_PWRC_GET,	0x82000095),
+		CMD(SM_VIDEO_FW_LOAD,	0xb200000f),
+		{ /* sentinel */ },
+	},
+};
+
+/* Global, not per-probe: reprobe must not reset a consumed notification. */
+static DEFINE_MUTEX(sc2_boot_complete_lock);
+static bool sc2_boot_complete_attempted;
+static struct arm_smccc_res sc2_boot_complete_result;
+
 struct meson_sm_firmware {
 	const struct meson_sm_chip *chip;
 	void __iomem *sm_shmem_in_base;
@@ -279,13 +302,79 @@ static ssize_t serial_show(struct device *dev, struct device_attribute *attr,
 
 static DEVICE_ATTR_RO(serial);
 
+static ssize_t boot_complete_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	const struct arm_smccc_res *res = &sc2_boot_complete_result;
+	ssize_t ret;
+
+	mutex_lock(&sc2_boot_complete_lock);
+	if (!sc2_boot_complete_attempted)
+		ret = sysfs_emit(buf, "not-attempted\n");
+	else
+		ret = sysfs_emit(buf, "attempted a0=%#lx a1=%#lx a2=%#lx a3=%#lx\n",
+				 res->a0, res->a1, res->a2, res->a3);
+	mutex_unlock(&sc2_boot_complete_lock);
+	return ret;
+}
+
+static ssize_t boot_complete_store(struct device *dev,
+				   struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	int ret;
+
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	ret = mutex_lock_interruptible(&sc2_boot_complete_lock);
+	if (ret)
+		return ret;
+	if (!sc2_boot_complete_attempted) {
+		/* Pin the module so unload/reload cannot reset the per-boot guard.
+		 * Consume the attempt before entering firmware: uncertain delivery
+		 * and nonzero status must never cause an automatic second call.
+		 */
+		if (!try_module_get(THIS_MODULE)) {
+			ret = -ENODEV;
+			goto unlock;
+		}
+		sc2_boot_complete_attempted = true;
+		arm_smccc_smc(0xb200e060, 0, 0, 0, 0, 0, 0, 0,
+			      &sc2_boot_complete_result);
+		dev_notice(dev, "boot-complete a0=%#lx a1=%#lx a2=%#lx a3=%#lx\n",
+			   sc2_boot_complete_result.a0, sc2_boot_complete_result.a1,
+			   sc2_boot_complete_result.a2, sc2_boot_complete_result.a3);
+	}
+	ret = sc2_boot_complete_result.a0 ? -EIO : 0;
+unlock:
+	mutex_unlock(&sc2_boot_complete_lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR(boot_complete, 0600, boot_complete_show, boot_complete_store);
+
+static umode_t meson_sm_sysfs_is_visible(struct kobject *kobj,
+				       struct attribute *attr, int index)
+{
+	struct meson_sm_firmware *fw = dev_get_drvdata(kobj_to_dev(kobj));
+
+	if (attr == &dev_attr_boot_complete.attr && fw->chip != &sc2_chip)
+		return 0;
+	return attr->mode;
+}
+
 static struct attribute *meson_sm_sysfs_attrs[] = {
 	&dev_attr_serial.attr,
+	&dev_attr_boot_complete.attr,
 	NULL,
 };
-ATTRIBUTE_GROUPS(meson_sm_sysfs);
+static const struct attribute_group meson_sm_sysfs_group = {
+	.attrs = meson_sm_sysfs_attrs,
+	.is_visible = meson_sm_sysfs_is_visible,
+};
+__ATTRIBUTE_GROUPS(meson_sm_sysfs);
 
 static const struct of_device_id meson_sm_ids[] = {
+	{ .compatible = "amlogic,meson-sc2-sm", .data = &sc2_chip },
 	{ .compatible = "amlogic,meson-gxbb-sm", .data = &gxbb_chip },
 	{ /* sentinel */ },
 };
diff --git a/include/linux/firmware/meson/meson_sm.h b/include/linux/firmware/meson/meson_sm.h
index 8eaf8922ab020a9de7d383ae9fcd022a7e21a88a..cef96aef8dc0d248f98ef11eb9909f3766df8604 100644
--- a/include/linux/firmware/meson/meson_sm.h
+++ b/include/linux/firmware/meson/meson_sm.h
@@ -14,6 +14,10 @@ enum {
 	SM_GET_CHIP_ID,
 	SM_A1_PWRC_SET,
 	SM_A1_PWRC_GET,
+	/* SC2: index, decoder core and swap in arg0..arg2; arg3/arg4 = 0.
+	 * meson_sm_call() returns transport status; *ret is raw secure status.
+	 */
+	SM_VIDEO_FW_LOAD,
 };
 
 struct meson_sm_firmware;
