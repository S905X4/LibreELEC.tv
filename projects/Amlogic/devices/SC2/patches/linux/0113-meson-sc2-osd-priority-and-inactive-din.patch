From b36536911beb723ebe50151355036140be4785c2 Mon Sep 17 00:00:00 2001
From: hiper25 <whydonit@gmail.com>
Date: Fri, 13 Nov 2026 23:40:30 +0800
Subject: [PATCH] drm: meson: preserve SC2 OSD priority and inactive DIN
 selection

Assign increasing immutable OSD z-order to increasing active DINs.
The previous descending source walk put opaque OSD1 above its higher
priority siblings. A controlled mux-only HDMI observation restores the
existing linear rectangles without changing fetch or scaler state.

Select OSD4 for inactive DINs as in the SC2 legacy shift workaround.
With the primary disabled, switching only the unused selections from
zero to four restores the independently owned sibling surfaces.
Do not change the single-primary bypass path or source-indexed scopes.

Change-Id: I73c6b8edd19c8aced1baa3d01f61bfe4c6ef26eb
---
 drivers/gpu/drm/meson/meson_crtc.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/meson/meson_crtc.c b/drivers/gpu/drm/meson/meson_crtc.c
index 3a21c5b43c8a..a161f3b44cbc 100644
--- a/drivers/gpu/drm/meson/meson_crtc.c
+++ b/drivers/gpu/drm/meson/meson_crtc.c
@@ -219,9 +219,9 @@ static void meson_crtc_sc2_osd_blend(struct meson_drm *priv)
 			       _REG(VIU_OSD_BLEND_DIN0_SCOPE_V + index * 2));
 	}
 	if (!bypass) {
-		/* BSP ABC: DIN0 is top, DIN2 middle, DIN3 bottom. */
+		/* DIN0 is below DIN2, which is below DIN3. */
 		control |= VIU_OSD_BLEND_BLEN2_PREMULT_EN(3) |
-			   VIU_OSD_BLEND_DIN_EN(5);
+			   VIU_OSD_BLEND_DIN_EN(5) | 0x4444;
 	} else {
 		/* Preserve the deployed single-OSD bypass path. */
 		control |= VIU_OSD_BLEND_BLEN2_PREMULT_EN(1) |
@@ -229,7 +229,7 @@ static void meson_crtc_sc2_osd_blend(struct meson_drm *priv)
 			   VIU_OSD_BLEND1_DIN3_BYPASS_TO_DOUT1 |
 			   VIU_OSD_BLEND1_DOUT_BYPASS_TO_BLEND2;
 	}
-	for (index = MESON_MAX_OSDS; index-- > 0;) {
+	for (index = 0; index < MESON_MAX_OSDS; index++) {
 		const struct meson_osd_state *osd = &priv->viu.osd[index];
 		unsigned int din;
 
@@ -237,6 +237,8 @@ static void meson_crtc_sc2_osd_blend(struct meson_drm *priv)
 			continue;
 		din = !input ? 0 : input == count - 1 ? 3 : 2;
 		input++;
+		/* Inactive DINs select OSD4 for the SC2 shift workaround. */
+		control &= ~(0xf << (din * 4));
 		control |= VIU_OSD_BLEND_REORDER(din, index + 1) |
 			   VIU_OSD_BLEND_DIN_EN(BIT(din));
 		/* BSP divides premultiplied pixels before blend0/1 multiplication. */
-- 
2.47.3

