   The Amlogic Meson Synopsys Designware Integration is composed of
@@ -44,6 +67,12 @@ description: |
   HDMI TX IP version 2.01a with HDCP and I2C & S/PDIF
   audio source interfaces.
 
+  SC2 uses the HDMI 2.0 TMDS controller, not the HDMI 2.1 FRL controller.
+  DWC and TOP have separate direct MMIO windows; TOP precedes DWC in the
+  physical address map. The PHY and PLL are in ANACTRL, and the HDMI system
+  and pixel clocks are in CLKCTRL. Resetting the video PLL divider is also
+  required on SC2. Its PHY analog settings differ from G12A.
+
 properties:
   compatible:
     oneOf:
@@ -55,9 +84,16 @@ properties:
           - const: amlogic,meson-gx-dw-hdmi
       - enum:
           - amlogic,meson-g12a-dw-hdmi # G12A (S905X2, S905Y2, S905D2)
+          - amlogic,meson-sc2-dw-hdmi # SC2 (S905X4)
 
   reg:
-    maxItems: 1
+    minItems: 1
+    maxItems: 2
+
+  reg-names:
+    items:
+      - const: dwc
+      - const: top
 
   interrupts:
     maxItems: 1
@@ -77,12 +113,15 @@ properties:
 
   resets:
     minItems: 3
+    maxItems: 4
 
   reset-names:
+    minItems: 3
     items:
       - const: hdmitx_apb
       - const: hdmitx
       - const: hdmitx_phy
+      - const: vid_pll_div
 
   hdmi-supply:
     description: phandle to an external 5V regulator to power the HDMI logic
diff --git a/Documentation/devicetree/bindings/display/amlogic,meson-vpu.yaml b/Documentation/devicetree/bindings/display/amlogic,meson-vpu.yaml
index cb0a90f02321..253e0ea0a336 100644
--- a/Documentation/devicetree/bindings/display/amlogic,meson-vpu.yaml
+++ b/Documentation/devicetree/bindings/display/amlogic,meson-vpu.yaml
@@ -55,6 +55,12 @@ description: |
   The ENCI is connected to a single VDAC for Composite Output.
   The ENCI and ENCP are connected to an on-chip HDMI Transceiver.
 
+  SC2 retains the G12A scanout and blending pipeline. Its video clocks,
+  analog PLL/PHY and memory power controls reside in three separate banks
+  (CLKCTRL, ANACTRL and PWRCTRL), rather than the single HHI bank. The VPU
+  domain is controlled by secure firmware; clocks must be enabled before
+  accessing the pipeline. HDMI is the only output currently supported on SC2.
+
 properties:
   compatible:
     oneOf:
@@ -66,14 +72,24 @@ properties:
           - const: amlogic,meson-gx-vpu
       - enum:
           - amlogic,meson-g12a-vpu # G12A (S905X2, S905Y2, S905D2)
+          - amlogic,meson-sc2-vpu # SC2 (S905X4)
 
   reg:
-    maxItems: 2
+    minItems: 2
+    maxItems: 4
 
   reg-names:
+    minItems: 2
+    maxItems: 4
+
+  clocks:
+    maxItems: 3
+
+  clock-names:
     items:
       - const: vpu
-      - const: hhi
+      - const: vapb
+      - const: intr
 
   interrupts:
     maxItems: 1
@@ -111,12 +127,47 @@ required:
   - compatible
   - reg
   - interrupts
-  - port@0
   - port@1
   - "#address-cells"
   - "#size-cells"
   - amlogic,canvas
 
