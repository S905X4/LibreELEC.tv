+        port@2: false
+      required:
+        - reg-names
+        - clocks
+        - clock-names
+        - power-domains
+    else:
+      properties:
+        reg:
+          maxItems: 2
+        reg-names:
+          items:
+            - const: vpu
+            - const: hhi
