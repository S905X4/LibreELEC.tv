+			reg-names = "vpu", "clkctrl", "anactrl", "pwrctrl";
+			interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING>;
+			power-domains = <&pwrc PWRC_SC2_VPU_HDMI_ID>;
