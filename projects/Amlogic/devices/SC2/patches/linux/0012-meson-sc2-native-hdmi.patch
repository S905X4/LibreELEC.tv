 		};
 
+		canvas: video-lut@fe036048 {
+			compatible = "amlogic,canvas";
+			reg = <0 0xfe036048 0 0x14>;
+		};
+
+		vpu: vpu@ff000000 {
+			compatible = "amlogic,meson-sc2-vpu";
+			reg = <0 0xff000000 0 0x40000>,
+			      <0 0xfe000000 0 0x49c>,
