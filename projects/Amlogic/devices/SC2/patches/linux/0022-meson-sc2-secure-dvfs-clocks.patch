+					nb_data->xtal);
+		if (ret)
+			return notifier_from_errno(ret);
+		ret = clk_hw_set_parent(nb_data->cpu_clk_postmux1,
+					nb_data->cpu_clk_premux1);
+		if (ret)
+			return notifier_from_errno(ret);
+		ret = clk_hw_set_parent(nb_data->cpu_clk_dyn,
+					nb_data->cpu_clk_postmux1);
