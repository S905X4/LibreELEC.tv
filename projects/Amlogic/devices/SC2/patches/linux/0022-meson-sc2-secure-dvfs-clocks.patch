From c2f5c7ef0ed29e5a65b93cc1af31a7e1cc8e8ea3 Mon Sep 17 00:00:00 2001
From: hiper25 <whydonit@gmail.com>
Date: Tue, 20 Oct 2026 00:31:39 +0800
Subject: [PATCH] clk: meson: Make SC2 secure DVFS transitions hardware-checked

Bound secure PLL requests to the evidenced DCO tables, check firmware
programming, and preserve notifier parents across completion or abort.
Report actual secure mux and divider topology rather than a CCF cache
that can accept a rejected automatic reparent.

Park CPU dynamic changes on the existing crystal branch, below every
stock OPP, rather than running the low-voltage OPPs briefly at 1 GHz.
Keep PWM_J critical because a rejected regulator probe must not gate
the always-on CPU rail. Correct its J mux parent, preserve explicit PWM
parents and propagate thermal rate requests.

GP1 output-divider behavior and board transitions remain hardware
acceptance requirements. No new power IDs or HDMI/audio programming
paths are introduced. This commit precedes the combined series build.

Change-Id: I7ec7afa6273cc26456926c51445046c1dde23ac2
---
 .../bindings/clock/amlogic,sc2-clkc.yaml      |  10 +
 drivers/clk/meson/clk-pll.c                   |  25 +-
 drivers/clk/meson/sc2.c                       | 230 +++++++-----------
 drivers/clk/meson/sc2_clk_regmap.c            |  50 +++-
 4 files changed, 163 insertions(+), 152 deletions(-)

diff --git a/Documentation/devicetree/bindings/clock/amlogic,sc2-clkc.yaml b/Documentation/devicetree/bindings/clock/amlogic,sc2-clkc.yaml
index 40985b31a0673f553008d93fb376b3738dc1fe9c..fba280a4ed481dcde700c384c08df24e1e9de1b5 100644
--- a/Documentation/devicetree/bindings/clock/amlogic,sc2-clkc.yaml
+++ b/Documentation/devicetree/bindings/clock/amlogic,sc2-clkc.yaml
@@ -15,6 +15,16 @@ description: |
   clock services (SMC 0x8200009a and 0x8200009b). Clock indices are defined
   in dt-bindings/clock/amlogic,sc2-clkc.h.
 
+  Secure clock services must implement the SC2 CPU/DSU register read and
+  write ABI; registration alone does not establish firmware rate support.
+  Read-only output dividers retain their firmware-programmed divisor when
+  rounding rates. CPU consumers must coordinate the DSU clock and supply
+  voltage before changing the CPU clock; the provider's parking notifiers
+  protect clock reprogramming, not the board's DVFS policy.
+  Secure PLL rate requests are limited to the documented SC2 DCO tables;
+  a fixed firmware output divisor does not imply every CPU/DSU OPP can be
+  generated. Consumers must reject an unachievable output rate.
+
 properties:
   compatible:
     const: amlogic,sc2-clkc
diff --git a/drivers/clk/meson/clk-pll.c b/drivers/clk/meson/clk-pll.c
index f707d34b26b4a818a190b60d3a9055a2763df0e2..2f7650d160f87ab8daf25c00f80da8a4a35c8766 100644
--- a/drivers/clk/meson/clk-pll.c
+++ b/drivers/clk/meson/clk-pll.c
@@ -33,6 +33,7 @@
 #include <linux/delay.h>
 #include <linux/err.h>
 #include <linux/io.h>
+#include <linux/limits.h>
 #include <linux/math64.h>
 #include <linux/module.h>
 
@@ -504,6 +505,8 @@ static int meson_secure_clk_pll_set_rate(struct clk_hw *hw, unsigned long rate,
 			__func__, clk_hw_get_name(hw), rate);
 		ret = __meson_secure_clk_pll_set_rate(hw, rate, parent_rate);
 	}
+	if (!ret && meson_clk_pll_recalc_rate(hw, parent_rate) != rate)
+		return -EIO;
 
 	return ret;
 }
@@ -511,8 +514,26 @@ static int meson_secure_clk_pll_set_rate(struct clk_hw *hw, unsigned long rate,
 static long meson_secure_clk_pll_round_rate(struct clk_hw *hw, unsigned long rate,
 					    unsigned long *parent_rate)
 {
-	/* The secure firmware selects the PLL parameters for the requested rate. */
-	return rate;
+	struct clk_regmap *clk = to_clk_regmap(hw);
+	struct meson_clk_pll_data *pll = meson_clk_pll_data(clk);
+	const struct pll_params_table *entry;
+	unsigned long prate = parent_rate ? *parent_rate :
+		clk_hw_get_rate(clk_hw_get_parent(hw));
+	unsigned long best = 0, best_delta = ULONG_MAX;
+
+	/* Do not advertise arbitrary, potentially out-of-range DCO requests. */
+	for (entry = pll->table; entry && entry->n; entry++) {
+		unsigned long now = __pll_params_to_rate(prate, entry->m,
+							entry->n, 0, pll);
+		unsigned long delta = now > rate ? now - rate : rate - now;
+
+		if (delta < best_delta) {
+			best = now;
+			best_delta = delta;
+		}
+	}
+
+	return best ? best : -EINVAL;
 }
 
 static int meson_secure_clk_pll_enable(struct clk_hw *hw)
