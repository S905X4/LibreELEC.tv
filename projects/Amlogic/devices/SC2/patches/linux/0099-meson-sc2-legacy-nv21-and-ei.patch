From 60ac2670c78684066366fcbd72f514692895d2ed Mon Sep 17 00:00:00 2001
From: hiper25 <whydonit@gmail.com>
Date: Fri, 13 Nov 2026 07:22:16 +0800
Subject: [PATCH] media: meson-sc2: Negotiate native legacy NV21M and EI byte
 order

Keep NV12M as the default and add native SC2 NV21M to the supported
legacy decoder paths. Restore negotiated chroma order at every core
programming boundary, including H264 CAPTURE resume after headers.
Normalize CAPTURE when changing the compressed codec so a prior NV21M
selection cannot leak into an NV12M-only codec.

Negotiate both semiplanar layouts independently on the DI queues and
program the actual SC2 reader/writer mappings for each combination.
Do not relabel pixels, swap bytes on CPU, change other SoC format lists,
reduce buffer capacities or weaken completion/drain ownership.

Compilation and hardware pixel/color acceptance are performed on the
matched integrated series; existing codec compatibility failures remain
separate from this output-format implementation.

Change-Id: I77f5ce219ec4137392a8e474084ca3ec2795ddc3
---
 .../platform/amlogic/meson-sc2-di/Kconfig     |  5 ++--
 .../platform/amlogic/meson-sc2-di/sc2-di.c    | 21 ++++++++++------
 drivers/staging/media/meson/vdec/codec_h264.c |  5 ++--
 .../staging/media/meson/vdec/codec_legacy.c   | 14 ++++-------
 .../staging/media/meson/vdec/codec_mpeg12.c   |  9 ++++---
 .../staging/media/meson/vdec/codec_mpeg4.c    |  9 ++++---
 drivers/staging/media/meson/vdec/vdec.c       |  8 +++---
 drivers/staging/media/meson/vdec/vdec_1.c     | 12 ++-------
 .../staging/media/meson/vdec/vdec_helpers.c   | 25 +++++++++++++++++--
 .../staging/media/meson/vdec/vdec_helpers.h   |  3 +++
 .../staging/media/meson/vdec/vdec_platform.c  | 14 +++++------
 11 files changed, 75 insertions(+), 50 deletions(-)

diff --git a/drivers/media/platform/amlogic/meson-sc2-di/Kconfig b/drivers/media/platform/amlogic/meson-sc2-di/Kconfig
index 6659d7dd0681..bf130ce814f5 100644
--- a/drivers/media/platform/amlogic/meson-sc2-di/Kconfig
+++ b/drivers/media/platform/amlogic/meson-sc2-di/Kconfig
@@ -7,5 +7,6 @@ config VIDEO_MESON_SC2_DI
 	select VIDEOBUF2_DMA_CONTIG
 	help
 	  Native V4L2 M2M SC2 post-engine edge interpolation. Imports linear
-	  NV12M DMABUFs and exports progressive MMAP/DMABUF surfaces at field
-	  rate. This is spatial EI, not the vendor temporal MA/MC algorithm.
+	  NV12M/NV21M DMABUFs and exports progressive NV12M/NV21M MMAP/DMABUF
+	  surfaces at field rate. Chroma order conversion uses hardware MIFs.
+	  This is spatial EI, not the vendor temporal MA/MC algorithm.
diff --git a/drivers/media/platform/amlogic/meson-sc2-di/sc2-di.c b/drivers/media/platform/amlogic/meson-sc2-di/sc2-di.c
index 3bf09f8a5e86..cf43b5603bf6 100644
--- a/drivers/media/platform/amlogic/meson-sc2-di/sc2-di.c
+++ b/drivers/media/platform/amlogic/meson-sc2-di/sc2-di.c
@@ -185,7 +185,9 @@ static int di_program(struct sc2_di_ctx *ctx,
 
 	di_write(di, DI_POST_GL_CTRL, 0x40200001);
 	di_write(di, IF0_BASE + IF_GEN3, (3 << 4) | (2 << 1));
-	di_write(di, IF0_BASE + IF_GEN2, 1); /* NV12, not NV21 */
+	/* SC2 set_di_mif_v3: chroma map 1=VU, 2=UV. */
+	di_write(di, IF0_BASE + IF_GEN2,
+		 ctx->fmt[0].pixelformat == V4L2_PIX_FMT_NV21M ? 1 : 2);
 	di_write(di, IF0_BASE + IF_CANVAS, di->canvas_id[0] |
 		 (di->canvas_id[1] << 8) | (di->canvas_id[1] << 16));
 	di_write(di, IF0_BASE + IF_X, (r->width - 1) << 16);
@@ -206,8 +208,12 @@ static int di_program(struct sc2_di_ctx *ctx,
 	di_write(di, DIWR_X, r->width - 1);
 	di_write(di, DIWR_Y, r->height - 1);
 	di_write(di, DIWR_CANVAS, di->canvas_id[2] | (di->canvas_id[3] << 8));
-	/* NV12 writeback: two planes, 8 bit, 420 chroma decimation. */
-	di_write(di, DIWR_CTRL, BIT(0) | BIT(3) | (3 << 4) | (2 << 22) | (2 << 26));
+	/* SC2 set_wrmif_simple_v3: bit17=0 writes VU, bit17=1 writes UV.
+	 * Input and output order are independent hardware MIF selections.
+	 */
+	di_write(di, DIWR_CTRL, BIT(0) | BIT(3) | (3 << 4) | (2 << 22) |
+		 (2 << 26) |
+		 (ctx->fmt[1].pixelformat == V4L2_PIX_FMT_NV12M ? BIT(17) : 0));
 	di_write(di, DI_POST_GL_THD, 8 << 16);
 	di_write(di, DI_POST_SIZE, ((r->height - 1) << 16) | (r->width - 1));
 	/* post + EI + mux + DDR; blend and MC deliberately disabled. */
@@ -509,9 +515,9 @@ static int di_querycap(struct file *file, void *fh, struct v4l2_capability *cap)
 
 static int di_enum_fmt(struct file *file, void *fh, struct v4l2_fmtdesc *f)
 {
-	if (f->index)
+	if (f->index > 1)
 		return -EINVAL;
-	f->pixelformat = V4L2_PIX_FMT_NV12M;
+	f->pixelformat = f->index ? V4L2_PIX_FMT_NV21M : V4L2_PIX_FMT_NV12M;
 	return 0;
 }
 
@@ -521,7 +527,8 @@ static int di_try_fmt(struct file *file, void *fh, struct v4l2_format *f)
 	unsigned int i;
 	u32 alignment = V4L2_TYPE_IS_OUTPUT(f->type) ? 32 : 64;
 
-	p->pixelformat = V4L2_PIX_FMT_NV12M;
+	if (p->pixelformat != V4L2_PIX_FMT_NV21M)
+		p->pixelformat = V4L2_PIX_FMT_NV12M;
 	p->width = clamp_t(u32, ALIGN(p->width, 2), 32, 1920);
 	p->height = clamp_t(u32, ALIGN(p->height, 4), 32, 1088);
 	p->num_planes = 2;
@@ -896,7 +903,7 @@ static int di_probe(struct platform_device *pdev)
 		pm_runtime_disable(dev);
 		goto unreg_v4l2;
 	}
-	dev_info(dev, "native SC2 hardware EI, NV12M, two progressive outputs per frame\n");
+	dev_info(dev, "native SC2 hardware EI, NV12M/NV21M, two progressive outputs per frame\n");
 	return 0;
 unreg_v4l2:
 	v4l2_device_unregister(&di->v4l2);
diff --git a/drivers/staging/media/meson/vdec/codec_h264.c b/drivers/staging/media/meson/vdec/codec_h264.c
index 6b48425dbb95..26b80322f1b3 100644
--- a/drivers/staging/media/meson/vdec/codec_h264.c
+++ b/drivers/staging/media/meson/vdec/codec_h264.c
@@ -4505,8 +4505,8 @@ static int h264_multi_run(struct amvdec_session *sess)
     amvdec_write_dos(core, AV_SCRATCH_9, BIT(2) |
         ((m->sequence_level & 0xff) << 7) |
         (m->dpb.bitstream_restriction_flag << 15));
-    amvdec_write_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(17));
-    amvdec_clear_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(16) | BIT(31));
+    amvdec_set_output_format(sess);
+    amvdec_clear_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(31));
     amvdec_write_dos(core, MDEC_PIC_DC_THRESH, 0x404038aa);
     /* The VLD/IQIDCT reset loses controls established by the parsed PPS. */
     if (m->iqidct_valid)
@@ -4977,6 +4977,7 @@ static void h264_multi_resume(struct amvdec_session *sess)
     dpb->colocated_buf_size = stride_mbs * height_mbs * 96;
     dpb->colocated_mv_addr_start = h264->ref_paddr;
     dpb->colocated_mv_addr_end = h264->ref_paddr + bytes;
+    amvdec_set_output_format(sess);
     m->waiting_capture = false;
     amvdec_write_dos(core, AV_SCRATCH_J, H264_ACTION_CONFIG_DONE);
     /* CONFIG_PARAM waits for allocation in scratch 0; scratch 7 is run restore. */
diff --git a/drivers/staging/media/meson/vdec/codec_legacy.c b/drivers/staging/media/meson/vdec/codec_legacy.c
