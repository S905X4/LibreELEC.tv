From 5ba418afc34643f279dc17870f0e927f7c807f16 Mon Sep 17 00:00:00 2001
From: hiper25 <whydonit@gmail.com>
Date: Tue, 20 Oct 2026 00:41:02 +0800
Subject: [PATCH] pwm: meson: Round inverted physical-high duration directly

The initial leading-edge fix preserved its own decoded counters but
rounded an inverted 45 ns physical-high request upward to 83 ns.
That violates downward waveform rounding when a 42 ns pulse exists.

Keep downward encoding of physical-high duration for both polarities.
On readback, ceil the physical-high counter duration directly: for
an inverted waveform this is lo, not period minus the ceiled hi edge.
A 35/1 cycle waveform at24MHz now reports period1500/duty42/offset1458
and re-encodes35/1 without losing a pulse or rounding the45ns request up.

The first two failing actual-body runs are retained. This correction
precedes the full waveform and regulator-handoff regression rerun.

Change-Id: I056ccff209eb03864d230eafc7356fa6bf6b079c
---
 drivers/pwm/pwm-meson.c | 21 +++++++++------------
 1 file changed, 9 insertions(+), 12 deletions(-)

diff --git a/drivers/pwm/pwm-meson.c b/drivers/pwm/pwm-meson.c
index a170fa479fc8bbeba436a05f1caceecb31d120ae..a225c64e603841c03238237eb87c6597146a7955 100644
--- a/drivers/pwm/pwm-meson.c
+++ b/drivers/pwm/pwm-meson.c
@@ -439,13 +439,12 @@ static int meson_sc2_pwm_round_fromhw(struct pwm_chip *chip,
 			wf->duty_length_ns = wf->period_length_ns;
 		return 0;
 	}
-	high_ns = DIV_ROUND_UP_ULL(NSEC_PER_SEC * (u64)hi, hw->rate);
-	if (hw->inverted) {
-		wf->duty_length_ns = wf->period_length_ns - high_ns;
-		wf->duty_offset_ns = high_ns;
-	} else {
-		wf->duty_length_ns = high_ns;
-	}
+	/* Round physical high time directly, including inverted pulses. */
+	high_ns = DIV_ROUND_UP_ULL(NSEC_PER_SEC *
+				   (u64)(hw->inverted ? lo : hi), hw->rate);
+	wf->duty_length_ns = high_ns;
+	if (hw->inverted)
+		wf->duty_offset_ns = wf->period_length_ns - high_ns;
 	return 0;
 }
 
@@ -480,15 +479,13 @@ static int meson_sc2_pwm_round_tohw(struct pwm_chip *chip,
 	/* The hardware can place the high pulse at the start or end only. */
 	hw->inverted = wf->duty_offset_ns &&
 		wf->duty_offset_ns == wf->period_length_ns - wf->duty_length_ns;
-	/* Quantize the leading edge, not a difference of rounded widths. */
-	if (hw->inverted)
-		high = min(mul_u64_u64_div_u64(rate, wf->duty_offset_ns,
-					     NSEC_PER_SEC), count);
-	else if (wf->duty_length_ns == wf->period_length_ns)
+	if (wf->duty_length_ns == wf->period_length_ns)
 		high = count;
 	else
 		high = min(mul_u64_u64_div_u64(rate, wf->duty_length_ns,
 					     NSEC_PER_SEC), count);
+	if (hw->inverted)
+		high = count - high;
 	hw->constant = !high || high == count;
 	if (hw->constant ? count > 0xffff :
 	    high > 0x10000 || count - high > 0x10000)
