-	meson_crtc_disable_osd1(meson_crtc);
+	if (priv->sc2) {
+		for (i = 0; i < MESON_MAX_OSDS; i++) {
+			priv->viu.osd[i].enabled = false;
+			priv->viu.osd[i].commit = true;
+		}
+		meson_crtc_sc2_update_osds(priv);
+	} else {
