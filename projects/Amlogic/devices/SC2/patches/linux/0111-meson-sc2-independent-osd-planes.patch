 drivers/gpu/drm/meson/meson_drv.c       |  19 +-
 drivers/gpu/drm/meson/meson_drv.h       |  74 +++--
 drivers/gpu/drm/meson/meson_osd_afbcd.c | 141 +++++----
 drivers/gpu/drm/meson/meson_osd_afbcd.h |   3 +
 drivers/gpu/drm/meson/meson_plane.c     | 368 +++++++++++++++---------
 drivers/gpu/drm/meson/meson_registers.h |   8 +
 drivers/gpu/drm/meson/meson_viu.c       | 154 ++++++++--
 drivers/gpu/drm/meson/meson_viu.h       |  18 ++
 9 files changed, 738 insertions(+), 307 deletions(-)

diff --git a/drivers/gpu/drm/meson/meson_crtc.c b/drivers/gpu/drm/meson/meson_crtc.c
index 14747e85e25a..cd6753fe7702 100644
--- a/drivers/gpu/drm/meson/meson_crtc.c
+++ b/drivers/gpu/drm/meson/meson_crtc.c
