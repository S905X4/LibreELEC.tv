From 4cd5ee56f5fc2172a33d107cac2bb2bc154021ad Mon Sep 17 00:00:00 2001
From: hiper25 <whydonit@gmail.com>
Date: Wed, 21 Oct 2026 20:09:45 +0800
Subject: [PATCH] clk: meson: axg-audio: Own the SC2 audio power domain

SC2 places the audio bus in a firmware-controlled power domain. The clock provider currently exposes clocks and resets without a runtime-PM reference, allowing the parent bus and audio domain to suspend even during ordinary PCM playback.

Enable runtime PM for SC2 and hold a managed reference before touching the clocks or resets. Release it after clock/reset cleanup on probe failure or removal. Other SoC matches retain their existing behavior.

On HK1 RBOX X4, the same native S16 stereo PCM is silent with the audio domain off, reaches the HDMI receiver with the bus held active, and becomes silent again after restoring automatic runtime PM. No CE register settings or sample replacement are needed for this transition.

Change-Id: I85ac504b5bdd27e319a63cd074efc4a54fb33f0b
---
 drivers/clk/meson/axg-audio.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/drivers/clk/meson/axg-audio.c b/drivers/clk/meson/axg-audio.c
index fdf71f97641d3a98742f562a9d03e24ecf4b2869..33837cad103a952583f783ce2dbabde722402843 100644
--- a/drivers/clk/meson/axg-audio.c
+++ b/drivers/clk/meson/axg-audio.c
@@ -11,6 +11,7 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
 #include <linux/regmap.h>
 #include <linux/reset.h>
 #include <linux/slab.h>
@@ -1322,6 +1323,7 @@ struct audioclk_data {
 	const char *rst_drvname;
 	unsigned int max_register;
 	bool bypass_sysclk;
+	bool runtime_pm;
 };
 
 static struct clk_hw *sc2_audio_clk_get(struct of_phandle_args *clkspec,
@@ -1337,6 +1339,11 @@ static struct clk_hw *sc2_audio_clk_get(struct of_phandle_args *clkspec,
 	return meson_clk_hw_get(clkspec, data);
 }
 
+static void axg_audio_runtime_put(void *data)
+{
+	pm_runtime_put_sync(data);
+}
+
 static int axg_audio_clkc_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -1363,6 +1370,21 @@ static int axg_audio_clkc_probe(struct platform_device *pdev)
 		return PTR_ERR(map);
 	}
 
+	if (data->runtime_pm) {
+		ret = devm_pm_runtime_enable(dev);
+		if (ret)
+			return ret;
+
+		/* Keep the domain on while its clocks and resets are exposed. */
+		ret = pm_runtime_resume_and_get(dev);
+		if (ret)
+			return dev_err_probe(dev, ret, "failed to power audio domain\n");
+
+		ret = devm_add_action_or_reset(dev, axg_audio_runtime_put, dev);
+		if (ret)
+			return ret;
+	}
+
 	/* Get the mandatory peripheral clock */
 	clk = devm_clk_get_enabled(dev, "pclk");
 	if (IS_ERR(clk))
@@ -1452,6 +1474,7 @@ static const struct audioclk_data sc2_audioclk_data = {
 	.rst_drvname = "rst-sm1",
 	.max_register = AUDIO_EARCRX_DMAC_CLK_CTRL,
 	.bypass_sysclk = true,
+	.runtime_pm = true,
 };
 
 static const struct of_device_id clkc_match_table[] = {
