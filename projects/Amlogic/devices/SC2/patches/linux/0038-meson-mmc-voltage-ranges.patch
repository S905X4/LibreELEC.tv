From 0049fc975bbd36d1f1dc8dbeec433b9d702b2b7d Mon Sep 17 00:00:00 2001
From: hiper25 <whydonit@gmail.com>
Date: Tue, 20 Oct 2026 15:34:32 +0800
Subject: [PATCH] mmc: meson-gx: Parse explicit card voltage ranges

The upstream host leaves ocr_avail empty when a board has no software
controllable VMMC regulator. Parse the existing firmware voltage-ranges
property only when no regulator-derived voltage mask was obtained.

This keeps existing regulator-backed boards unchanged and avoids guessing
a global fallback voltage or inventing a board supply topology.

---
 drivers/mmc/host/meson-gx-mmc.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/mmc/host/meson-gx-mmc.c b/drivers/mmc/host/meson-gx-mmc.c
index 694bb443d5f3..a16afe826c28 100644
--- a/drivers/mmc/host/meson-gx-mmc.c
+++ b/drivers/mmc/host/meson-gx-mmc.c
@@ -1160,6 +1160,13 @@ static int meson_mmc_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	if (!mmc->ocr_avail) {
+		ret = mmc_of_parse_voltage(mmc, &mmc->ocr_avail);
+		if (ret < 0)
+			return dev_err_probe(&pdev->dev, ret,
+					     "invalid voltage-ranges\n");
+	}
+
 	ret = mmc_of_parse(mmc);
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret, "error parsing DT\n");
-- 
