From 8b2e33a786225751e2cb92be11982dc7a321b977 Mon Sep 17 00:00:00 2001
From: hiper25 <whydonit@gmail.com>
Date: Thu, 22 Oct 2026 02:51:35 +0800
Subject: [PATCH] tee: optee: identify SC2 function-15 firmware ABI

Avoid the optional GET_THREAD_COUNT SMC only for the explicit SC2 firmware
compatible, whose function 15 instead loads a video firmware index. Keep
the normal API checks and existing unknown-thread-count fallback.

---
 .../bindings/arm/firmware/linaro,optee-tz.yaml      | 13 ++++++++++++-
 arch/arm64/boot/dts/amlogic/meson-sc2.dtsi          |  5 +++++
 drivers/tee/optee/smc_abi.c                         |  7 ++++++-
 3 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/arm/firmware/linaro,optee-tz.yaml b/Documentation/devicetree/bindings/arm/firmware/linaro,optee-tz.yaml
index 5d033570b57bcf1b6a2b3b933c041922132d61a3..e3a97ac70e6675b3c965c7408e01223f9b92f917 100644
--- a/Documentation/devicetree/bindings/arm/firmware/linaro,optee-tz.yaml
+++ b/Documentation/devicetree/bindings/arm/firmware/linaro,optee-tz.yaml
@@ -19,2 +19,9 @@ description: |
 
+  Amlogic SC2 vendor firmware uses SMC function 15 (0xb200000f) to load
+  video firmware, with firmware index, decoder selector and swap flag in
+  a1-a3. This collides with the optional OP-TEE GET_THREAD_COUNT query.
+  The amlogic,meson-sc2-optee-tz compatible identifies this firmware ABI:
+  clients must not issue GET_THREAD_COUNT and must use the existing
+  unknown-thread-count operation instead.
+
 properties:
@@ -24,3 +31,7 @@ properties:
   compatible:
-    const: linaro,optee-tz
+    oneOf:
+      - const: linaro,optee-tz
+      - items:
+          - const: amlogic,meson-sc2-optee-tz
+          - const: linaro,optee-tz
 
diff --git a/arch/arm64/boot/dts/amlogic/meson-sc2.dtsi b/arch/arm64/boot/dts/amlogic/meson-sc2.dtsi
index a6777d5805d4f679b770873f751468a7976a7f41..b7ea3ba6dded94045dd20f5a73288d92b9a07f21 100644
--- a/arch/arm64/boot/dts/amlogic/meson-sc2.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-sc2.dtsi
@@ -111,2 +111,7 @@ linux,cma {
 	firmware {
+		optee {
+			compatible = "amlogic,meson-sc2-optee-tz", "linaro,optee-tz";
+			method = "smc";
+		};
+
 		sm: secure-monitor {
diff --git a/drivers/tee/optee/smc_abi.c b/drivers/tee/optee/smc_abi.c
index bf51019e063b7b6d894b70f2af2906ca13085348..b16356059e63950a934f1ea266e3940fab43eb11 100644
--- a/drivers/tee/optee/smc_abi.c
+++ b/drivers/tee/optee/smc_abi.c
@@ -1754,3 +1754,8 @@ static int optee_probe(struct platform_device *pdev)
 
-	thread_count = optee_msg_get_thread_count(invoke_fn);
+	/* SC2 vendor firmware uses function 15 to load video firmware. */
+	if (of_device_is_compatible(pdev->dev.of_node,
+				    "amlogic,meson-sc2-optee-tz"))
+		thread_count = 0;
+	else
+		thread_count = optee_msg_get_thread_count(invoke_fn);
 	if (!optee_msg_exchange_capabilities(invoke_fn, &sec_caps,
