From 9a6ba3448ce3a58c1dbc2525c51b2ded57e3516d Mon Sep 17 00:00:00 2001
From: hiper25 <whydonit@gmail.com>
Date: Tue, 20 Oct 2026 00:14:31 +0800
Subject: [PATCH] media: cec: meson: Support SC2 external-clock CEC_B

SC2 relocates CEC_B registers and supplies its 32.768 kHz clock from
the main controller rather than the older internal divider. Reuse
the native indirect-register and CEC notifier paths with explicit
variant data and the SC2 binding.

Do not register the unrelated DW-HDMI CEC block or add boot-time
logical-address, active-source, standby or television policy.

---
 .../media/cec/amlogic,meson-gx-ao-cec.yaml    | 17 ++++++++
 drivers/media/cec/platform/Kconfig            |  6 +--
 .../media/cec/platform/meson/ao-cec-g12a.c    | 43 ++++++++++++++-----
 3 files changed, 53 insertions(+), 13 deletions(-)

diff --git a/Documentation/devicetree/bindings/media/cec/amlogic,meson-gx-ao-cec.yaml b/Documentation/devicetree/bindings/media/cec/amlogic,meson-gx-ao-cec.yaml
index b1fab53418f9654c462d45f440f27a7d794ba582..c98a05e922c9a1d6b5fdd8a805775a6f8cd5a74e 100644
--- a/Documentation/devicetree/bindings/media/cec/amlogic,meson-gx-ao-cec.yaml
+++ b/Documentation/devicetree/bindings/media/cec/amlogic,meson-gx-ao-cec.yaml
@@ -20,6 +20,7 @@ properties:
       - amlogic,meson-gx-ao-cec # GXBB, GXL, GXM, G12A and SM1 AO_CEC_A module
       - amlogic,meson-g12a-ao-cec # G12A AO_CEC_B module
       - amlogic,meson-sm1-ao-cec # SM1 AO_CEC_B module
+      - amlogic,meson-sc2-ao-cec # SC2 CEC_B, external clock divider
 
   reg:
     maxItems: 1
@@ -34,6 +35,22 @@ properties:
     maxItems: 1
 
 allOf:
+  - if:
+      properties:
+        compatible:
+          const: amlogic,meson-sc2-ao-cec
+    then:
+      properties:
+        reg:
+          description: |
+            CEC peripheral register window, including CEC_A at offset 0
+            and CEC_B at offset 0x40. Only CEC_B is used by this binding.
+        clocks:
+          items:
+            - description: CEC_B 32.768 kHz core clock
+        clock-names:
+          items:
+            - const: core
   - $ref: cec-common.yaml#
   - if:
       properties:
diff --git a/drivers/media/cec/platform/Kconfig b/drivers/media/cec/platform/Kconfig
index e40413609f537fd79ef9dfed58be78d8b13d13d7..dee0f7308e174aded5737defd089fbd3b624fa07 100644
--- a/drivers/media/cec/platform/Kconfig
+++ b/drivers/media/cec/platform/Kconfig
@@ -33,9 +33,9 @@ config CEC_MESON_G12A_AO
 	select CEC_CORE
 	select CEC_NOTIFIER
 	help
-	  This is a driver for Amlogic Meson G12A SoCs AO CEC interface.
-	  This driver if for the new AO-CEC module found in G12A SoCs,
-	  usually named AO_CEC_B in documentation.
+	  This is a driver for Amlogic Meson G12A, SM1 and SC2 CEC interfaces.
+	  It supports the AO_CEC_B module, including the external clock divider
+	  used by SC2.
 	  It uses the generic CEC framework interface.
 	  CEC bus is present in the HDMI connector and enables communication
 	  between compatible devices.
diff --git a/drivers/media/cec/platform/meson/ao-cec-g12a.c b/drivers/media/cec/platform/meson/ao-cec-g12a.c
index 2c914f0008b508ecb75fa636f8c5f16fec15f02c..93ef5e0d59d6c4064292c7516d2af18fb601dba0 100644
--- a/drivers/media/cec/platform/meson/ao-cec-g12a.c
+++ b/drivers/media/cec/platform/meson/ao-cec-g12a.c
@@ -171,6 +171,9 @@
 struct meson_ao_cec_g12a_data {
 	/* Setup the internal CECB_CTRL2 register */
 	bool				ctrl2_setup;
+	/* SC2 moved the divider to the clock controller. */
+	bool				external_clock;
+	u32				reg_offset;
 };
 
 struct meson_ao_cec_g12a_device {
@@ -670,7 +673,8 @@ static int meson_ao_cec_g12a_probe(struct platform_device *pdev)
 		goto out_probe_adapter;
 	}
 
-	ao_cec->regmap = devm_regmap_init_mmio(&pdev->dev, base,
+	ao_cec->regmap = devm_regmap_init_mmio(&pdev->dev,
+					       base + ao_cec->data->reg_offset,
 					       &meson_ao_cec_g12a_regmap_conf);
 	if (IS_ERR(ao_cec->regmap)) {
 		ret = PTR_ERR(ao_cec->regmap);
@@ -694,17 +698,25 @@ static int meson_ao_cec_g12a_probe(struct platform_device *pdev)
 		goto out_probe_adapter;
 	}
 
-	ao_cec->oscin = devm_clk_get(&pdev->dev, "oscin");
-	if (IS_ERR(ao_cec->oscin)) {
-		dev_err(&pdev->dev, "oscin clock request failed\n");
-		ret = PTR_ERR(ao_cec->oscin);
-		goto out_probe_adapter;
+	if (ao_cec->data->external_clock) {
+		ao_cec->core = devm_clk_get(&pdev->dev, "core");
+		if (IS_ERR(ao_cec->core)) {
+			ret = PTR_ERR(ao_cec->core);
+			goto out_probe_adapter;
+		}
+	} else {
+		ao_cec->oscin = devm_clk_get(&pdev->dev, "oscin");
+		if (IS_ERR(ao_cec->oscin)) {
+			dev_err(&pdev->dev, "oscin clock request failed\n");
+			ret = PTR_ERR(ao_cec->oscin);
+			goto out_probe_adapter;
+		}
+
+		ret = meson_ao_cec_g12a_setup_clk(ao_cec);
+		if (ret)
+			goto out_probe_adapter;
 	}
 
-	ret = meson_ao_cec_g12a_setup_clk(ao_cec);
-	if (ret)
-		goto out_probe_adapter;
-
 	ret = clk_prepare_enable(ao_cec->core);
 	if (ret) {
 		dev_err(&pdev->dev, "core clock enable failed\n");
@@ -764,6 +776,13 @@ static const struct meson_ao_cec_g12a_data ao_cec_sm1_data = {
 	.ctrl2_setup = true,
 };
 
+static const struct meson_ao_cec_g12a_data ao_cec_sc2_data = {
+	.ctrl2_setup = true,
+	.external_clock = true,
+	/* CECB_GEN_CNTL is at 0x40 instead of 0x08. */
+	.reg_offset = 0x38,
+};
+
 static const struct of_device_id meson_ao_cec_g12a_of_match[] = {
 	{
 		.compatible = "amlogic,meson-g12a-ao-cec",
@@ -773,6 +792,10 @@ static const struct of_device_id meson_ao_cec_g12a_of_match[] = {
 		.compatible = "amlogic,meson-sm1-ao-cec",
 		.data = &ao_cec_sm1_data,
 	},
+	{
+		.compatible = "amlogic,meson-sc2-ao-cec",
+		.data = &ao_cec_sc2_data,
+	},
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, meson_ao_cec_g12a_of_match);
