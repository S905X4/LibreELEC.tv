From 62549ffe7dc4a83578fc6390d899c1d111872190 Mon Sep 17 00:00:00 2001
From: hiper25 <whydonit@gmail.com>
Date: Mon, 19 Oct 2026 20:16:56 +0800
Subject: [PATCH] phy: amlogic: implement SC2 USB2 and USB3 PHY programming

Cross-checked against the original sc2_ah212_4g DT and CE linux-amlogic
a3aaaa5b0e646dcd8cf4a23d6b8d66a5292840eb plus Khadas linux
ef8cd851f48356675c3e987fead999fe28f6f69d USB2-v2/USB3-v2 drivers.
SC2 needs version-2 factory calibration, analog settings and a separate
combo-PHY bandgap clock. Reuse G12A host glue and correct its SSC mask.
No board supply is fabricated and no hardware USB result is claimed.

Retain the existing upstream PHY driver attribution and licenses;
the vendor reference trees are evidence, not target dependencies.

Migrate the existing LibreELEC SC2 patch unchanged into the target
kernel history. This commit records source integration only; no fresh
build or hardware validation was performed for this migration.

Change-Id: I1de5c668baab2e81082ee5818f2968d40cad284e
---
 .../bindings/phy/amlogic,g12a-usb2-phy.yaml   |  6 +++
 .../phy/amlogic,g12a-usb3-pcie-phy.yaml       | 24 ++++++++++-
 drivers/phy/amlogic/Kconfig                   |  8 ++--
 drivers/phy/amlogic/phy-meson-g12a-usb2.c     | 32 ++++++++++++++-
 .../phy/amlogic/phy-meson-g12a-usb3-pcie.c    | 40 +++++++++++++++++--
 drivers/usb/dwc3/dwc3-meson-g12a.c            |  1 +
 6 files changed, 100 insertions(+), 11 deletions(-)

diff --git a/Documentation/devicetree/bindings/phy/amlogic,g12a-usb2-phy.yaml b/Documentation/devicetree/bindings/phy/amlogic,g12a-usb2-phy.yaml
index 1a0c436b87a099c1343fd7dd8e5e491fa4c08247..fbcb9deb4567cbaf6fbdb0097a1dd1e360656cc7 100644
--- a/Documentation/devicetree/bindings/phy/amlogic,g12a-usb2-phy.yaml
+++ b/Documentation/devicetree/bindings/phy/amlogic,g12a-usb2-phy.yaml
@@ -10,11 +10,17 @@ title: Amlogic G12A USB2 PHY
 maintainers:
   - Neil Armstrong <neil.armstrong@linaro.org>
 
+description: |
+  G12A-compatible USB2 PHYs use an external 24 MHz crystal and one reset
+  per port. SC2 uses version-2 analog tuning and factory calibration from
+  the PHY register bank, so its compatible must not fall back to G12A.
+
 properties:
   compatible:
     enum:
       - amlogic,g12a-usb2-phy
       - amlogic,a1-usb2-phy
+      - amlogic,sc2-usb2-phy
 
   reg:
     maxItems: 1
diff --git a/Documentation/devicetree/bindings/phy/amlogic,g12a-usb3-pcie-phy.yaml b/Documentation/devicetree/bindings/phy/amlogic,g12a-usb3-pcie-phy.yaml
index 1a5a12adb72b37cc0b71409b039df7772f9124d3..c7f5010f2973894207c40bfcb8aa42fd30f0827a 100644
--- a/Documentation/devicetree/bindings/phy/amlogic,g12a-usb3-pcie-phy.yaml
+++ b/Documentation/devicetree/bindings/phy/amlogic,g12a-usb3-pcie-phy.yaml
@@ -14,16 +14,20 @@ properties:
   compatible:
     enum:
       - amlogic,g12a-usb3-pcie-phy
+      - amlogic,sc2-usb3-pcie-phy
 
   reg:
     maxItems: 1
 
   clocks:
-    maxItems: 1
+    minItems: 1
+    maxItems: 2
 
   clock-names:
+    minItems: 1
     items:
       - const: ref_clk
+      - const: bgp
 
   resets:
     maxItems: 1
@@ -49,6 +53,24 @@ required:
   - reset-names
   - "#phy-cells"
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: amlogic,sc2-usb3-pcie-phy
+    then:
+      properties:
+        clocks:
+          minItems: 2
+        clock-names:
+          minItems: 2
+    else:
+      properties:
+        clocks:
+          maxItems: 1
+        clock-names:
+          maxItems: 1
+
 additionalProperties: false
 
 examples:
diff --git a/drivers/phy/amlogic/Kconfig b/drivers/phy/amlogic/Kconfig
index ce7ba3eb2a8e5da9467f591b3a24bcc6ac269b7d..3b963a49ecf86cae38a330d1c1ec20b74660ecd5 100644
--- a/drivers/phy/amlogic/Kconfig
+++ b/drivers/phy/amlogic/Kconfig
@@ -50,25 +50,25 @@ config PHY_MESON_G12A_MIPI_DPHY_ANALOG
 	  If unsure, say N.
 
 config PHY_MESON_G12A_USB2
-	tristate "Meson G12A USB2 PHY driver"
+	tristate "Meson G12A, A1 and SC2 USB2 PHY driver"
 	default ARCH_MESON
 	depends on OF && (ARCH_MESON || COMPILE_TEST)
 	select GENERIC_PHY
 	select REGMAP_MMIO
 	help
 	  Enable this to support the Meson USB2 PHYs found in Meson
-	  G12A SoCs.
+	  G12A, A1 and SC2 SoCs.
 	  If unsure, say N.
 
 config PHY_MESON_G12A_USB3_PCIE
-	tristate "Meson G12A USB3+PCIE Combo PHY driver"
+	tristate "Meson G12A and SC2 USB3+PCIE Combo PHY driver"
 	default ARCH_MESON
 	depends on OF && (ARCH_MESON || COMPILE_TEST)
 	select GENERIC_PHY
 	select REGMAP_MMIO
 	help
 	  Enable this to support the Meson USB3 + PCIE Combo PHY found
-	  in Meson G12A SoCs.
+	  in Meson G12A and SC2 SoCs.
 	  If unsure, say N.
 
 config PHY_MESON_AXG_PCIE
diff --git a/drivers/phy/amlogic/phy-meson-g12a-usb2.c b/drivers/phy/amlogic/phy-meson-g12a-usb2.c
index 66bf0b7ef8ed384c33e354171fd32772162aa313..1487d32d54cd97563c02d38f3029705c7e8ed782 100644
--- a/drivers/phy/amlogic/phy-meson-g12a-usb2.c
+++ b/drivers/phy/amlogic/phy-meson-g12a-usb2.c
@@ -149,6 +149,7 @@
 enum meson_soc_id {
 	MESON_SOC_G12A  = 0,
 	MESON_SOC_A1,
+	MESON_SOC_SC2,
 };
 
 struct phy_meson_g12a_usb2_priv {
@@ -217,7 +218,7 @@ static int phy_meson_g12a_usb2_init(struct phy *phy)
 		FIELD_PREP(PHY_CTRL_R18_MPLL_ADJ_LDO, 1) |
 		PHY_CTRL_R18_MPLL_ACG_RANGE;
 
-	if (priv->soc_id == MESON_SOC_A1)
+	if (priv->soc_id == MESON_SOC_A1 || priv->soc_id == MESON_SOC_SC2)
 		value |= PHY_CTRL_R18_MPLL_DCO_CLK_SEL;
 
 	regmap_write(priv->regmap, PHY_CTRL_R18, value);
@@ -252,7 +253,30 @@ static int phy_meson_g12a_usb2_init(struct phy *phy)
 			     PHY_CTRL_R4_TEST_BYPASS_MODE_EN |
 			     FIELD_PREP(PHY_CTRL_R4_I_C2L_BIAS_TRIM_1_0, 0) |
 			     FIELD_PREP(PHY_CTRL_R4_I_C2L_BIAS_TRIM_3_2, 0));
-	else if (priv->soc_id == MESON_SOC_A1) {
+	else if (priv->soc_id == MESON_SOC_SC2) {
+		regmap_write(priv->regmap, PHY_CTRL_R21,
+			     PHY_CTRL_R21_USB2_CAL_ACK_EN |
+			     PHY_CTRL_R21_USB2_TX_STRG_PD |
+			     FIELD_PREP(PHY_CTRL_R21_USB2_OTG_ACA_TRIM_1_0, 2));
+
+		/* SC2 stores the factory calibration in R2, not in R4. */
+		regmap_read(priv->regmap, PHY_CTRL_R2, &value);
+		value &= GENMASK(11, 0);
+		if (!value)
+			value = PHY_CTRL_R4_TEST_BYPASS_MODE_EN | 0x1f;
+		regmap_update_bits(priv->regmap, PHY_CTRL_R4, value, value);
+
+		/* The version-2 PHY uses a different disconnect threshold. */
+		regmap_write(priv->regmap, PHY_CTRL_R3, 0x3f);
+		regmap_update_bits(priv->regmap, PHY_CTRL_R14,
+				   GENMASK(28, 27), 0);
+		/* Latch the threshold and calibration changes. */
+		regmap_write(priv->regmap, PHY_CTRL_R13,
+			     PHY_CTRL_R13_UPDATE_PMA_SIGNALS |
+			     FIELD_PREP(PHY_CTRL_R13_MIN_COUNT_FOR_SYNC_DET, 7));
+
+		return 0;
+	} else if (priv->soc_id == MESON_SOC_A1) {
 		regmap_write(priv->regmap, PHY_CTRL_R21,
 			     PHY_CTRL_R21_USB2_CAL_ACK_EN |
 			     PHY_CTRL_R21_USB2_TX_STRG_PD |
@@ -360,6 +384,10 @@ static const struct of_device_id phy_meson_g12a_usb2_of_match[] = {
 		.compatible = "amlogic,a1-usb2-phy",
 		.data = (void *)MESON_SOC_A1,
 	},
+	{
+		.compatible = "amlogic,sc2-usb2-phy",
+		.data = (void *)MESON_SOC_SC2,
+	},
 	{ /* Sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, phy_meson_g12a_usb2_of_match);
diff --git a/drivers/phy/amlogic/phy-meson-g12a-usb3-pcie.c b/drivers/phy/amlogic/phy-meson-g12a-usb3-pcie.c
index 5468831d6ab9bb5b8ff057d6f8c6061616ff626d..6abc5f5c1e4c617492d2d6d1698bb53c43393e2c 100644
--- a/drivers/phy/amlogic/phy-meson-g12a-usb3-pcie.c
+++ b/drivers/phy/amlogic/phy-meson-g12a-usb3-pcie.c
@@ -52,6 +52,11 @@
 
 #define PCIE_RESET_DELAY					500
 
+enum phy_g12a_usb3_pcie_soc_id {
+	MESON_USB3_PCIE_G12A,
+	MESON_USB3_PCIE_SC2,
+};
+
 struct phy_g12a_usb3_pcie_priv {
 	struct regmap		*regmap;
 	struct regmap		*regmap_cr;
@@ -59,6 +64,7 @@ struct phy_g12a_usb3_pcie_priv {
 	struct reset_control	*reset;
 	struct phy		*phy;
 	unsigned int		mode;
+	enum phy_g12a_usb3_pcie_soc_id soc_id;
 };
 
 static const struct regmap_config phy_g12a_usb3_pcie_regmap_conf = {
@@ -208,6 +214,12 @@ static int phy_g12a_usb3_init(struct phy *phy)
 			   PHY_R0_PCIE_USB3_SWITCH,
 			   PHY_R0_PCIE_USB3_SWITCH);
 
+	/* SC2 must leave the low-power state before accessing the CR bus. */
+	if (priv->soc_id == MESON_USB3_PCIE_SC2)
+		regmap_update_bits(priv->regmap, PHY_R0,
+				   PHY_R0_PCIE_POWER_STATE,
+				   FIELD_PREP(PHY_R0_PCIE_POWER_STATE, 0x1c));
+
 	/*
 	 * WORKAROUND: There is SSPHY suspend bug due to
 	 * which USB enumerates
@@ -219,7 +231,8 @@ static int phy_g12a_usb3_init(struct phy *phy)
 	if (ret)
 		return ret;
 
-	ret = regmap_update_bits(priv->regmap_cr, 0x1010, 0xff0, 20);
+	ret = regmap_update_bits(priv->regmap_cr, 0x1010, 0xff0,
+				 priv->soc_id == MESON_USB3_PCIE_SC2 ? 0x20 : 20);
 	if (ret)
 		return ret;
 
@@ -282,7 +295,8 @@ static int phy_g12a_usb3_pcie_power_on(struct phy *phy)
 {
 	struct phy_g12a_usb3_pcie_priv *priv = phy_get_drvdata(phy);
 
-	if (priv->mode == PHY_TYPE_USB3)
+	if (priv->mode == PHY_TYPE_USB3 &&
+	    priv->soc_id != MESON_USB3_PCIE_SC2)
 		return 0;
 
 	regmap_update_bits(priv->regmap, PHY_R0,
@@ -296,7 +310,8 @@ static int phy_g12a_usb3_pcie_power_off(struct phy *phy)
 {
 	struct phy_g12a_usb3_pcie_priv *priv = phy_get_drvdata(phy);
 
-	if (priv->mode == PHY_TYPE_USB3)
+	if (priv->mode == PHY_TYPE_USB3 &&
+	    priv->soc_id != MESON_USB3_PCIE_SC2)
 		return 0;
 
 	regmap_update_bits(priv->regmap, PHY_R0,
@@ -387,12 +402,15 @@ static int phy_g12a_usb3_pcie_probe(struct platform_device *pdev)
 	struct device_node *np = dev->of_node;
 	struct phy_g12a_usb3_pcie_priv *priv;
 	struct phy_provider *phy_provider;
+	struct clk *clk_bgp;
 	void __iomem *base;
 
 	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
 	if (!priv)
 		return -ENOMEM;
 
+	priv->soc_id = (uintptr_t)of_device_get_match_data(dev);
+
 	base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(base))
 		return PTR_ERR(base);
@@ -411,6 +429,13 @@ static int phy_g12a_usb3_pcie_probe(struct platform_device *pdev)
 	if (IS_ERR(priv->clk_ref))
 		return PTR_ERR(priv->clk_ref);
 
+	/* SC2 has a separately gated analog bandgap reference. */
+	if (priv->soc_id == MESON_USB3_PCIE_SC2) {
+		clk_bgp = devm_clk_get_enabled(dev, "bgp");
+		if (IS_ERR(clk_bgp))
+			return PTR_ERR(clk_bgp);
+	}
+
 	priv->reset = devm_reset_control_array_get_exclusive(dev);
 	if (IS_ERR(priv->reset))
 		return PTR_ERR(priv->reset);
@@ -428,7 +453,14 @@ static int phy_g12a_usb3_pcie_probe(struct platform_device *pdev)
 }
 
 static const struct of_device_id phy_g12a_usb3_pcie_of_match[] = {
-	{ .compatible = "amlogic,g12a-usb3-pcie-phy", },
+	{
+		.compatible = "amlogic,g12a-usb3-pcie-phy",
+		.data = (void *)MESON_USB3_PCIE_G12A,
+	},
+	{
+		.compatible = "amlogic,sc2-usb3-pcie-phy",
+		.data = (void *)MESON_USB3_PCIE_SC2,
+	},
 	{ },
 };
 MODULE_DEVICE_TABLE(of, phy_g12a_usb3_pcie_of_match);
diff --git a/drivers/usb/dwc3/dwc3-meson-g12a.c b/drivers/usb/dwc3/dwc3-meson-g12a.c
index 4d611c08e8a4cf09d51fb5b6255f0c5624600e25..47f8b2835320d70d74cd80ee4bb3d392215a1ddb 100644
--- a/drivers/usb/dwc3/dwc3-meson-g12a.c
+++ b/drivers/usb/dwc3/dwc3-meson-g12a.c
@@ -343,6 +343,7 @@ static int dwc3_meson_g12a_usb2_init(struct dwc3_meson_g12a *priv,
 static void dwc3_meson_g12a_usb3_init(struct dwc3_meson_g12a *priv)
 {
 	regmap_update_bits(priv->usb_glue_regmap, USB_R3,
+			USB_R3_P30_SSC_ENABLE |
 			USB_R3_P30_SSC_RANGE_MASK |
 			USB_R3_P30_REF_SSP_EN,
 			USB_R3_P30_SSC_ENABLE |
