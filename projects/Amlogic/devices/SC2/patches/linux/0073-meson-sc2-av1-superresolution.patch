                     return -EPROTO;
                 sc2_av1_ref_info(st, hw);
                 dma_wmb();
@@ -863,7 +910,7 @@ static int sc2_av1_run(struct meson_sc2_hevc_context *ctx,
                 if (!sequences || ++headers != 1 || p[13] || p[14] != f->frame_type ||
                     p[21] != f->order_hint || p[22] != f->primary_ref_frame ||
                     p[17] != f->refresh_frame_flags || p[25] != st->width ||
-                    p[26] != st->width || p[27] != st->height || p[56] != 8)
+                    p[26] != st->upscaled_width || p[27] != st->height || p[56] != 8)
                     return -EPROTO;
                 for (i = 0; i < 7; i++)
                     if (!av1_seq_intra(p[14]) && p[34 + i] != f->ref_frame_idx[i])
diff --git a/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_vdec.c b/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_vdec.c
index 88585560cc8e..8bded3119427 100644
--- a/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_vdec.c
+++ b/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_vdec.c
@@ -745,7 +745,7 @@ static int sc2_decode_av1(struct sc2_ctx *ctx, struct vb2_v4l2_buffer *src,
 		V4L2_CID_STATELESS_AV1_SEQUENCE)->p_req.p;
 	syntax.frame = sc2_request_control(hdl, V4L2_CID_STATELESS_AV1_FRAME)->p_req.p;
 	frame = syntax.frame;
-	if (frame->frame_width_minus_1 + 1 != ctx->source_fmt.width ||
+	if (frame->upscaled_width != ctx->source_fmt.width ||
 	    frame->frame_height_minus_1 + 1 != ctx->source_fmt.height)
 		return -EINVAL;
 	tiles = sc2_request_control(hdl, V4L2_CID_STATELESS_AV1_TILE_GROUP_ENTRY);
