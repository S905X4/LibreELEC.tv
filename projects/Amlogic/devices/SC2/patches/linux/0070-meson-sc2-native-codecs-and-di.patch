+static bool mpeg12_multi_timestamps_empty(struct amvdec_session *sess)
+{
+	unsigned long flags;
+	bool empty;
+
+	spin_lock_irqsave(&sess->ts_spinlock, flags);
+	empty = list_empty(&sess->timestamps);
+	spin_unlock_irqrestore(&sess->ts_spinlock, flags);
+	return empty;
