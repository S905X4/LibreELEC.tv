+#define MPEG12_MULTI_SWAP_CTL 0x3158
+#define MPEG12_MULTI_F_CODE 0x3008
+#define MPEG12_MULTI_SLICE_TYPE 0x3010
+#define MPEG12_MULTI_MB_INFO 0x30b0
+#define MPEG12_MULTI_VCOP_CTRL 0x3800
