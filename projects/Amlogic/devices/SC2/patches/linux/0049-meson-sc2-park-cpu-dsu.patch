From 0b2a9065de488c079fc76d72929087336d221f9e Mon Sep 17 00:00:00 2001
From: hiper25 <whydonit@gmail.com>
Date: Wed, 21 Oct 2026 04:10:52 +0800
Subject: [PATCH] cpufreq: sc2: Park both consumers before programming PLLs

The DSU could remain on GP1 while its 1.2/1.5 GHz output was changed.
Park CPU at or below both endpoints, then park DSU on that safe core
clock before reprogramming either PLL. Keep the stock OPP and DSU policy.

Latch supply errors as well as clock errors, and do not repeat partially
completed voltage requests through the triplet fallback helper.

Production callback smoke covers 169 OPP pairs, 1924 injected clock
failures and inherited 1512 to 1608 MHz correction. Production Image,
modules and board DTB build successfully; hardware acceptance is pending.

Change-Id: I386d57505442772b362ecc15e85d5354c70978dc
---
 drivers/cpufreq/sc2-cpufreq.c | 54 ++++++++++++++++++++---------------
 1 file changed, 31 insertions(+), 23 deletions(-)

diff --git a/drivers/cpufreq/sc2-cpufreq.c b/drivers/cpufreq/sc2-cpufreq.c
index 498331418977..fe898584a1df 100644
--- a/drivers/cpufreq/sc2-cpufreq.c
+++ b/drivers/cpufreq/sc2-cpufreq.c
@@ -32,7 +32,7 @@ static struct clk_bulk_data sc2_clocks[] = {
 };
 
 static struct platform_device *sc2_pdev;
-static bool sc2_clock_failed;
+static bool sc2_transition_failed;
 static bool sc2_regulator_enabled;
 
 struct sc2_cpufreq {
@@ -66,13 +66,28 @@ static int sc2_cpufreq_config_clks(struct device *dev, struct opp_table *table,
 
 	if (!opp)
 		return -EINVAL;
-	if (sc2_clock_failed)
+	if (sc2_transition_failed)
 		return -EIO;
 
 	rate = data ? *(unsigned long *)data : dev_pm_opp_get_freq(opp);
 	old_rate = clk_get_rate(core);
 	park_rate = min3(old_rate, rate, 1000000000UL);
 
+	/* Park both consumers before changing either SYS or GP1. */
+	ret = clk_set_rate(low, park_rate);
+	if (ret)
+		goto failed;
+	if (!clk_get_rate(low) || clk_get_rate(low) > park_rate) {
+		ret = -EIO;
+		goto failed;
+	}
+	ret = clk_set_parent(core, low);
+	if (ret)
+		goto failed;
+	ret = clk_set_parent(dsu, core);
+	if (ret)
+		goto failed;
+
 	/*
 	 * OPP calls us after raising voltage, and before lowering it. The DSU
 	 * follows the CPU up to 1.2 GHz, then uses its independent GP1 path.
@@ -88,14 +103,6 @@ static int sc2_cpufreq_config_clks(struct device *dev, struct opp_table *table,
 			goto failed;
 	}
 
-	/* Never reprogram the SYS PLL while the CPU is running from it. */
-	ret = clk_set_rate(low, park_rate);
-	if (ret)
-		goto failed;
-	ret = clk_set_parent(core, low);
-	if (ret)
-		goto failed;
-
 	if (rate > 1000000000UL) {
 		ret = sc2_set_rate_checked(high, rate);
 		if (ret)
@@ -113,12 +120,6 @@ static int sc2_cpufreq_config_clks(struct device *dev, struct opp_table *table,
 		goto failed;
 	}
 
-	if (rate <= 1200000000UL) {
-		ret = clk_set_parent(dsu, core);
-		if (ret)
-			goto failed;
-	}
-
 	return 0;
 
 failed:
@@ -126,7 +127,7 @@ static int sc2_cpufreq_config_clks(struct device *dev, struct opp_table *table,
 	 * Leave the raised/old voltage intact. A later request must not lower
 	 * it while the actual CPU/DSU state after a firmware failure is unknown.
 	 */
-	sc2_clock_failed = true;
+	sc2_transition_failed = true;
 	dev_err(dev, "CPU/DSU transition failed (%d); retaining voltage\n", ret);
 	return ret;
 }
@@ -140,7 +141,7 @@ static int sc2_cpufreq_config_regulators(struct device *dev,
 	struct dev_pm_opp_supply supply;
 	int ret;
 
-	if (sc2_clock_failed)
+	if (sc2_transition_failed)
 		return -EIO;
 	if (count != 1)
 		return -EINVAL;
@@ -148,18 +149,25 @@ static int sc2_cpufreq_config_regulators(struct device *dev,
 	ret = dev_pm_opp_get_supplies(new_opp, &supply);
 	if (ret)
 		return ret;
-	ret = regulator_set_voltage_triplet(regulators[0], supply.u_volt_min,
-					    supply.u_volt, supply.u_volt_max);
+
+	/* Do not retry a partially completed supply change behind OPP's back. */
+	ret = regulator_set_voltage(regulators[0], supply.u_volt_min,
+				    supply.u_volt_max);
 	if (ret)
-		return ret;
+		goto failed;
 
 	if (!sc2_regulator_enabled) {
 		ret = regulator_enable(regulators[0]);
 		if (ret)
-			return ret;
+			goto failed;
 		sc2_regulator_enabled = true;
 	}
 	return 0;
+
+failed:
+	sc2_transition_failed = true;
+	dev_err(dev, "CPU supply transition failed (%d); disabling DVFS\n", ret);
+	return ret;
 }
 
 static int sc2_cpufreq_check_pwm_source(struct device *dev)
@@ -198,7 +206,7 @@ static int sc2_cpufreq_probe(struct platform_device *pdev)
 	if (!of_property_present(cpu_dev->of_node, "cpu-supply"))
 		return dev_err_probe(&pdev->dev, -EINVAL, "CPU supply is required\n");
 
-	sc2_clock_failed = false;
+	sc2_transition_failed = false;
 	sc2_regulator_enabled = false;
 	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
 	if (!priv)
-- 
