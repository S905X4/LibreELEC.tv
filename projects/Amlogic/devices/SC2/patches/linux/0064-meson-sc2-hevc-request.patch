+static int sc2_querycap(struct file *file, void *priv,
+			struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, SC2_NAME, sizeof(cap->driver));
+	strscpy(cap->card, "Amlogic SC2 HEVC/AV1 Request", sizeof(cap->card));
+	return 0;
+}
