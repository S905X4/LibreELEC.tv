From ca6b8ee7d364578ab15bffbacc4f28eccfa52682 Mon Sep 17 00:00:00 2001
From: hiper25 <whydonit@gmail.com>
Date: Tue, 20 Oct 2026 00:37:36 +0800
Subject: [PATCH] arm64: dts: amlogic: Use the defined SC2 CECB mux clock IDs

The CECB assigned-clock graph used SEL spellings absent from the SC2
provider header. Use the existing MUX_PRE and MUX IDs, preserving the
intended dual-divider parent path and final 32768 Hz request.

No clock ID, register or firmware interface is invented or renumbered.

---
 arch/arm64/boot/dts/amlogic/meson-sc2.dtsi | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/amlogic/meson-sc2.dtsi b/arch/arm64/boot/dts/amlogic/meson-sc2.dtsi
index 101e79487f139bf821c1ed06d931d71e47f8a3b3..05abf9eef7d89989d876143e0ee5e9d5f0042ae7 100644
--- a/arch/arm64/boot/dts/amlogic/meson-sc2.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-sc2.dtsi
@@ -264,11 +264,11 @@ cec: cec@fe044000 {
 			interrupts = <GIC_SPI 180 IRQ_TYPE_EDGE_RISING>;
 			clocks = <&clkc CLKID_CECB_32K_CLKOUT>;
 			clock-names = "core";
-			assigned-clocks = <&clkc CLKID_CECB_32K_SEL_PRE>,
-					  <&clkc CLKID_CECB_32K_SEL>,
+			assigned-clocks = <&clkc CLKID_CECB_32K_MUX_PRE>,
+					  <&clkc CLKID_CECB_32K_MUX>,
 					  <&clkc CLKID_CECB_32K_CLKOUT>;
 			assigned-clock-parents = <&clkc CLKID_CECB_32K_DIV>,
-						 <&clkc CLKID_CECB_32K_SEL_PRE>, <0>;
+						 <&clkc CLKID_CECB_32K_MUX_PRE>, <0>;
 			assigned-clock-rates = <0>, <0>, <32768>;
 			hdmi-phandle = <&hdmi_tx>;
 			status = "disabled";
