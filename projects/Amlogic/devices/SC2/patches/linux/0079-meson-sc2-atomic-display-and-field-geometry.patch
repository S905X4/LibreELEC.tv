 			(crtc_state->mode.hdisplay - 1),
 			priv->io_base + _REG(VPP_OSD1_BLD_H_SCOPE));
 	writel_relaxed(0 << 16 |
-			(crtc_state->mode.vdisplay - 1),
+			(vdisplay - 1),
 			priv->io_base + _REG(VPP_OSD1_BLD_V_SCOPE));
 	writel_relaxed(crtc_state->mode.hdisplay << 16 |
