From: SC2 bring-up <sc2@localhost>
Subject: [PATCH] drm/meson: complete applied flips and correct SC2 field geometry

Keep framebuffer ownership until the corresponding IRQ applies its shadows.
Publish plane changes with their event and avoid resetting unchanged primary
AFBC state for video-only flips. Track applied interlace phases per field.

Match SC2 horizontal-repeat bit positions and FBC image bounds; correct the
odd-field vertical-sync end to the source encoder's back-porch calculation.

--- a/drivers/gpu/drm/meson/meson_crtc.c
+++ b/drivers/gpu/drm/meson/meson_crtc.c
@@ -12,6 +12,7 @@
 #include <linux/bitfield.h>
 #include <linux/soc/amlogic/meson-canvas.h>
 
+#include <drm/drm_atomic.h>
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_device.h>
 #include <drm/drm_print.h>
@@ -38,7 +39,10 @@
 	void (*enable_osd1_afbc)(struct meson_drm *priv);
 	void (*disable_osd1_afbc)(struct meson_drm *priv);
 	bool vsync_forced;
-	bool vsync_disabled;
+	bool osd1_afbcd;
+	bool vd1_interlace;
+	u32 vd1_vsc_ini_phase[2];
+	u32 vd1_vsc_phase_ctrl[2];
 };
 #define to_meson_crtc(x) container_of(x, struct meson_crtc, base)
 
@@ -49,7 +53,6 @@
 	struct meson_crtc *meson_crtc = to_meson_crtc(crtc);
 	struct meson_drm *priv = meson_crtc->priv;
 
-	meson_crtc->vsync_disabled = false;
 	meson_venc_enable_vsync(priv);
 
 	return 0;
@@ -60,10 +63,8 @@
 	struct meson_crtc *meson_crtc = to_meson_crtc(crtc);
 	struct meson_drm *priv = meson_crtc->priv;
 
-	if (!meson_crtc->vsync_forced) {
-		meson_crtc->vsync_disabled = true;
+	if (!meson_crtc->vsync_forced)
 		meson_venc_disable_vsync(priv);
-	}
 }
 
