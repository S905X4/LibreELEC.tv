+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included by meson_sc2_hw.c, after its private engine/DMA helpers.
+ * AVS2 P2 uses the vendor RPM/DPB protocol, not a Request syntax shim.
+ * Firmware 27 on core 2 parses the actual compressed access unit. All retained
+ * pictures are native MMU/FBC objects; double-write is deliberately disabled.
+ */
+#include "meson_sc2_avs2_api.h"
+#include "meson_sc2_avs2_global.h"
+
+#define A2_REG(n) ((n) * 4U)
+#define A2_SHIFT_PROTECT A2_REG(0x313a)
+#define A2_PARSER_RESULT3 A2_REG(0x311b)
+#define A2_MPRED_CTRL9 A2_REG(0x325b)
+#define A2_DBLK_CFGD A2_REG(0x350d)
+#define A2_MCRCC_PERF A2_REG(0x34f3)
+#define A2_DECOMP_PERF A2_REG(0x34c5)
+
+/* TM2-revB/SC2 4096x2304 workspace from vendor specification 4. DBLK
+ * parameter/data capacities are 0x8100/0x88800/0x88800, each rounded to a
+ * page. Earlier-generation 0x80000 data buffers are too small for SC2.
+ * RPM/LMEM reserve the full 0x600-word bank. VBH has two 0x2800 banks.
+ */
+#define A2_IPP       0x000000
+#define A2_ALF       0x004000
+#define A2_RCS       0x005000
+#define A2_SPS       0x006000
+#define A2_PPS       0x007000
+#define A2_SWAP2     0x00a000
+#define A2_DBLK_PARA 0x00b000
+#define A2_DBLK_DATA 0x014000
+#define A2_DBLK_DATA2 0x09d000
+#define A2_VBH       0x126000
+#define A2_MPRED_ABOVE 0x12c000
+#define A2_RPM       0x130000
+#define A2_LMEM      0x132000
+#define A2_MAP       0x134000
+#define A2_CUVA      0x144000
+#define A2_WORK_SIZE 0x145000
+
+struct sc2_avs2_picture {
+	struct meson_sc2_surface *surface;
+	struct meson_sc2_surface storage;
+	u64 timestamp;
+	u8 depth;
+	bool valid;
+};
+
+struct sc2_avs2_state {
+	struct avs2_decoder dec;
+	struct sc2_avs2_picture picture[AVS2_MAX_BUFFER_NUM];
+	u32 iqit[1024];
+	u32 start_flag, decode_count;
+	bool iqit_valid;
+};
+
+static const u16 sc2_avs2_wq4[16] = {
+	64, 64, 64, 68, 64, 64, 68, 72,
+	64, 68, 76, 80, 72, 76, 84, 96,
+};
+static const u16 sc2_avs2_wq8[64] = {
+	64, 64, 64, 64, 68, 68, 72, 76,
+	64, 64, 64, 68, 72, 76, 84, 92,
+	64, 64, 68, 72, 76, 80, 88, 100,
+	64, 68, 72, 80, 84, 92, 100, 112,
+	68, 72, 80, 84, 92, 104, 112, 128,
+	76, 80, 84, 92, 104, 116, 132, 152,
+	96, 100, 104, 116, 124, 140, 164, 188,
+	104, 108, 116, 128, 152, 172, 192, 216,
+};
+
+static void sc2_avs2_reset(struct meson_sc2_hevc_context *ctx)
+{
+	struct sc2_avs2_state *st = ctx->avs2;
+
+	if (!st)
+		return;
+	memset(st, 0, sizeof(*st));
+	init_avs2_decoder(&st->dec);
+	st->dec.ref_maxbuffer = REF_MAXBUFFER;
+	/* Establish stable frame indices before the first sequence notification:
+	 * prepare_header may flush the DPB even before the first picture header.
+	 */
+	avs2_init_global_buffers(&st->dec);
+	memset(ctx->work, 0, A2_WORK_SIZE);
+}
+
+/* Decoder failure retires its references, not presentations already handed
+ * to userspace. Their QBUF must still release the original slot ownership.
+ */
+static void sc2_avs2_error_reset(struct meson_sc2_hevc_context *ctx)
+{
+	struct sc2_avs2_state *st = ctx->avs2;
+	int held[AVS2_MAX_BUFFER_NUM];
+	unsigned int i;
+
+	for (i = 0; i < AVS2_MAX_BUFFER_NUM; i++) {
+		held[i] = st->dec.frm_pool[i].vf_ref;
+		if (!held[i])
+			memset(&st->picture[i], 0, sizeof(st->picture[i]));
+	}
+	init_avs2_decoder(&st->dec);
+	avs2_init_global_buffers(&st->dec);
+	for (i = 0; i < AVS2_MAX_BUFFER_NUM; i++)
+		st->dec.frm_pool[i].vf_ref = held[i];
+	st->start_flag = 0;
+	st->decode_count = 0;
+	st->iqit_valid = false;
+	memset(ctx->work, 0, A2_WORK_SIZE);
+}
+
+static void sc2_avs2_release(struct meson_sc2_hevc_context *ctx)
+{
+	kfree(ctx->avs2);
+	ctx->avs2 = NULL;
+}
+
+static int sc2_avs2_alloc(struct meson_sc2_hevc_context *ctx)
+{
+	BUILD_BUG_ON(A2_WORK_SIZE > SC2_WORK_SIZE);
+	BUILD_BUG_ON(AVS2_MAX_BUFFER_NUM > 32);
+	if (ctx->avs2)
+		return 0;
+	ctx->avs2 = kzalloc(sizeof(*ctx->avs2), GFP_KERNEL);
+	if (!ctx->avs2)
+		return -ENOMEM;
+	sc2_avs2_reset(ctx);
+	return 0;
+}
+
+/* Match the manager's reuse criterion, not just referred_by_others: F pictures
+ * and output-pending nonreferences can carry a zero reference flag while their
+ * coding-order/POC identity is still live. Background storage is independent.
+ */
+static bool sc2_avs2_frame_busy(struct avs2_decoder *dec,
+			       struct avs2_frame_s *f)
+{
+	return dec->hc.cur_pic == f || dec->f_bg == f || f->bg_flag ||
+		f->vf_ref || f->to_prepare_disp || f->is_output != -1 ||
+		f->imgcoi_ref >= -256;
+}
+
+static bool sc2_avs2_busy_locked(struct sc2_avs2_state *st,
+				struct meson_sc2_surface *surface)
+{
+	unsigned int i;
+
+	if (!st)
+		return false;
+	for (i = 0; i < AVS2_MAX_BUFFER_NUM; i++)
+		if (st->picture[i].surface == surface && st->picture[i].valid &&
+		    sc2_avs2_frame_busy(&st->dec, &st->dec.frm_pool[i]))
+			return true;
+	return false;
+}
+
+bool meson_sc2_avs2_surface_busy(struct meson_sc2_hevc_context *ctx,
+			       struct meson_sc2_surface *surface)
+{
+	bool busy;
+
+	if (!ctx || !surface)
+		return false;
+	mutex_lock(&ctx->hw->lock);
+	busy = ctx->hw->fatal || sc2_avs2_busy_locked(ctx->avs2, surface);
+	mutex_unlock(&ctx->hw->lock);
+	return busy;
+}
+
+static void sc2_avs2_parser(struct meson_sc2_hevc_context *ctx, size_t length)
+{
+	struct meson_sc2_hw *hw = ctx->hw;
+	struct sc2_avs2_state *st = ctx->avs2;
+	u32 b = lower_32_bits(ctx->work_dma);
+	u32 in = lower_32_bits(ctx->input_dma);
+	unsigned int i;
+
+	sc2_write(hw, HEVCD_IPP_LINEBUFF_BASE, b + A2_IPP);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_1, b + A2_RPM);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_2, b + A2_ALF);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_3, b + A2_RCS);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_4, b + A2_SPS);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_5, b + A2_PPS);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_7, b + A2_MAP);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_8, b + A2_SWAP2);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_9, b + A2_LMEM);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_A, b + A2_CUVA);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_B, (SZ_4K >> 4) << 16);
+	sc2_write(hw, HEVC_DBLK_CFG3, 0x404010);
+	sc2_write(hw, HEVC_DBLK_CFG4, b + A2_DBLK_PARA);
+	sc2_write(hw, HEVC_DBLK_CFG5, b + A2_DBLK_DATA);
+	sc2_write(hw, HEVC_DBLK_CFGE, b + A2_DBLK_DATA2);
+	sc2_write(hw, HEVC_SAO_MMU_VH0_ADDR, b + A2_VBH);
+	sc2_write(hw, HEVC_SAO_MMU_VH1_ADDR, b + A2_VBH + 0x2800);
+	sc2_write(hw, HEVC_MPRED_ABV_START_ADDR, b + A2_MPRED_ABOVE);
+	sc2_write(hw, HEVC_SAO_CTRL5,
+		  (sc2_read(hw, HEVC_SAO_CTRL5) | BIT(10)) &
+		  ~(BIT(9) | BIT(15) | BIT(7)));
+	sc2_write(hw, HEVCD_MPP_DECOMP_CTL1, BIT(4));
+	sc2_write(hw, HEVCD_MPP_DECOMP_CTL2, 0);
+	sc2_write(hw, HEVC_STREAM_CONTROL, 0x0eb14070);
+	sc2_write(hw, HEVC_STREAM_START_ADDR, in);
+	sc2_write(hw, HEVC_STREAM_END_ADDR, in + SC2_INPUT_SIZE);
+	sc2_write(hw, HEVC_STREAM_RD_PTR, in);
+	sc2_write(hw, HEVC_STREAM_WR_PTR,
+		  in + round_down(length + SC2_INPUT_PADDING, 64));
+	sc2_write(hw, HEVC_STREAM_FIFO_CTL,
+		  sc2_read(hw, HEVC_STREAM_FIFO_CTL) | BIT(29));
+	sc2_write(hw, HEVC_PARSER_INT_CONTROL,
+		  (sc2_read(hw, HEVC_PARSER_INT_CONTROL) & ~(7U << 29)) |
+		  (3U << 29) | BIT(24) | BIT(22) | BIT(7) | BIT(4) | BIT(0));
+	sc2_write(hw, HEVC_SHIFT_STATUS,
+		  (sc2_read(hw, HEVC_SHIFT_STATUS) & ~BIT(1)) | BIT(0));
+	sc2_write(hw, HEVC_SHIFT_CONTROL,
+		  (6 << 20) | (3 << 6) | (2 << 4) | (2 << 1) | 1);
+	sc2_write(hw, A2_SHIFT_PROTECT, BIT(29));
+	sc2_write(hw, HEVC_SHIFT_STARTCODE, 0x00000100);
+	sc2_write(hw, HEVC_SHIFT_EMULATECODE, 0);
+	sc2_write(hw, HEVC_SHIFT_BYTE_COUNT, 0);
+	sc2_write(hw, HEVC_CABAC_CONTROL, 1);
+	sc2_write(hw, HEVC_PARSER_CORE_CONTROL, 1);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_0, 0);
+	sc2_write(hw, HEVC_IQIT_SCALELUT_WR_ADDR, 0);
+	for (i = 0; i < ARRAY_SIZE(st->iqit); i++)
+		sc2_write(hw, HEVC_IQIT_SCALELUT_DATA,
+			  st->iqit_valid ? st->iqit[i] : 0);
+	if (!st->iqit_valid) {
+		sc2_write(hw, HEVC_IQIT_SCALELUT_WR_ADDR, 64);
+		for (i = 0; i < ARRAY_SIZE(sc2_avs2_wq4); i++)
+			sc2_write(hw, HEVC_IQIT_SCALELUT_DATA, sc2_avs2_wq4[i]);
+		sc2_write(hw, HEVC_IQIT_SCALELUT_WR_ADDR, 0);
+		for (i = 0; i < ARRAY_SIZE(sc2_avs2_wq8); i++)
+			sc2_write(hw, HEVC_IQIT_SCALELUT_DATA, sc2_avs2_wq8[i]);
+	}
+	sc2_write(hw, HEVC_PARSER_CMD_WRITE, BIT(16));
+	for (i = 0; i < ARRAY_SIZE(sc2_parser_commands); i++)
+		sc2_write(hw, HEVC_PARSER_CMD_WRITE, sc2_parser_commands[i]);
+	sc2_write(hw, HEVC_PARSER_CMD_SKIP_0, 0x0000090b);
+	sc2_write(hw, HEVC_PARSER_CMD_SKIP_1, 0x1b14140f);
+	sc2_write(hw, HEVC_PARSER_CMD_SKIP_2, 0x001b1910);
+	sc2_write(hw, HEVC_PARSER_IF_CONTROL, BIT(9) | BIT(5) | BIT(2) | BIT(0));
+	sc2_write(hw, HEVC_MPRED_INT_STATUS, BIT(31));
+	sc2_write(hw, A2_PARSER_RESULT3, U32_MAX);
+	sc2_write(hw, HEVCD_IPP_TOP_CNTL, 1);
+	sc2_write(hw, HEVCD_IPP_TOP_CNTL, 2);
+	sc2_write(hw, HEVC_DBLK_CFGB,
+		  (sc2_read(hw, HEVC_DBLK_CFGB) & ~0x30f) | BIT(8) | 2);
+	sc2_write(hw, HEVC_DBLK_CFG0, 1);
+	sc2_write(hw, A2_MCRCC_PERF, 1);
+	sc2_write(hw, A2_MCRCC_PERF, 0);
+	sc2_write(hw, A2_DECOMP_PERF, 1);
+	sc2_write(hw, A2_DECOMP_PERF, 0);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_E, 1);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_F, 0);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_G, 0);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_H, 0);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_I, 8);
+	/* Vendor frame-based mode includes the new-generation chip feature byte.
+	 * Bits 16..23 retain sequence/I readiness across loaded firmware jobs.
+	 */
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_J, 0x80000002U | (st->start_flag << 16));
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_K, 0);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_L, 0);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_M, st->decode_count);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_N, length);
+	sc2_write(hw, HEVC_PSCALE_CTRL, 0);
+	sc2_write(hw, SC2_MBOX_CLEAR, 1);
+	sc2_write(hw, SC2_MBOX_MASK, 1);
+	sc2_write(hw, HEVC_STREAM_CONTROL, sc2_read(hw, HEVC_STREAM_CONTROL) | 1);
+	sc2_write(hw, HEVC_ASSIST_SCRATCH_0, 0xf1); /* AVS2_SEARCH_NEW_PIC */
+}
+
+static u32 sc2_avs2_canvas(struct avs2_frame_s *f)
+{
+	return f->index * 0x010101U;
+}
+
+static int sc2_avs2_mc(struct sc2_avs2_state *st, struct meson_sc2_hw *hw)
+{
+	struct avs2_decoder *d = &st->dec;
+	unsigned int i;
+
+	for (i = 0; i < AVS2_MAX_BUFFER_NUM; i++) {
+		struct sc2_avs2_picture *p = &st->picture[i];
+
+		sc2_write(hw, HEVCD_MPP_ANC2AXI_TBL_CONF_ADDR, BIT(1) | (i << 8));
+		sc2_write(hw, HEVCD_MPP_ANC2AXI_TBL_DATA,
+			  p->valid ? lower_32_bits(p->storage.dma) >> 5 : 0);
+	}
+	sc2_write(hw, HEVCD_MPP_ANC2AXI_TBL_CONF_ADDR, 1);
+	sc2_write(hw, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, 1);
+	for (i = 0; i < 32; i++)
+		sc2_write(hw, HEVCD_MPP_ANC_CANVAS_DATA_ADDR, 0);
+	if (d->f_bg) {
+		if (d->f_bg->index < 0 || d->f_bg->index >= AVS2_MAX_BUFFER_NUM ||
+		    !st->picture[d->f_bg->index].valid)
+			return -ENOENT;
+		sc2_write(hw, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, (15 << 8) | 1);
+		sc2_write(hw, HEVCD_MPP_ANC_CANVAS_DATA_ADDR, sc2_avs2_canvas(d->f_bg));
+		sc2_write(hw, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, (31 << 8) | 1);
+		sc2_write(hw, HEVCD_MPP_ANC_CANVAS_DATA_ADDR, sc2_avs2_canvas(d->f_bg));
+	}
+	if (d->img.type == I_IMG)
+		return 0;
+	for (i = 0; i < d->img.num_of_references; i++) {
+		struct avs2_frame_s *f = d->fref[i];
+
+		if (f->index < 0 || f->index >= AVS2_MAX_BUFFER_NUM ||
+		    !st->picture[f->index].valid || f->error_mark)
+			return -ENOENT;
+	}
+	if (d->img.type == B_IMG) {
+		sc2_write(hw, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, 1);
+		sc2_write(hw, HEVCD_MPP_ANC_CANVAS_DATA_ADDR, sc2_avs2_canvas(d->fref[1]));
+		sc2_write(hw, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, (16 << 8) | 1);
+		sc2_write(hw, HEVCD_MPP_ANC_CANVAS_DATA_ADDR, sc2_avs2_canvas(d->fref[0]));
+	} else {
+		sc2_write(hw, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, 1);
+		for (i = 0; i < d->img.num_of_references; i++)
+			sc2_write(hw, HEVCD_MPP_ANC_CANVAS_DATA_ADDR, sc2_avs2_canvas(d->fref[i]));
+		if (d->img.type == F_IMG) {
+			sc2_write(hw, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, (16 << 8) | 1);
+			for (i = 0; i < d->img.num_of_references; i++)
+				sc2_write(hw, HEVCD_MPP_ANC_CANVAS_DATA_ADDR,
+					  sc2_avs2_canvas(d->fref[i]));
+		}
+	}
+	return 0;
+}
+
+static void sc2_avs2_mcrcc(struct avs2_decoder *d, struct meson_sc2_hw *hw)
+{
+	u32 a, b;
+
+	sc2_write(hw, HEVCD_MCRCC_CTL1, 2);
+	if (d->img.type == I_IMG) {
+		sc2_write(hw, HEVCD_MCRCC_CTL1, 0);
+		return;
+	}
+	sc2_write(hw, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR,
+		  d->img.type == P_IMG ? 2 : 0);
+	a = sc2_read(hw, HEVCD_MPP_ANC_CANVAS_DATA_ADDR) & 0xffff;
+	a |= a << 16;
+	sc2_write(hw, HEVCD_MCRCC_CTL2, a);
+	if (d->img.type == B_IMG || d->img.type == F_IMG)
+		sc2_write(hw, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, (16 << 8) | 2);
+	b = sc2_read(hw, HEVCD_MPP_ANC_CANVAS_DATA_ADDR) & 0xffff;
+	b |= b << 16;
+	if ((d->img.type == B_IMG || d->img.type == F_IMG) && a == b) {
+		b = sc2_read(hw, HEVCD_MPP_ANC_CANVAS_DATA_ADDR) & 0xffff;
+		b |= b << 16;
+	}
+	sc2_write(hw, HEVCD_MCRCC_CTL3, b);
+	sc2_write(hw, HEVCD_MCRCC_CTL1, 0xff0);
+}
+
+static void sc2_avs2_mpred(struct avs2_decoder *d, struct meson_sc2_hw *hw)
+{
+	struct avs2_frame_s *cur = d->hc.cur_pic;
+	struct avs2_frame_s *col = d->img.num_of_references ? d->fref[0] :
+		(d->f_bg ? d->f_bg : cur);
+	u32 unit = d->lcu_size_log2 == 6 ? 0x200 :
+		   d->lcu_size_log2 == 5 ? 0x80 : 0x20;
+	unsigned int i;
+
+	sc2_write(hw, HEVC_MPRED_MV_WR_START_ADDR, cur->mpred_mv_wr_start_addr);
+	sc2_write(hw, HEVC_MPRED_MV_RD_START_ADDR, col->mpred_mv_wr_start_addr);
+	sc2_write(hw, A2_MPRED_CTRL9,
+		  ((d->bk_img_is_top_field & 1) << 13) |
+		  ((d->hd.background_picture_enable & 1) << 12) |
+		  ((d->hd.curr_RPS.num_of_ref & 7) << 8) |
+		  ((d->hd.b_pmvr_enabled & 1) << 6) |
+		  ((d->img.is_top_field & 1) << 5) |
+		  ((d->img.is_field_sequence & 1) << 4) |
+		  ((d->img.typeb & 7) << 1) |
+		  (d->hd.background_reference_enable & 1));
+	sc2_write(hw, HEVC_MPRED_CUR_POC, d->img.pic_distance);
+	sc2_write(hw, HEVC_MPRED_COL_POC, d->img.imgtr_next_P);
+	/* Pair order is a hardware latch requirement, not two independent arrays. */
+	for (i = 0; i < 7; i++) {
+		sc2_write(hw, HEVC_MPRED_L0_REF00_POC + i * 4,
+			  d->fref[i]->imgtr_fwRefDistance);
+		sc2_write(hw, HEVC_MPRED_L1_REF00_POC + i * 4,
+			  col->ref_poc[i]);
+	}
+	sc2_write(hw, HEVC_MPRED_MV_RD_END_ADDR,
+		  col->mpred_mv_wr_start_addr + d->lcu_x_num * d->lcu_y_num * unit);
+}
+
+static void sc2_avs2_alf_coeff(struct meson_sc2_hw *hw,
+			     const struct ALFParam_s *a, unsigned int group,
+			     bool last)
+{
+	s32 c[9], sum = 0;
+	unsigned int i;
+
+	for (i = 0; i < 8; i++) {
+		c[i] = a->coeffmulti[group][i];
+		sum += 2 * c[i];
+	}
+	c[8] = 64 - sum + a->coeffmulti[group][8];
+	sc2_write(hw, A2_DBLK_CFGD,
+		  ((c[4] & 0xf) << 28) | ((c[3] & 0x7f) << 21) |
+		  ((c[2] & 0x7f) << 14) | ((c[1] & 0x7f) << 7) | (c[0] & 0x7f));
+	sc2_write(hw, A2_DBLK_CFGD,
+		  (last ? BIT(31) : 0) | ((c[8] & 0x7f) << 24) |
+		  ((c[7] & 0x7f) << 17) | ((c[6] & 0x7f) << 10) |
+		  ((c[5] & 0x7f) << 3) | ((c[4] >> 4) & 7));
+}
+
+static void sc2_avs2_filters(struct avs2_decoder *d, struct meson_sc2_hw *hw)
+{
+	union param_u *p = &d->param;
+	struct ALFParam_s *y = &d->m_alfPictureParam[0];
+	u32 v, table = 0, bin = 0;
+	unsigned int i, groups = y->alf_flag ? y->filters_per_group : 1;
+
+	v = sc2_read(hw, HEVC_DBLK_CFG1) & ~(0xf0000 | 3);
+	v |= (d->input.sample_bit_depth == 10 ? 0xa0000 : 0) |
+		(p->p.lcu_size == 6 ? 0 : p->p.lcu_size == 5 ? 1 : 2);
+	sc2_write(hw, HEVC_DBLK_CFG1, v);
+	sc2_write(hw, HEVC_DBLK_CFG2, (d->img.height << 16) | d->img.width);
+	sc2_write(hw, HEVC_DBLK_CFG9,
+		  ((d->input.crossSliceLoopFilter & 1) << 27) |
+		  ((p->p.loop_filter_disable & 1) << 26) |
+		  ((d->input.useNSQT & 1) << 25) | ((d->img.type & 7) << 22) |
+		  ((p->p.alpha_c_offset & 0x1f) << 17) |
+		  ((p->p.beta_offset & 0x1f) << 12) |
+		  ((p->p.chroma_quant_param_delta_cb & 0x3f) << 6) |
+		  (p->p.chroma_quant_param_delta_cr & 0x3f));
+	/* DBLK's ALF port consumes Cr, Cb, two Y-bin words, then Y groups. */
+	sc2_avs2_alf_coeff(hw, &d->m_alfPictureParam[2], 0, false);
+	sc2_avs2_alf_coeff(hw, &d->m_alfPictureParam[1], 0, false);
+	for (i = 0; i < 16; i++) {
+		if (i && y->filters_per_group > 1 && y->filterPattern[i])
+			bin++;
+		table |= (bin & 0xf) << ((i & 7) * 4);
+		if ((i & 7) == 7) {
+			sc2_write(hw, A2_DBLK_CFGD, table);
+			table = 0;
+		}
+	}
+	for (i = 0; i < groups; i++)
+		sc2_avs2_alf_coeff(hw, y, i, i == groups - 1);
+}
+
+static int sc2_avs2_program(struct meson_sc2_hevc_context *ctx,
+			  const struct meson_sc2_avs2_job *job)
+{
+	struct sc2_avs2_state *st = ctx->avs2;
+	struct avs2_decoder *d = &st->dec;
+	struct meson_sc2_hw *hw = ctx->hw;
+	struct meson_sc2_surface *s = job->output.destination;
+	__le32 *map = ctx->work + A2_MAP;
+	u32 body = DIV_ROUND_UP(s->width, 64) * DIV_ROUND_UP(s->height, 32) *
+		   (d->input.sample_bit_depth == 10 ? 4096 : 3200);
+	u32 pages = DIV_ROUND_UP(body, SZ_4K), value;
+	unsigned int i;
+	int ret;
+
+	if (body > s->body_size || pages > SC2_MAP_ENTRIES ||
+	    d->lcu_total * (d->lcu_size_log2 == 6 ? 0x200 :
+			   d->lcu_size_log2 == 5 ? 0x80 : 0x20) > s->mv_size)
+		return -EOVERFLOW;
+	for (i = 0; i < SC2_MAP_ENTRIES; i++)
+		map[i] = cpu_to_le32((s->dma + s->body_offset +
+				     (i < pages ? i * SZ_4K : 0)) >> 12);
+	ret = sc2_avs2_mc(st, hw);
+	if (ret)
+		return ret;
+	sc2_avs2_mcrcc(d, hw);
+	sc2_avs2_mpred(d, hw);
+	sc2_avs2_filters(d, hw);
+	sc2_write(hw, HEVC_SAO_CTRL0,
+		  (sc2_read(hw, HEVC_SAO_CTRL0) & ~0xf) | d->lcu_size_log2);
+	sc2_write(hw, HEVC_SAO_Y_START_ADDR, U32_MAX);
+	sc2_write(hw, HEVC_SAO_C_START_ADDR, U32_MAX);
+	sc2_write(hw, HEVC_SAO_Y_LENGTH, 0);
+	sc2_write(hw, HEVC_SAO_C_LENGTH, 0);
+	sc2_write(hw, HEVC_CM_BODY_START_ADDR, lower_32_bits(s->dma + s->body_offset));
+	sc2_write(hw, HEVC_CM_HEADER_START_ADDR, lower_32_bits(s->dma));
+	value = sc2_read(hw, HEVC_SAO_CTRL1) & ~(0x3000 | 0xff0 | 3 | (3 << 14));
+	sc2_write(hw, HEVC_SAO_CTRL1, value | (2 << 14) | 0xff0 | BIT(1));
+	value = sc2_read(hw, HEVCD_IPP_AXIIF_CONFIG) & ~(0x30 | 0xf | (3 << 8));
+	sc2_write(hw, HEVCD_IPP_AXIIF_CONFIG, value | 0xf | (2 << 8));
+	value = sc2_read(hw, HEVC_SAO_CTRL5) & ~(BIT(9) | BIT(15) | (0xffU << 16));
+	if (d->input.sample_bit_depth == 8)
+		value |= BIT(9);
+	sc2_write(hw, HEVC_SAO_CTRL5, value | BIT(10));
+	sc2_write(hw, HEVCD_MPP_DECOMP_CTL1, BIT(4));
+	sc2_write(hw, HEVCD_MPP_DECOMP_CTL2, body >> 5);
+	sc2_write(hw, HEVC_CM_BODY_LENGTH, body);
+	sc2_write(hw, HEVC_CM_HEADER_OFFSET, body);
+	sc2_write(hw, HEVC_CM_HEADER_LENGTH, s->header_size);
+	d->hc.cur_pic->comp_body_size = body;
+	dma_wmb();
+	return 0;
+}
+
+static int sc2_avs2_header(struct meson_sc2_hevc_context *ctx,
+			   const struct meson_sc2_avs2_job *job,
+			   struct meson_sc2_avs2_result *result, u32 status,
+			   const u8 *pending, unsigned int pending_count)
+{
+	struct sc2_avs2_state *st = ctx->avs2;
+	struct avs2_decoder *d = &st->dec;
+	struct meson_sc2_surface *s = job->output.destination;
+	const __le16 *raw = ctx->work + A2_RPM;
+	struct avs2_frame_s *f;
+	u32 depth;
+	unsigned int i;
+	int ret;
+
+	dma_rmb();
+	for (i = 0; i < ARRAY_SIZE(d->param.l.data); i++)
+		d->param.l.data[i] = le16_to_cpu(raw[(i & ~3U) + 3 - (i & 3)]);
+	depth = (d->param.p.profile_id == BASELINE10_PROFILE ||
+		 d->param.p.profile_id == SCENE10_PROFILE) &&
+		d->param.p.encoding_precision == 2 ? 10 : 8;
+	result->width = d->param.p.horizontal_size;
+	result->height = d->param.p.vertical_size;
+	result->depth = depth;
+	if (!result->width || !result->height ||
+	    result->width > MESON_SC2_AVS2_MAX_WIDTH ||
+	    result->height > MESON_SC2_AVS2_MAX_HEIGHT || d->param.p.chroma_format != 1 ||
+	    d->param.p.lcu_size < 4 || d->param.p.lcu_size > 6 ||
+	    d->param.p.num_of_ref_cur > MAXREF || d->param.p.num_to_remove_cur > MAXREF)
+		return -EBADMSG;
+	if (!s || s->width != result->width || s->height != result->height ||
+	    s->depth != depth)
+		return -EPIPE;
+	/* Sequence/edit/end notifications can retire DPB entries. Defer them
+	 * until geometry is accepted, so a probe or source change is replayable.
+	 */
+	for (i = 0; i < pending_count; i++) {
+		avs2_prepare_header(d, pending[i]);
+		if (d->error)
+			return d->error;
+	}
+	avs2_prepare_header(d, status == 0x22 ? I_PICTURE_START_CODE : PB_PICTURE_START_CODE);
+	if (d->error || d->bufmgr_error_flag)
+		return d->error ?: -EBADMSG;
+	ret = avs2_process_header(d);
+	if (ret < 0)
+		return ret;
+	f = d->hc.cur_pic;
+	if (!f || f->index < 0 || f->index >= AVS2_MAX_BUFFER_NUM)
+		return -EPROTO;
+	/* A CAPTURE object may be reassigned only after its old DPB identity died. */
+	for (i = 0; i < AVS2_MAX_BUFFER_NUM; i++)
+		if (st->picture[i].surface == s)
+			st->picture[i].valid = false;
+	st->picture[f->index] = (struct sc2_avs2_picture) {
+		.surface = s, .storage = *s, .timestamp = job->timestamp,
+		.depth = depth, .valid = true,
+	};
+	f->header_adr = s->dma;
+	f->mpred_mv_wr_start_addr = lower_32_bits(s->mv_dma);
+	f->mc_canvas_y = f->index;
+	f->mc_canvas_u_v = f->index;
+	f->pic_w = result->width;
+	f->pic_h = result->height;
+	f->bit_depth = depth;
+	f->double_write_mode = 0;
+	f->lcu_total = d->lcu_total;
+	f->pts64 = job->timestamp;
+	f->decode_idx = st->decode_count;
+	f->error_mark = 0;
+	f->mmu_alloc_flag = 1;
+	return sc2_avs2_program(ctx, job);
+}
+
+static int sc2_avs2_run(struct meson_sc2_hevc_context *ctx,
+			const struct meson_sc2_avs2_job *job,
+			struct meson_sc2_avs2_result *result, bool *picture)
+{
+	struct meson_sc2_hw *hw = ctx->hw;
+	struct sc2_avs2_state *st = ctx->avs2;
+	unsigned long deadline = jiffies + SC2_JOB_TIMEOUT, remaining;
+	u32 status, sequence, code;
+	u8 pending[64];
+	unsigned int notifications = 0, pending_count = 0, i;
+	int ret;
+
+	*picture = false;
+	sc2_avs2_parser(ctx, job->size);
+	dma_wmb();
+	sc2_write(hw, SC2_DOS_SW_RESET3, BIT(12) | BIT(11));
+	sc2_write(hw, SC2_DOS_SW_RESET3, 0);
+	sc2_read(hw, SC2_DOS_SW_RESET3);
+	usleep_range(10, 20);
+	sc2_write(hw, HEVC_MPSR, 1);
+	for (;;) {
+		if (atomic_read(&ctx->aborted))
+			return -ECANCELED;
+		if (time_after_eq(jiffies, deadline))
+			return -ETIMEDOUT;
+		sequence = smp_load_acquire(&hw->irq_sequence);
+		status = sc2_read(hw, HEVC_ASSIST_SCRATCH_0) & 0xff;
+		if (status >= 0x21 && status <= 0x25) {
+			if (++notifications > 64)
+				return -EPROTO;
+			if (status == 0x22 || status == 0x23) {
+				if (*picture)
+					return -EBADMSG;
+				ret = sc2_avs2_header(ctx, job, result, status,
+						     pending, pending_count);
+				if (ret)
+					return ret;
+				*picture = true;
+				pending_count = 0;
+			} else {
+				code = status == 0x21 ? SEQUENCE_HEADER_CODE :
+				       status == 0x24 ? SEQUENCE_END_CODE :
+				       sc2_read(hw, HEVC_ASSIST_SCRATCH_J) & 0xff;
+				if (code != SEQUENCE_HEADER_CODE && code != SEQUENCE_END_CODE &&
+				    code != VIDEO_EDIT_CODE)
+					return -EBADMSG;
+				pending[pending_count++] = code;
+				if (code == SEQUENCE_HEADER_CODE)
+					st->start_flag |= 1;
+			}
+			dma_wmb();
+			sc2_write(hw, HEVC_ASSIST_SCRATCH_0, 0xff);
+			continue;
+		}
+		if (status == 0x30) {
+			u32 lcu = sc2_read(hw, HEVC_PARSER_LCU_START) & 0xffffff;
+
+			if (!*picture || lcu + 1 != st->dec.lcu_total ||
+			    sc2_read(hw, HEVC_SHIFT_BYTE_COUNT) > job->size + SC2_INPUT_PADDING ||
+			    (sc2_read(hw, SC2_SAO_MMU_STATUS) >> 16) >
+			    DIV_ROUND_UP(st->dec.hc.cur_pic->comp_body_size, SZ_4K))
+				return -EIO;
+			st->dec.hc.cur_pic->decoded_lcu = st->dec.lcu_total;
+			st->start_flag |= 3;
+			return 0;
+		}
+		if (status >= 0x31 && status <= 0x36) {
+			if (status == 0x34)
+				return -ETIMEDOUT;
+			if (status == 0x35)
+				return -EOVERFLOW;
+			/* Header-only access units legitimately exhaust input without
+			 * a decoded picture. Exhaustion during a picture is corruption.
+			 */
+			if (!*picture && notifications &&
+			    (status == 0x32 || status == 0x33 || status == 0x36)) {
+				for (i = 0; i < pending_count; i++) {
+					avs2_prepare_header(&st->dec, pending[i]);
+					if (st->dec.error)
+						return st->dec.error;
+				}
+				result->hidden = true;
+				return 0;
+			}
+			return -EBADMSG;
+		}
+		remaining = deadline - jiffies;
+		if ((long)remaining <= 0)
+			return -ETIMEDOUT;
+		wait_event_timeout(hw->wait, atomic_read(&ctx->aborted) ||
+			smp_load_acquire(&hw->irq_sequence) != sequence, remaining);
+	}
+}
+
+int meson_sc2_avs2_decode(struct meson_sc2_hevc_context *ctx,
+			const struct meson_sc2_avs2_job *job,
+			struct meson_sc2_avs2_result *result)
+{
+	struct meson_sc2_hw *hw;
+	struct sc2_avs2_state *st;
+	struct sc2_surface_owner *owner = NULL;
+	struct meson_sc2_surface *s;
+	s32 fw_status = -EIO;
+	bool recovered, picture = false, started = false;
+	u32 old_start_flag;
+	unsigned int i;
+	int ret, drain;
+
+	if (!ctx || !job || !result || !job->data || !job->size ||
+	    job->size > SC2_INPUT_SIZE - SC2_INPUT_PADDING ||
+	    (!!job->output.destination != !!job->output.output_buffer))
+		return -EINVAL;
+	memset(result, 0, sizeof(*result));
+	hw = ctx->hw;
+	s = job->output.destination;
+	mutex_lock(&hw->lock);
+	if (hw->fatal || atomic_read(&ctx->aborted)) {
+		ret = hw->fatal ? -EIO : -ECANCELED;
+		goto unlock;
+	}
+	ret = sc2_avs2_alloc(ctx);
+	if (ret)
+		goto unlock;
+	st = ctx->avs2;
+	old_start_flag = st->start_flag;
+	if (s && sc2_avs2_busy_locked(st, s)) {
+		ret = -EAGAIN;
+		goto unlock;
+	}
+	if (s) {
+		owner = sc2_owner(hw, s);
+		if (!owner || !s->capture_owned ||
+		    owner->capture_buffer != job->output.output_buffer ||
+		    owner->context != ctx || job->output.output_size < s->size ||
+		    s->width > MESON_SC2_AVS2_MAX_WIDTH ||
+		    s->height > MESON_SC2_AVS2_MAX_HEIGHT ||
+		    !s->width || !s->height || (s->depth != 8 && s->depth != 10)) {
+			ret = -EINVAL;
+			goto unlock;
+		}
+	}
+	memcpy(ctx->input, job->data, job->size);
+	memset(ctx->input + job->size, 0, SC2_INPUT_PADDING);
+	if (s) {
+		ret = sc2_pin_output(hw, &job->output);
+		if (ret)
+			goto unlock;
+	}
+	ret = sc2_power_on(hw);
+	if (ret)
+		goto unpin;
+	started = true;
+	ret = sc2_prepare(hw);
+	if (!ret) {
+		ret = meson_sm_call(hw->firmware, SM_VIDEO_FW_LOAD, &fw_status,
+				    27, 2, 0, 0, 0);
+		if (!ret && fw_status)
+			ret = -EIO;
+	}
+	if (!ret)
+		ret = sc2_avs2_run(ctx, job, result, &picture);
+	if (!ret) {
+		/* Preserve firmware-updated sequence/per-picture weighting RAM
+		 * before the shared engine reset or another codec can overwrite it.
+		 */
+		sc2_write(hw, HEVC_IQIT_SCALELUT_RD_ADDR, 0);
+		for (i = 0; i < ARRAY_SIZE(st->iqit); i++)
+			st->iqit[i] = sc2_read(hw, HEVC_IQIT_SCALELUT_DATA);
+		st->iqit_valid = true;
+	}
+	drain = sc2_drain(hw, &recovered);
+	if (drain) {
+		sc2_quarantine(hw, drain);
+		ret = -EIO;
+		goto unlock;
+	}
+	if (!ret && (recovered || atomic_read(&ctx->aborted)))
+		ret = recovered ? -EIO : -ECANCELED;
+	dma_rmb();
+	if (!ret && picture && (!sc2_surface_guards(s) ||
+	    memchr_inv(owner->private_mv + s->mv_size, SC2_GUARD_BYTE, SC2_GUARD_SIZE)))
+		ret = -EIO;
+	if (!ret && picture) {
+		struct avs2_frame_s *f = st->dec.hc.cur_pic;
+
+		s->poc = st->dec.img.pic_distance;
+		s->valid = true;
+		owner->surface.poc = s->poc;
+		owner->surface.valid = true;
+		result->surface = s;
+		result->timestamp = job->timestamp;
+		result->poc = s->poc;
+		result->hidden = st->dec.img.typeb == BACKGROUND_IMG &&
+			!st->dec.hd.background_picture_output_flag;
+		avs2_post_process(&st->dec);
+		if (st->dec.error || f->error_mark)
+			ret = st->dec.error ?: -EBADMSG;
+		st->dec.hc.cur_pic = NULL;
+		st->decode_count++;
+	}
+	sc2_power_off(hw);
+ unpin:
+	sc2_unpin_output(hw);
+	if (ret == -EPIPE) {
+		st->start_flag = old_start_flag;
+	} else if (ret && started && !hw->fatal) {
+		if (s) {
+			s->valid = false;
+			owner->surface.valid = false;
+		}
+		sc2_avs2_error_reset(ctx);
+	}
+ unlock:
+	mutex_unlock(&hw->lock);
+	return ret;
+}
+
+int meson_sc2_avs2_dequeue(struct meson_sc2_hevc_context *ctx, bool drain,
+			 struct meson_sc2_avs2_result *result)
+{
+	struct sc2_avs2_state *st;
+	struct avs2_frame_s *best = NULL;
+	struct sc2_avs2_picture *p;
+	unsigned int i;
+	int ret = -EAGAIN;
+
+	if (!ctx || !result)
+		return -EINVAL;
+	mutex_lock(&ctx->hw->lock);
+	st = ctx->avs2;
+	if (ctx->hw->fatal) {
+		ret = -EIO;
+		goto out;
+	}
+	if (!st)
+		goto out;
+	if (drain) {
+		ret = avs2_drain_output(&st->dec);
+		if (ret < 0)
+			goto out;
+		ret = -EAGAIN;
+	}
+	for (i = 0; i < AVS2_MAX_BUFFER_NUM; i++) {
+		struct avs2_frame_s *f = &st->dec.frm_pool[i];
+
+		if (f->to_prepare_disp > 0 && (!best || f->to_prepare_disp < best->to_prepare_disp))
+			best = f;
+	}
+	if (!best)
+		goto out;
+	p = &st->picture[best->index];
+	if (!p->valid) {
+		ret = -EIO;
+		goto out;
+	}
+	*result = (struct meson_sc2_avs2_result) {
+		.surface = p->surface, .timestamp = p->timestamp,
+		.width = best->pic_w, .height = best->pic_h, .depth = p->depth,
+		.poc = best->imgtr_fwRefDistance_bak,
+	};
+	best->to_prepare_disp = 0;
+	best->vf_ref++;
+	ret = 0;
+ out:
+	mutex_unlock(&ctx->hw->lock);
+	return ret;
+}
+
+int meson_sc2_avs2_put_output(struct meson_sc2_hevc_context *ctx,
+			    struct meson_sc2_surface *surface)
+{
+	struct sc2_avs2_state *st;
+	unsigned int i;
+	int ret = -ENOENT;
+
+	if (!ctx || !surface)
+		return -EINVAL;
+	mutex_lock(&ctx->hw->lock);
+	st = ctx->avs2;
+	if (ctx->hw->fatal) {
+		ret = -EIO;
+		goto out;
+	}
+	if (!st)
+		goto out;
+	for (i = 0; i < AVS2_MAX_BUFFER_NUM; i++)
+		if (st->picture[i].surface == surface && st->picture[i].valid &&
+		    st->dec.frm_pool[i].vf_ref > 0) {
+			st->dec.frm_pool[i].vf_ref--;
+			ret = 0;
+			break;
+		}
+ out:
+	mutex_unlock(&ctx->hw->lock);
+	return ret;
+}
diff --git a/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_avs2_api.h b/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_avs2_api.h
new file mode 100644
index 0000000000000000000000000000000000000000..c7c3ff29f50245bce9e92372c23fc8e1332caead
--- /dev/null
+++ b/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_avs2_api.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MESON_SC2_AVS2_API_H
+#define MESON_SC2_AVS2_API_H
+
+#include "meson_sc2_hw.h"
+
+/* 23 vendor reference/reorder slots and one independent background slot. */
+#define MESON_SC2_AVS2_MIN_CAPTURE_BUFFERS 24
+#define MESON_SC2_AVS2_MAX_WIDTH 3840U
+#define MESON_SC2_AVS2_MAX_HEIGHT 2160U
+
+/* One complete start-code-delimited access unit, including any preceding
+ * sequence header. CAPTURE is AMF8/AMF0 FBC, never a DW8 surrogate.
+ * output.destination and output.output_buffer must describe that same object,
+ * or both be NULL for an actual firmware header probe before CAPTURE exists.
+ * The caller keeps each surface alive while surface_busy() returns true.
+ */
+struct meson_sc2_avs2_job {
+	const void *data;
+	size_t size;
+	u64 timestamp;
+	struct meson_sc2_hevc_job output;
+};
+
+struct meson_sc2_avs2_result {
+	struct meson_sc2_surface *surface;
+	u64 timestamp;
+	u32 width;
+	u32 height;
+	u8 depth;
+	s32 poc;
+	bool hidden;
+};
+
+/* -EPIPE reports parsed dimensions/depth in result without writing CAPTURE.
+ * NULL-destination probes and mismatched allocations stop before DPB mutation;
+ * the caller retains and replays the same access unit after reconfiguration.
+ * -EAGAIN means the supplied destination is still retained by the DPB.
+ * Successful decode does not imply display readiness: call dequeue separately.
+ */
+int meson_sc2_avs2_decode(struct meson_sc2_hevc_context *context,
+			const struct meson_sc2_avs2_job *job,
+			struct meson_sc2_avs2_result *result);
+/* Returns -EAGAIN when no output is ready. drain presents remaining reordered
+ * pictures for DECODER_CMD_STOP without retiring reference/background state;
+ * DECODER_CMD_START may resume dependent access units. STREAMOFF resets DPB.
+ */
+int meson_sc2_avs2_dequeue(struct meson_sc2_hevc_context *context, bool drain,
+			 struct meson_sc2_avs2_result *result);
+int meson_sc2_avs2_put_output(struct meson_sc2_hevc_context *context,
+			    struct meson_sc2_surface *surface);
+bool meson_sc2_avs2_surface_busy(struct meson_sc2_hevc_context *context,
+			       struct meson_sc2_surface *surface);
+
+#endif
diff --git a/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_avs2_bufmgr.c b/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_avs2_bufmgr.c
new file mode 100644
index 0000000000000000000000000000000000000000..a9f159871bf0d370f152553737a678b7633f2cad
--- /dev/null
+++ b/drivers/media/platform/amlogic/meson-sc2-vdec/meson_sc2_avs2_bufmgr.c
@@ -0,0 +1,832 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * AVS2 DPB/RPS management, ported from Amlogic avs2_bufmgr.c (2017).
+ * Copyright (C) 2017 Amlogic, Inc. All rights reserved.
+ *
+ * The firmware supplies expanded RPS and picture syntax in param_u. DMA,
+ * firmware loading and presentation belong to the native hardware backend.
+ */
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/limits.h>
+#include <linux/string.h>
+
+#include "meson_sc2_avs2_global.h"
+
+static int avs2_error(struct avs2_decoder *dec, int error)
+{
+	dec->error = error;
+	dec->bufmgr_error_flag = 1;
+	return error;
+}
+
+void init_frame_t(struct avs2_frame_s *frame)
+{
+	memset(frame, 0, sizeof(*frame));
+	frame->imgcoi_ref = -257;
+	frame->imgtr_fwRefDistance = -256;
+	frame->is_output = -1;
+	frame->referred_by_others = -1;
+	frame->temporal_id = -1;
+	frame->mv_buf_index = -1;
+}
+
+s32 avs2_init_global_buffers(struct avs2_decoder *dec)
+{
+	int i;
+
+	if (dec->ref_maxbuffer < 2 || dec->ref_maxbuffer > REF_MAXBUFFER)
+		return avs2_error(dec, -EINVAL);
+	dec->img.buf_cycle = (dec->input.buf_cycle + 1) * 2;
+	for (i = 0; i < REF_MAXBUFFER; i++) {
+		dec->fref[i] = &dec->frm_pool[i];
+		init_frame_t(dec->fref[i]);
+		dec->fref[i]->index = i;
+	}
+	dec->m_bg = &dec->frm_pool[REF_MAXBUFFER];
+	init_frame_t(dec->m_bg);
+	dec->m_bg->index = REF_MAXBUFFER;
+	dec->f_bg = NULL;
+	return 0;
+}
+
+void init_avs2_decoder(struct avs2_decoder *dec)
+{
+	int i;
+
+	memset(dec, 0, sizeof(*dec));
+	dec->ref_maxbuffer = REF_MAXBUFFER;
+	dec->to_prepare_disp_count = 1;
+	dec->img.type = I_IMG;
+	dec->img.new_sequence_flag = 1;
+	dec->hd.last_output = -1;
+	dec->hd.end_SeqTr = -1;
+	for (i = 0; i < NUM_ALF_COMPONENT; i++) {
+		dec->m_alfPictureParam[i].num_coeff = ALF_MAX_NUM_COEF;
+		dec->m_alfPictureParam[i].filters_per_group = 3;
+		dec->m_alfPictureParam[i].componentID = i;
+	}
+}
+
+static int validate_picture(struct avs2_decoder *dec, s32 code)
+{
+	const union param_u *p = &dec->param;
+	int i;
+
+	/* Bound every firmware-controlled index before parsing or shifting. */
+	if (!p->p.horizontal_size || !p->p.vertical_size ||
+	    p->p.horizontal_size > 8192 || p->p.vertical_size > 8192 ||
+	    p->p.chroma_format != 1 || p->p.lcu_size < 4 ||
+	    p->p.lcu_size > 6 || p->p.g_uiMaxSizeInBit < 4 ||
+	    p->p.g_uiMaxSizeInBit > 6 || p->p.coding_order > 255 ||
+	    p->p.num_of_ref_cur > MAXREF || p->p.num_to_remove_cur > MAXREF ||
+	    p->p.num_of_RPS > MAXGOP ||
+	    (p->p.predict && p->p.RPS_idx >= MAXGOP) ||
+	    p->p.cur_layer > 7 || p->p.picture_reorder_delay > 255 ||
+	    p->p.displaydelay > 255 || p->p.sample_precision < 1 ||
+	    p->p.sample_precision > 2)
+		return avs2_error(dec, -EINVAL);
+	if (p->p.profile_id != BASELINE_PROFILE &&
+	    p->p.profile_id != BASELINE_PICTURE_PROFILE &&
+	    p->p.profile_id != BASELINE10_PROFILE &&
+	    p->p.profile_id != SCENE_PROFILE && p->p.profile_id != SCENE10_PROFILE)
+		return avs2_error(dec, -EOPNOTSUPP);
+	if ((p->p.profile_id == BASELINE10_PROFILE ||
+	     p->p.profile_id == SCENE10_PROFILE) &&
+	    (p->p.encoding_precision < 1 || p->p.encoding_precision > 2))
+		return avs2_error(dec, -EINVAL);
+	if (code == PB_PICTURE_START_CODE &&
+	    (p->p.picture_coding_type < 1 || p->p.picture_coding_type > 3))
+		return avs2_error(dec, -EINVAL);
+	for (i = 0; i < p->p.num_of_ref_cur; i++)
+		if (!p->p.ref_pic_cur[i] || p->p.ref_pic_cur[i] > 255)
+			return avs2_error(dec, -EINVAL);
+	for (i = 0; i < p->p.num_to_remove_cur; i++)
+		if (!p->p.remove_pic_cur[i] || p->p.remove_pic_cur[i] > 255)
+			return avs2_error(dec, -EINVAL);
+	return 0;
+}
+
+static int read_alf_coeff(struct avs2_decoder *dec, struct ALFParam_s *alf)
+{
+	const union param_u *p = &dec->param;
+	int group, pos, symbol, previous = 0;
+
+	memset(alf->filterPattern, 0, sizeof(alf->filterPattern));
+	if (alf->componentID == ALF_Y) {
+		if (p->alf.alf_filters_num_m_1 >= NO_VAR_BINS)
+			return avs2_error(dec, -EINVAL);
+		alf->filters_per_group = p->alf.alf_filters_num_m_1 + 1;
+	} else {
+		alf->filters_per_group = 1;
+	}
+	for (group = 0; group < alf->filters_per_group; group++) {
+		if (group) {
+			symbol = alf->filters_per_group == NO_VAR_BINS ? 1 :
+				 p->alf.region_distance[group - 1];
+			if (symbol < 1 || symbol >= NO_VAR_BINS - previous)
+				return avs2_error(dec, -EINVAL);
+			previous += symbol;
+			alf->filterPattern[previous] = 1;
+		}
+		for (pos = 0; pos < ALF_MAX_NUM_COEF; pos++) {
+			s16 coeff;
+
+			switch (alf->componentID) {
+			case ALF_Y:
+				coeff = (s16)p->alf.alf_y_coeffmulti[group][pos];
+				break;
+			case ALF_Cb:
+				coeff = (s16)p->alf.alf_cb_coeffmulti[pos];
+				break;
+			case ALF_Cr:
+				coeff = (s16)p->alf.alf_cr_coeffmulti[pos];
+				break;
+			default:
+				return avs2_error(dec, -EINVAL);
+			}
+			if ((pos < 8 && (coeff < -64 || coeff > 63)) ||
+			    (pos == 8 && (coeff < -1088 || coeff > 1071)))
+				return avs2_error(dec, -EINVAL);
+			alf->coeffmulti[group][pos] = coeff;
+		}
+	}
+	return 0;
+}
+
+static int read_alf(struct avs2_decoder *dec)
+{
+	const union param_u *p = &dec->param;
+	int enabled[NUM_ALF_COMPONENT] = {
+		p->alf.picture_alf_enable_Y,
+		p->alf.picture_alf_enable_Cb,
+		p->alf.picture_alf_enable_Cr,
+	};
+	int i;
+
+	for (i = 0; i < NUM_ALF_COMPONENT; i++) {
+		if (dec->input.alf_enable && enabled[i] > 1)
+			return avs2_error(dec, -EINVAL);
+		dec->img.pic_alf_on[i] = dec->input.alf_enable && enabled[i];
+		dec->m_alfPictureParam[i].alf_flag = dec->img.pic_alf_on[i];
+		if (dec->img.pic_alf_on[i] &&
+		    read_alf_coeff(dec, &dec->m_alfPictureParam[i]))
+			return dec->error;
+	}
+	return 0;
+}
+
+static void read_sequence(struct avs2_decoder *dec)
+{
+	const union param_u *p = &dec->param;
+	struct inp_par *input = &dec->input;
+	struct ImageParameters_s *img = &dec->img;
+	struct Video_Dec_data_s *hd = &dec->hd;
+	u16 flags = p->p.avs2_seq_flags;
+
+	input->profile_id = p->p.profile_id;
+	input->level_id = p->p.level_id;
+	hd->progressive_sequence = p->p.progressive_sequence;
+	hd->is_field_sequence = p->p.is_field_sequence;
+	img->is_field_sequence = hd->is_field_sequence;
+	hd->horizontal_size = p->p.horizontal_size;
+	hd->vertical_size = p->p.vertical_size;
+	input->chroma_format = p->p.chroma_format;
+	input->output_bit_depth = 8;
+	input->sample_bit_depth = 8;
+	hd->sample_precision = p->p.sample_precision;
+	if (input->profile_id == BASELINE10_PROFILE ||
+	    input->profile_id == SCENE10_PROFILE) {
+		input->output_bit_depth = 6 + p->p.sample_precision * 2;
+		input->sample_bit_depth = 6 + p->p.encoding_precision * 2;
+	}
+	hd->aspect_ratio_information = p->p.aspect_ratio_information;
+	hd->frame_rate_code = p->p.frame_rate_code;
+	hd->bit_rate_lower = p->p.bit_rate_lower;
+	hd->bit_rate_upper = p->p.bit_rate_upper;
+	hd->low_delay = p->p.low_delay;
+	hd->temporal_id_exist_flag = p->p.temporal_id_exist_flag;
+	input->g_uiMaxSizeInBit = p->p.g_uiMaxSizeInBit;
+	hd->background_picture_enable = !(flags & BIT(BACKGROUND_PICTURE_DISABLE_BIT));
+	hd->b_dmh_enabled = 1;
+	hd->b_mhpskip_enabled = !!(flags & BIT(B_MHPSKIP_ENABLED_BIT));
+	hd->dhp_enabled = !!(flags & BIT(DHP_ENABLED_BIT));
+	hd->wsm_enabled = !!(flags & BIT(WSM_ENABLED_BIT));
+	img->inter_amp_enable = !!(flags & BIT(INTER_AMP_ENABLE_BIT));
+	input->useNSQT = !!(flags & BIT(USENSQT_BIT));
+	input->useSDIP = !!(flags & BIT(USESDIP_BIT));
+	hd->b_secT_enabled = !!(flags & BIT(B_SECT_ENABLED_BIT));
+	input->sao_enable = !!(flags & BIT(SAO_ENABLE_BIT));
+	input->alf_enable = !!(flags & BIT(ALF_ENABLE_BIT));
+	hd->b_pmvr_enabled = !!(flags & BIT(B_PMVR_ENABLED_BIT));
+	hd->gop_size = p->p.num_of_RPS;
+	hd->picture_reorder_delay = hd->low_delay ? 0 : p->p.picture_reorder_delay;
+	input->crossSliceLoopFilter = !!(flags & BIT(CROSSSLICELOOPFILTER_BIT));
+	input->alpha_c_offset = (s16)p->p.alpha_c_offset;
+	input->beta_offset = (s16)p->p.beta_offset;
+	hd->chroma_quant_param_delta_u = (s16)p->p.chroma_quant_param_delta_cb;
+	hd->chroma_quant_param_delta_v = (s16)p->p.chroma_quant_param_delta_cr;
+	hd->loop_filter_disable = p->p.loop_filter_disable;
+	img->width = hd->horizontal_size;
+	img->height = hd->vertical_size;
+	img->width_cr = img->width >> 1;
+	img->height_cr = img->height >> 1;
+	img->PicWidthInMbs = img->width / MIN_CU_SIZE;
+	img->PicHeightInMbs = img->height / MIN_CU_SIZE;
+	img->PicSizeInMbs = img->PicWidthInMbs * img->PicHeightInMbs;
+	img->max_mb_nr = img->PicSizeInMbs;
+	img->buf_cycle = input->buf_cycle + 1;
+	dec->lcu_size = 1 << p->p.lcu_size;
+	dec->hc.seq_header++;
+}
+
+static void read_picture(struct avs2_decoder *dec, s32 code)
+{
+	const union param_u *p = &dec->param;
+	struct ImageParameters_s *img = &dec->img;
+	struct Video_Dec_data_s *hd = &dec->hd;
+	struct reference_management *rps = &hd->curr_RPS;
+	int i;
+
+	img->typeb = 0;
+	hd->background_picture_flag = 0;
+	hd->background_picture_output_flag = 0;
+	hd->background_reference_enable = 0;
+	hd->background_pred_flag = 0;
+	if (code == I_PICTURE_START_CODE) {
+		img->type = I_IMG;
+		hd->time_code_flag = p->p.time_code_flag;
+		if (hd->time_code_flag)
+			hd->time_code = p->p.time_code;
+		if (hd->background_picture_enable) {
+			hd->background_picture_flag = p->p.background_picture_flag;
+			if (hd->background_picture_flag) {
+				img->typeb = BACKGROUND_IMG;
+				hd->background_picture_output_flag =
+					p->p.background_picture_output_flag;
+			}
+		}
+	} else {
+		hd->picture_coding_type = p->p.picture_coding_type;
+		img->type = hd->picture_coding_type == 1 ? P_IMG :
+			    hd->picture_coding_type == 3 ? F_IMG : B_IMG;
+		if (hd->background_picture_enable && img->type != B_IMG) {
+			if (img->type == P_IMG)
+				hd->background_pred_flag = p->p.background_pred_flag;
+			hd->background_reference_enable = hd->background_pred_flag ?
+				1 : p->p.background_reference_enable;
+		}
+		if (hd->background_pred_flag)
+			img->typeb = BP_IMG;
+		img->random_access_decodable_flag = p->p.random_access_decodable_flag;
+	}
+	img->coding_order = p->p.coding_order;
+	hd->cur_layer = hd->temporal_id_exist_flag ? p->p.cur_layer : 0;
+	hd->displaydelay = hd->low_delay ? 0 : p->p.displaydelay;
+	/* Non-output GB pictures do not signal an output delay. */
+	if (img->typeb == BACKGROUND_IMG && !hd->background_picture_output_flag)
+		hd->displaydelay = 0;
+	/* Firmware expands both explicit and sequence-predicted RPS into RPM. */
+	memset(rps, 0, sizeof(*rps));
+	rps->predict = p->p.predict;
+	rps->referred_by_others = p->p.referred_by_others_cur;
+	rps->num_of_ref = p->p.num_of_ref_cur;
+	rps->num_to_remove = p->p.num_to_remove_cur;
+	for (i = 0; i < rps->num_of_ref; i++)
+		rps->ref_pic[i] = p->p.ref_pic_cur[i];
+	for (i = 0; i < rps->num_to_remove; i++)
+		rps->remove_pic[i] = p->p.remove_pic_cur[i];
+	hd->progressive_frame = p->p.progressive_frame;
+	img->progressive_frame = hd->progressive_frame;
+	img->picture_structure = hd->progressive_frame ? 1 : p->p.picture_structure;
+	hd->top_field_first = p->p.top_field_first;
+	hd->repeat_first_field = p->p.repeat_first_field;
+	hd->is_top_field = hd->is_field_sequence ? p->p.is_top_field : 0;
+	img->is_top_field = hd->is_top_field;
+	img->qp = hd->picture_qp;
+}
+
+static void calc_picture_distance(struct avs2_decoder *dec)
+{
+	struct ImageParameters_s *img = &dec->img;
+	struct Video_Dec_data_s *hd = &dec->hd;
+	int i, j;
+
+	if (img->coding_order < img->PrevPicDistanceLsb) {
+		dec->hc.total_frames++;
+		for (i = 0; i < dec->ref_maxbuffer; i++) {
+			struct avs2_frame_s *frame = dec->fref[i];
+
+			if (frame->imgtr_fwRefDistance >= 0) {
+				frame->imgtr_fwRefDistance -= 256;
+				frame->imgcoi_ref -= 256;
+			}
+			for (j = 0; j < MAXREF; j++)
+				frame->ref_poc[j] -= 256;
+		}
+		for (i = 0; i < dec->outprint.buffer_num; i++) {
+			dec->outprint.stdoutdata[i].framenum -= 256;
+			dec->outprint.stdoutdata[i].tr -= 256;
+		}
+		hd->last_output -= 256;
+		hd->curr_IDRtr -= 256;
+		hd->curr_IDRcoi -= 256;
+		hd->next_IDRtr -= 256;
+		hd->next_IDRcoi -= 256;
+	}
+	img->tr = img->coding_order;
+	if (!hd->low_delay)
+		img->tr += hd->displaydelay - hd->picture_reorder_delay;
+	img->pic_distance = img->tr;
+	dec->hc.picture_distance = img->pic_distance;
+}
+
+static void reset_unused_buffers(struct avs2_decoder *dec)
+{
+	int i;
+
+	for (i = 0; i < REF_MAXBUFFER; i++) {
+		struct avs2_frame_s *frame = dec->fref[i];
+
+		/* The new sequence no longer references an old background, even
+		 * when presentation still pins its allocation.
+		 */
+		frame->bg_flag = 0;
+		if (frame->vf_ref || frame->to_prepare_disp)
+			continue;
+		frame->imgcoi_ref = -257;
+		frame->imgtr_fwRefDistance = -256;
+		frame->is_output = -1;
+		frame->referred_by_others = -1;
+		memset(frame->ref_poc, 0, sizeof(frame->ref_poc));
+	}
+	dec->f_bg = NULL;
+	dec->m_bg->imgcoi_ref = -257;
+	dec->m_bg->imgtr_fwRefDistance = -256;
+	dec->m_bg->is_output = -1;
+	dec->m_bg->referred_by_others = -1;
+	dec->m_bg->bg_flag = 0;
+	memset(dec->m_bg->ref_poc, 0, sizeof(dec->m_bg->ref_poc));
+}
+
+void avs2_prepare_header(struct avs2_decoder *dec, s32 start_code)
+{
+	struct ImageParameters_s *img = &dec->img;
+	struct Video_Dec_data_s *hd = &dec->hd;
+
+	dec->error = 0;
+	dec->bufmgr_error_flag = 0;
+	if (dec->ref_maxbuffer < 2 || dec->ref_maxbuffer > REF_MAXBUFFER ||
+	    !dec->fref[0] || !dec->m_bg || dec->outprint.buffer_num < 0 ||
+	    dec->outprint.buffer_num > REF_MAXBUFFER) {
+		avs2_error(dec, -EINVAL);
+		return;
+	}
+	switch (start_code) {
+	case SEQUENCE_HEADER_CODE:
+		img->new_sequence_flag = 1;
+		if (hd->vec_flag || img->sequence_end_flag) {
+			if (avs2_flush_dpb(dec))
+				return;
+			hd->vec_flag = 0;
+			reset_unused_buffers(dec);
+			img->number = 0;
+			img->PrevPicDistanceLsb = 0;
+			dec->init_hw_flag = 0;
+		}
+		img->seq_header_indicate = 1;
+		break;
+	case I_PICTURE_START_CODE:
+	case PB_PICTURE_START_CODE:
+		if (validate_picture(dec, start_code))
+			return;
+		read_sequence(dec);
+		read_picture(dec, start_code);
+		if (read_alf(dec))
+			return;
+		calc_picture_distance(dec);
+		if (!img->seq_header_indicate) {
+			img->B_discard_flag = 1;
+			avs2_error(dec, -EILSEQ);
+			return;
+		}
+		if (start_code == PB_PICTURE_START_CODE && img->type != B_IMG)
+			img->B_discard_flag = 0;
+		if (img->type == B_IMG && img->B_discard_flag &&
+		    !img->random_access_decodable_flag)
+			avs2_error(dec, -EILSEQ);
+		break;
+	case SEQUENCE_END_CODE:
+		img->new_sequence_flag = 1;
+		img->sequence_end_flag = 1;
+		break;
+	case VIDEO_EDIT_CODE:
+		hd->vec_flag = 1;
+		break;
+	}
+}
+
+static int prepare_reference_info(struct avs2_decoder *dec)
+{
+	struct ImageParameters_s *img = &dec->img;
+	struct Video_Dec_data_s *hd = &dec->hd;
+	struct avs2_frame_s *frame;
+	int i, j;
+
+	if (img->tr > hd->next_IDRtr && hd->curr_IDRtr != hd->next_IDRtr) {
+		hd->curr_IDRtr = hd->next_IDRtr;
+		hd->curr_IDRcoi = hd->next_IDRcoi;
+	}
+	img->num_of_references = hd->curr_RPS.num_of_ref;
+	if (img->num_of_references > MAXREF ||
+	    img->num_of_references >= dec->ref_maxbuffer)
+		return avs2_error(dec, -EINVAL);
+	for (i = 0; i < img->num_of_references; i++) {
+		for (j = i; j < dec->ref_maxbuffer; j++)
+			if (dec->fref[j]->imgcoi_ref ==
+			    (s32)img->coding_order - hd->curr_RPS.ref_pic[i])
+				break;
+		if (j == dec->ref_maxbuffer)
+			return avs2_error(dec, -ENOENT);
+		frame = dec->fref[i];
+		dec->fref[i] = dec->fref[j];
+		dec->fref[j] = frame;
+	}
+	if (img->type == B_IMG &&
+	    (img->num_of_references != 2 ||
+	     dec->fref[0]->imgtr_fwRefDistance <= img->tr ||
+	     dec->fref[1]->imgtr_fwRefDistance >= img->tr))
+		return avs2_error(dec, -EILSEQ);
+	if (hd->background_reference_enable && !dec->f_bg)
+		return avs2_error(dec, -ENOENT);
+	/* A reference, background, queued or displayed surface is never reused. */
+	for (i = img->num_of_references; i < dec->ref_maxbuffer; i++) {
+		frame = dec->fref[i];
+		if ((frame->imgcoi_ref < -256 ||
+		     abs(frame->imgtr_fwRefDistance - img->tr) >= 128) &&
+		    frame->is_output == -1 && !frame->bg_flag &&
+		    !frame->vf_ref && !frame->to_prepare_disp)
+			break;
+	}
+	if (i == dec->ref_maxbuffer)
+		return avs2_error(dec, -ENOBUFS);
+	frame = dec->fref[i];
+	dec->hc.f_rec = frame;
+	dec->hc.cur_pic = frame;
+	frame->imgtr_fwRefDistance = img->tr;
+	frame->imgcoi_ref = img->coding_order;
+	frame->temporal_id = hd->cur_layer;
+	frame->is_output = 1;
+	frame->error_mark = 0;
+	frame->decoded_lcu = 0;
+	frame->slice_type = img->type;
+	frame->referred_by_others = hd->curr_RPS.referred_by_others;
+	memset(frame->ref_poc, 0, sizeof(frame->ref_poc));
+	for (j = 0; j < img->num_of_references; j++)
+		frame->ref_poc[j] = dec->fref[j]->imgtr_fwRefDistance;
+	if (img->type == B_IMG) {
+		frame->ref_poc[0] = dec->fref[1]->imgtr_fwRefDistance;
+		frame->ref_poc[1] = dec->fref[0]->imgtr_fwRefDistance;
+	} else if (img->type == I_IMG) {
+		for (j = 0; j < 4; j++)
+			frame->ref_poc[j] = img->tr;
+	}
+	if (img->type != I_IMG) {
+		img->imgtr_next_P = img->type == B_IMG ?
+			dec->fref[0]->imgtr_fwRefDistance : img->tr;
+		if (img->type == B_IMG) {
+			hd->trtmp = dec->fref[0]->imgtr_fwRefDistance;
+			dec->fref[0]->imgtr_fwRefDistance =
+				dec->fref[1]->imgtr_fwRefDistance;
+		}
+	}
+	return 0;
+}
+
+s32 avs2_process_header(struct avs2_decoder *dec)
+{
+	struct ImageParameters_s *img = &dec->img;
+	struct Video_Dec_data_s *hd = &dec->hd;
+
+	if (dec->error)
+		return dec->error;
+	if (!dec->lcu_size || !hd->horizontal_size || !hd->vertical_size ||
+	    dec->ref_maxbuffer < 2 || dec->ref_maxbuffer > REF_MAXBUFFER ||
+	    !dec->m_bg || !dec->fref[0])
+		return avs2_error(dec, -EINVAL);
+	img->auto_crop_right = ALIGN(hd->horizontal_size, MIN_CU_SIZE) - hd->horizontal_size;
+	img->auto_crop_bottom = ALIGN(hd->vertical_size, MIN_CU_SIZE) - hd->vertical_size;
+	img->width = hd->horizontal_size + img->auto_crop_right;
+	img->height = hd->vertical_size + img->auto_crop_bottom;
+	img->width_cr = img->width >> 1;
+	img->height_cr = img->height >> 1;
+	img->PicWidthInMbs = img->width / MIN_CU_SIZE;
+	img->PicHeightInMbs = img->height / MIN_CU_SIZE;
+	img->PicSizeInMbs = img->PicWidthInMbs * img->PicHeightInMbs;
+	img->max_mb_nr = img->PicSizeInMbs;
+	if (img->new_sequence_flag && img->sequence_end_flag) {
+		hd->end_SeqTr = img->tr;
+		img->sequence_end_flag = 0;
+	}
+	if (img->new_sequence_flag) {
+		hd->next_IDRtr = img->tr;
+		hd->next_IDRcoi = img->coding_order;
+		img->new_sequence_flag = 0;
+	}
+	img->current_mb_nr = 0;
+	if (img->typeb == BACKGROUND_IMG && !hd->background_picture_output_flag) {
+		img->num_of_references = 0;
+		dec->hc.cur_pic = dec->m_bg;
+		dec->m_bg->imgtr_fwRefDistance = img->tr;
+		dec->m_bg->imgcoi_ref = img->coding_order;
+		dec->m_bg->slice_type = img->type;
+		dec->m_bg->error_mark = 0;
+		dec->m_bg->decoded_lcu = 0;
+	} else if (prepare_reference_info(dec)) {
+		return dec->error;
+	}
+	if (img->typeb == BACKGROUND_IMG && img->is_field_sequence)
+		dec->bk_img_is_top_field = img->is_top_field;
+	img->types = img->type;
+	if (img->type != B_IMG) {
+		hd->pre_img_type = img->type;
+		hd->pre_img_types = img->types;
+	}
+	dec->lcu_size_log2 = dec->param.p.lcu_size;
+	dec->lcu_x_num = DIV_ROUND_UP(img->width, dec->lcu_size);
+	dec->lcu_y_num = DIV_ROUND_UP(img->height, dec->lcu_size);
+	dec->lcu_total = dec->lcu_x_num * dec->lcu_y_num;
+	dec->hc.cur_pic->lcu_size_log2 = dec->lcu_size_log2;
+	dec->hc.cur_pic->lcu_total = dec->lcu_total;
+	dec->hc.cur_pic->pic_w = hd->horizontal_size;
+	dec->hc.cur_pic->pic_h = hd->vertical_size;
+	dec->hc.cur_pic->bit_depth = dec->input.sample_bit_depth;
+	return SOP;
+}
+
+/* Preserve ordering without overflowing the vendor's signed display serial. */
+static void compact_display_serials(struct avs2_decoder *dec)
+{
+	int i, previous = 0, rank = 1;
+
+	for (;;) {
+		struct avs2_frame_s *next = NULL;
+
+		for (i = 0; i < REF_MAXBUFFER; i++) {
+			struct avs2_frame_s *frame = dec->fref[i];
+
+			if (frame->to_prepare_disp > previous &&
+			    (!next || frame->to_prepare_disp < next->to_prepare_disp))
+				next = frame;
+		}
+		if (!next)
+			break;
+		previous = next->to_prepare_disp;
+		next->to_prepare_disp = rank++;
+	}
+	dec->to_prepare_disp_count = rank;
+}
+
+int write_frame(struct avs2_decoder *dec, s32 poc)
+{
+	struct avs2_frame_s *frame = NULL;
+	int i, ret;
+
+	for (i = 0; i < dec->ref_maxbuffer; i++)
+		if (dec->fref[i]->imgtr_fwRefDistance == poc &&
+		    dec->fref[i]->is_output == 1) {
+			frame = dec->fref[i];
+			break;
+		}
+	if (!frame)
+		return avs2_error(dec, -ENOENT);
+	frame->imgtr_fwRefDistance_bak = poc;
+	if (dec->write_frame) {
+		ret = dec->write_frame(dec, frame);
+		if (ret)
+			return avs2_error(dec, ret);
+	}
+	if (dec->to_prepare_disp_count == INT_MAX)
+		compact_display_serials(dec);
+	frame->is_output = -1;
+	frame->to_prepare_disp = dec->to_prepare_disp_count++;
+	if (!frame->referred_by_others || frame->imgcoi_ref == -257) {
+		frame->imgtr_fwRefDistance = -256;
+		frame->imgcoi_ref = -257;
+		frame->temporal_id = -1;
+	}
+	return 0;
+}
+
+int report_frame(struct avs2_decoder *dec, struct outdata_s *data, s32 pos)
+{
+	struct STDOUT_DATA_s *entry;
+	s64 absolute_poc;
+	int ret;
+
+	if (pos < 0 || pos >= data->buffer_num)
+		return avs2_error(dec, -EINVAL);
+	entry = &data->stdoutdata[pos];
+	if (dec->report_frame) {
+		ret = dec->report_frame(dec, data, pos);
+		if (ret)
+			return avs2_error(dec, ret);
+	}
+	absolute_poc = entry->tr + (s64)dec->hc.total_frames * 256;
+	if (absolute_poc == dec->hd.end_SeqTr)
+		dec->img.sequence_end_flag = 0;
+	if (absolute_poc == dec->hd.next_IDRtr)
+		dec->hd.vec_flag = 0;
+	dec->hd.FrameNum++;
+	return 0;
+}
+
+static int output_frame(struct avs2_decoder *dec, int pos)
+{
+	struct outdata_s *data = &dec->outprint;
+	struct STDOUT_DATA_s *entry = &data->stdoutdata[pos];
+	int ret;
+
+	ret = report_frame(dec, data, pos);
+	if (ret)
+		return ret;
+	if (entry->typeb != BACKGROUND_IMG || entry->background_picture_output_flag) {
+		ret = write_frame(dec, entry->tr);
+		if (ret)
+			return ret;
+	}
+	dec->hd.last_output = entry->tr;
+	memmove(entry, entry + 1, (data->buffer_num - pos - 1) * sizeof(*entry));
+	data->buffer_num--;
+	return 0;
+}
+
+int avs2_drain_output(struct avs2_decoder *dec)
+{
+	int i, pos;
+
+	if (dec->outprint.buffer_num < 0 || dec->outprint.buffer_num > REF_MAXBUFFER ||
+	    dec->ref_maxbuffer < 2 || dec->ref_maxbuffer > REF_MAXBUFFER ||
+	    !dec->fref[0] || !dec->m_bg)
+		return avs2_error(dec, -EINVAL);
+	while (dec->outprint.buffer_num) {
+		pos = 0;
+		for (i = 1; i < dec->outprint.buffer_num; i++)
+			if (dec->outprint.stdoutdata[i].tr < dec->outprint.stdoutdata[pos].tr)
+				pos = i;
+		if (output_frame(dec, pos))
+			return dec->error;
+	}
+	return 0;
+}
+
+int avs2_flush_dpb(struct avs2_decoder *dec)
+{
+	int i, ret;
+
+	ret = avs2_drain_output(dec);
+	if (ret)
+		return ret;
+	for (i = 0; i < REF_MAXBUFFER; i++) {
+		dec->fref[i]->imgtr_fwRefDistance = -256;
+		dec->fref[i]->imgcoi_ref = -257;
+		dec->fref[i]->temporal_id = -1;
+		dec->fref[i]->referred_by_others = 0;
+		dec->fref[i]->bg_flag = 0;
+	}
+	/* Flush ends codec ownership, not outstanding presentation ownership. */
+	dec->m_bg->imgtr_fwRefDistance = -256;
+	dec->m_bg->imgcoi_ref = -257;
+	dec->m_bg->temporal_id = -1;
+	dec->m_bg->referred_by_others = 0;
+	dec->m_bg->bg_flag = 0;
+	dec->f_bg = NULL;
+	dec->hc.cur_pic = NULL;
+	dec->hc.f_rec = NULL;
+	return 0;
+}
+
+static void reference_list_info(struct avs2_decoder *dec)
+{
+	char *str = dec->hc.str_list_reference;
+	struct avs2_frame_s *frame = dec->hc.cur_pic;
+	int i, len = 0;
+
+	str[0] = '\0';
+	if (!dec->img.num_of_references)
+		return;
+	len += scnprintf(str + len, sizeof(dec->hc.str_list_reference) - len, "[");
+	for (i = 0; i < dec->img.num_of_references; i++) {
+		int index = dec->img.type == B_IMG ? dec->img.num_of_references - 1 - i : i;
+
+		len += scnprintf(str + len, sizeof(dec->hc.str_list_reference) - len,
+				 "%4d ", frame->ref_poc[index]);
+	}
+	scnprintf(str + len, sizeof(dec->hc.str_list_reference) - len, "]");
+}
+
+static int frame_postprocessing(struct avs2_decoder *dec)
+{
+	struct outdata_s *data = &dec->outprint;
+	struct ImageParameters_s *img = &dec->img;
+	struct Video_Dec_data_s *hd = &dec->hd;
+	struct STDOUT_DATA_s *entry;
+	bool output_current = false;
+	int i, j, searches, minimum, pos, last = -1;
+
+	if (data->buffer_num < 0 || data->buffer_num >= REF_MAXBUFFER)
+		return avs2_error(dec, -ENOSPC);
+	img->PrevPicDistanceLsb = img->coding_order % 256;
+	entry = &data->stdoutdata[data->buffer_num++];
+	memset(entry, 0, sizeof(*entry));
+	entry->type = img->type;
+	entry->typeb = img->typeb;
+	entry->framenum = img->tr;
+	entry->tr = img->tr;
+	entry->tmp_time = hd->tmp_time;
+	entry->picture_structure = img->picture_structure;
+	entry->background_picture_output_flag = hd->background_picture_output_flag;
+	entry->picture_reorder_delay = hd->picture_reorder_delay;
+	strscpy(entry->str_reference_list, dec->hc.str_list_reference,
+		sizeof(entry->str_reference_list));
+	searches = data->buffer_num;
+	for (j = 0; j < searches; j++) {
+		pos = -1;
+		minimum = INT_MAX;
+		for (i = 0; i < data->buffer_num; i++) {
+			entry = &data->stdoutdata[i];
+			if (entry->tr < minimum &&
+			    entry->tr + entry->picture_reorder_delay <= (s32)img->coding_order) {
+				pos = i;
+				minimum = entry->tr;
+			}
+		}
+		/* The zero-delay current picture bypasses older delayed pictures. */
+		if (!hd->displaydelay && !output_current && img->tr <= minimum) {
+			for (i = 0; i < data->buffer_num; i++)
+				if (data->stdoutdata[i].tr == img->tr &&
+				    data->stdoutdata[i].typeb == img->typeb) {
+					pos = i;
+					output_current = true;
+					break;
+				}
+		}
+		if (pos < 0)
+			break;
+		if (output_frame(dec, pos))
+			return dec->error;
+		last = pos;
+	}
+	return last;
+}
+
+int avs2_post_process(struct avs2_decoder *dec)
+{
+	struct ImageParameters_s *img = &dec->img;
+	struct Video_Dec_data_s *hd = &dec->hd;
+	int i, j, ret;
+
+	if (dec->error)
+		return dec->error;
+	if (!dec->hc.cur_pic || img->num_of_references < 0 ||
+	    img->num_of_references > MAXREF || hd->curr_RPS.num_to_remove < 0 ||
+	    hd->curr_RPS.num_to_remove > MAXREF)
+		return avs2_error(dec, -EINVAL);
+	if (img->typeb == BACKGROUND_IMG && hd->background_picture_enable) {
+		for (i = 0; i < dec->ref_maxbuffer; i++)
+			dec->fref[i]->bg_flag = 0;
+		dec->m_bg->bg_flag = 0;
+		dec->f_bg = dec->hc.cur_pic;
+		dec->f_bg->bg_flag = 1;
+	}
+	if (img->typeb == BACKGROUND_IMG && !hd->background_picture_output_flag)
+		hd->background_number++;
+	if (img->type == B_IMG)
+		dec->fref[0]->imgtr_fwRefDistance = hd->trtmp;
+	reference_list_info(dec);
+	ret = frame_postprocessing(dec);
+	if (dec->error)
+		return dec->error;
+	/* RPS removal happens after output; displayed/queued surfaces stay pinned. */
+	for (i = 0; i < hd->curr_RPS.num_to_remove; i++) {
+		for (j = 0; j < dec->ref_maxbuffer; j++) {
+			struct avs2_frame_s *frame = dec->fref[j];
+
+			if (frame->imgcoi_ref < -256 || frame->imgcoi_ref !=
+			    (s32)img->coding_order - hd->curr_RPS.remove_pic[i])
+				continue;
+			frame->referred_by_others = 0;
+			if (frame->is_output == -1) {
+				frame->imgtr_fwRefDistance = -256;
+				frame->imgcoi_ref = -257;
+				frame->temporal_id = -1;
+			}
+			break;
+		}
+	}
+	if (img->type == I_IMG || img->type == P_IMG || img->type == F_IMG)
+		img->number++;
+	else
+		dec->hc.Bframe_ctr++;
+	return ret;
+}
