@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/amlogic,meson-sc2-di.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic SC2 hardware deinterlacer
+
+maintainers:
+  - Linux Media Mailing List <linux-media@vger.kernel.org>
+
+description: |
+  The SC2 DI post engine performs edge-interpolation deinterlacing into
+  memory. It shares the VPU register aperture and power controller with
+  display hardware. The VPU phandle explicitly identifies that supplier;
+  there is no independently reserved overlapping MMIO range or VPU reset.
+  The pre interrupt is described for hardware completeness but unused by
+  the spatial EI implementation. Temporal MA/MC is not exposed.
+  The canvas phandle is also an explicit supplier dependency. Driver
+  removal retains both suppliers until final file and VMA release. A
+  failed DMA drain quarantines ACTIVE buffers and power, blocks new
+  hardware jobs device-wide, and waits for real bus idle before teardown.
+
+properties:
+  compatible:
+    const: amlogic,meson-sc2-di
+  amlogic,vpu:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: SC2 VPU supplier providing VCBUS and PWRCTRL apertures
+  amlogic,canvas:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Canvas allocator for linear NV12 surfaces
+  interrupts:
+    maxItems: 2
+  interrupt-names:
+    items:
+      - const: pre
+      - const: post
+  clocks:
+    maxItems: 4
+  clock-names:
+    items:
+      - const: vpu
+      - const: vapb
+      - const: clkb
+      - const: intr
+  assigned-clocks:
+    maxItems: 2
+  assigned-clock-parents:
+    maxItems: 2
+  assigned-clock-rates:
+    maxItems: 2
+  power-domains:
+    maxItems: 1
+
+required:
+  - compatible
+  - amlogic,vpu
+  - amlogic,canvas
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - power-domains
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/media/amlogic,meson-sc2-vdec.yaml b/Documentation/devicetree/bindings/media/amlogic,meson-sc2-vdec.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..aa0a5976220cf7d13eef58bec865f043df051248
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/amlogic,meson-sc2-vdec.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/amlogic,meson-sc2-vdec.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic SC2 stateful VDEC1 decoder
+
+maintainers:
+  - Linux Media Mailing List <linux-media@vger.kernel.org>
+
+description: |
+  VDEC1 reconstructs H.264, MPEG-1/2 and other legacy elementary streams.
+  Its mailbox and power domain are independent of HEVC, but the DOS
+  aperture, DMC control and secure loader are shared. Drivers must acquire
+  the common SC2 DOS lease before accessing these resources. The HEVC
+  platform device retains the DOS aperture reservation. No global DOS or
+  APB reset is permitted while either decoder is in use.
+  SC2 feeds the VLD FIFO through its software-managed stream write pointer;
+  it does not use the older GX ES parser MMIO, IRQ, clock or reset sequence.
+  Factory secure firmware must have been preloaded by platform userspace.
+
+properties:
+  compatible:
+    const: amlogic,meson-sc2-vdec
+  reg:
+    items:
+      - description: Shared DOS aperture
+      - description: Shared DMC request and idle acknowledgement registers
+  reg-names:
+    items:
+      - const: dos
+      - const: dmc
+  interrupts:
+    maxItems: 1
+  interrupt-names:
+    const: vdec
+  clocks:
+    maxItems: 2
+  clock-names:
+    items:
+      - const: dos
+      - const: vdec_1
+  power-domains:
+    maxItems: 1
+  amlogic,canvas:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Shared canvas LUT provider
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - power-domains
+  - amlogic,canvas
+
+additionalProperties: false
