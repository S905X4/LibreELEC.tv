 #define AVCODEC_V4L2_FMT_H
 
 #include <stdint.h>
+#include <linux/videodev2.h>
 #include "libavutil/pixfmt.h"
 #include "codec_id.h"
+
+/* Local SC2 capture ABI. These formats describe compressed, not CPU-linear data. */
+#ifndef V4L2_PIX_FMT_AMLOGIC_FBC8
+#define V4L2_PIX_FMT_AMLOGIC_FBC8 v4l2_fourcc('A', 'M', 'F', '8')
+#endif
+#ifndef V4L2_PIX_FMT_AMLOGIC_FBC10
+#define V4L2_PIX_FMT_AMLOGIC_FBC10 v4l2_fourcc('A', 'M', 'F', '0')
+#endif
+#ifndef V4L2_PIX_FMT_AVS2
+#define V4L2_PIX_FMT_AVS2 v4l2_fourcc('A', 'V', 'S', '2')
+#endif
+
+static inline int ff_v4l2_format_is_amlogic_fbc(uint32_t fourcc)
+{
+    return fourcc == V4L2_PIX_FMT_AMLOGIC_FBC8 ||
+           fourcc == V4L2_PIX_FMT_AMLOGIC_FBC10;
+}
 
 enum AVPixelFormat ff_v4l2_format_v4l2_to_avfmt(uint32_t v4l2_fmt, enum AVCodecID avcodec);
 uint32_t ff_v4l2_format_avcodec_to_v4l2(enum AVCodecID avcodec);
