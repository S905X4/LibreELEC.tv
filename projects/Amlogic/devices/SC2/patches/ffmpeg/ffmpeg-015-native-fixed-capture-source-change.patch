--- a/libavcodec/v4l2_m2m_dec.c
+++ b/libavcodec/v4l2_m2m_dec.c
@@ -45,6 +45,10 @@
 #include "v4l2_m2m.h"
 #include "v4l2_fmt.h"
 #include "v4l2_req_dmabufs.h"
+#if CONFIG_H264_V4L2M2M_DECODER
+#include "cbs.h"
+#include "cbs_h264.h"
+#endif
 
 #if CONFIG_H264_DECODER
 #include "h264_parse.h"
@@ -529,6 +533,180 @@
     return ff_v4l2_context_enqueue_packet(&s->output, pkt, header, bytes);
 }
 
+#if CONFIG_H264_V4L2M2M_DECODER
+typedef struct V4L2H264FieldIdentity {
+    uint16_t frame_num;
+    uint16_t idr_pic_id;
+    uint8_t pps_id;
+    uint8_t field;
+    uint8_t bottom;
+    uint8_t idr;
+    uint8_t reference;
+} V4L2H264FieldIdentity;
+
+typedef struct V4L2H264FieldPair {
+    CodedBitstreamContext *cbs;
+    CodedBitstreamFragment fragment;
+    AVPacket first;
+    V4L2H264FieldIdentity identity;
+} V4L2H264FieldPair;
+
+static void h264_field_pair_free(V4L2m2mPriv *priv)
+{
+    V4L2H264FieldPair *pair = priv->h264_field_pair;
+
+    if (!pair)
+        return;
+    av_packet_unref(&pair->first);
+    ff_cbs_fragment_free(&pair->fragment);
+    ff_cbs_close(&pair->cbs);
+    av_freep(&priv->h264_field_pair);
+}
+
+static int h264_fields_match(const V4L2H264FieldIdentity *first,
+                             const V4L2H264FieldIdentity *second)
+{
+    /* The second field of an IDR complementary pair may be non-IDR. */
+    return first->field && second->field &&
+           first->frame_num == second->frame_num &&
+           first->reference == second->reference &&
+           first->bottom != second->bottom &&
+           (!second->idr || (first->idr &&
+                             first->idr_pic_id == second->idr_pic_id));
+}
+
+static int h264_field_append(AVPacket *first, AVPacket *next, int field)
+{
+    const int size = first->size;
+    int ret;
+
+    if (next->size > INT_MAX - size ||
+        (field && first->duration > 0 && next->duration > 0 &&
+         next->duration > INT64_MAX - first->duration))
+        return AVERROR_INVALIDDATA;
+    ret = av_grow_packet(first, next->size);
+    if (ret < 0)
+        return ret;
+    memcpy(first->data + size, next->data, next->size);
+    first->flags |= next->flags & (AV_PKT_FLAG_CORRUPT | AV_PKT_FLAG_DISCARD);
+    if (field && first->duration > 0 && next->duration > 0)
+        first->duration += next->duration;
+    av_packet_unref(next);
+    return 0;
+}
+
+/* Native SINGLE firmware presents a complementary field pair once. Submit
+ * that pair as one OUTPUT packet, preserving every coded byte and the first
+ * field's PTS/DTS/properties. Frame-coded AUs need no copy or extra latency.
+ * Return one only while retaining a first field, zero for a ready packet.
+ */
+static int h264_pair_packet(AVCodecContext *avctx, V4L2m2mContext *s)
+{
+    V4L2m2mPriv *priv = avctx->priv_data;
+    V4L2H264FieldPair *pair = priv->h264_field_pair;
+    V4L2H264FieldIdentity identity = { 0 };
+    AVPacket *pkt = &s->buf_pkt;
+    int ret, i, pictures = 0, complete = 0;
+
+    if (avctx->codec_id != AV_CODEC_ID_H264 ||
+        !(s->quirks & FF_V4L2_QUIRK_EXPLICIT_DRAIN))
+        return 0;
+
+    if (!pair) {
+        pair = av_mallocz(sizeof(*pair));
+        if (!pair)
+            return AVERROR(ENOMEM);
+        priv->h264_field_pair = pair;
+        ret = ff_cbs_init(&pair->cbs, AV_CODEC_ID_H264, avctx);
+        if (ret < 0) {
+            h264_field_pair_free(priv);
+            return ret;
+        }
+        {
+            static const CodedBitstreamUnitType types[] = {
+                H264_NAL_SPS, H264_NAL_PPS, H264_NAL_SLICE, H264_NAL_IDR_SLICE,
+            };
+            pair->cbs->decompose_unit_types = types;
+            pair->cbs->nb_decompose_unit_types = FF_ARRAY_ELEMS(types);
+        }
+        /* Normalised Annex B extradata matches the BSF's packet framing. */
+        if (s->extdata_size) {
+            ret = ff_cbs_read(pair->cbs, &pair->fragment,
+                              s->extdata_data, s->extdata_size);
+            ff_cbs_fragment_reset(&pair->fragment);
+            if (ret < 0)
+                return ret;
+        }
+    }
+    ret = ff_cbs_read_packet(pair->cbs, &pair->fragment, pkt);
+    if (ret < 0)
+        goto done;
+    for (i = 0; i < pair->fragment.nb_units; ++i) {
+        const CodedBitstreamUnit *unit = &pair->fragment.units[i];
+        const H264RawSlice *slice;
+        V4L2H264FieldIdentity next;
+
+        if (unit->type != H264_NAL_SLICE && unit->type != H264_NAL_IDR_SLICE)
+            continue;
+        if (!unit->content) {
+            ret = AVERROR_INVALIDDATA;
+            goto done;
+        }
+        slice = unit->content;
+        next = (V4L2H264FieldIdentity) {
+            .frame_num = slice->header.frame_num,
+            .idr_pic_id = slice->header.idr_pic_id,
+            .pps_id = slice->header.pic_parameter_set_id,
+            .field = slice->header.field_pic_flag,
+            .bottom = slice->header.bottom_field_flag,
+            .idr = unit->type == H264_NAL_IDR_SLICE,
+            .reference = !!slice->header.nal_unit_header.nal_ref_idc,
+        };
+        if (!pictures) {
+            identity = next;
+            pictures = 1;
+            complete = !next.field;
+        } else if (identity.frame_num == next.frame_num &&
+                   identity.pps_id == next.pps_id &&
+                   identity.field == next.field &&
+                   (!next.field || identity.bottom == next.bottom)) {
+            /* Another slice of the same picture. */
+        } else if (h264_fields_match(&identity, &next)) {
+            complete = 1;
+        } else {
+            ret = AVERROR_INVALIDDATA;
+            goto done;
+        }
+    }
+
+    if (pair->first.size) {
+        if (pictures && (complete || !h264_fields_match(&pair->identity, &identity))) {
+            av_log(avctx, AV_LOG_ERROR, "Unmatched native H264 field before next picture\n");
+            ret = AVERROR_INVALIDDATA;
+            goto done;
+        }
+        ret = h264_field_append(&pair->first, pkt, pictures);
+        if (ret < 0)
+            goto done;
+        if (pictures) {
+            av_packet_move_ref(pkt, &pair->first);
+            ret = 0;
+        } else {
+            ret = 1;
+        }
+    } else if (pictures && !complete) {
+        pair->identity = identity;
+        av_packet_move_ref(&pair->first, pkt);
+        ret = 1;
+    } else {
+        ret = 0;
+    }
+done:
+    ff_cbs_fragment_reset(&pair->fragment);
+    return ret;
+}
+#endif
+
 static int try_enqueue_src(AVCodecContext * const avctx, V4L2m2mContext * const s, const int do_not_get)
 {
     int ret;
@@ -554,10 +732,30 @@
