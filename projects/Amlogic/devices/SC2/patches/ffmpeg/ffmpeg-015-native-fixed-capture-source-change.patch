     if (evt.type == V4L2_EVENT_EOS) {
         av_log(avctx, AV_LOG_TRACE, "V4L2 VIDIOC_EVENT_EOS\n");
+        if ((m->quirks & FF_V4L2_QUIRK_FIXED_CAPTURE) &&
+            !ff_v4l2_ctx_eos(&m->capture))
+            return 0;
         return AVERROR_EOF;
     }
 
     if (evt.type == V4L2_EVENT_SOURCE_CHANGE)
         return do_source_change(m);
@@ -627,8 +651,13 @@
         if (ctx->done) {
             av_log(avctx, AV_LOG_TRACE, "V4L2 %s already done\n", ctx->name);
             return AVERROR_EOF;
         }
+        if (is_cap && m->draining && (m->quirks & FF_V4L2_QUIRK_EXPLICIT_DRAIN) &&
+            ff_v4l2_ctx_eos(ctx)) {
+            ctx->done = 1;
+            return AVERROR_EOF;
+        }
 
         // If capture && timeout == -1 then also wait for rx buffer free
         if (is_cap && timeout == -1 && dq_ok(&m->output) && !m->draining)
             pfd.events |= poll_out;
@@ -644,1 +673,4 @@
+        if (is_cap && (m->quirks & FF_V4L2_QUIRK_FIXED_CAPTURE))
+            pfd.events |= poll_event;
+
         // Timeout kludged s.t. "forever" eventually gives up & produces logging

--- a/configure
+++ b/configure
@@ -3206,7 +3206,7 @@
