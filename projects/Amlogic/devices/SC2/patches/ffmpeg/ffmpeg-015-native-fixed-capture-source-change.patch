                 break;
+            }
 
             if (s->buf_pkt.side_data_elems == 0) {
                 av_log(avctx, AV_LOG_WARNING, "Empty pkt from ff_decode_get_packet - treating as EOF\n");
@@ -582,6 +780,13 @@
         }
 
         if (ret == AVERROR_EOF) {
+#if CONFIG_H264_V4L2M2M_DECODER
+            V4L2H264FieldPair *pair = ((V4L2m2mPriv *)avctx->priv_data)->h264_field_pair;
+            if (pair && pair->first.size) {
