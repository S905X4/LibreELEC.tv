From: hiper25 <whydonit@gmail.com>
Subject: [PATCH] avcodec: drain SC2 H264 capture boundaries before reconfiguration

Wait for old CAPTURE LAST before reallocating on SOURCE_CHANGE. Poll source
events for the boundary contract independently of fixed capture layouts. An
EOS event announces queued tail output, not that CAPTURE has been consumed;
retain explicit draining across capture-only reinitialization.

After OUTPUT reset, orphan variable capture and consume stale events; the
next initial configuration has no old LAST. Always reallocate H264 capture
on source events, including same-size DPB changes with held frames.

--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -421,7 +421,8 @@
     ret = ff_v4l2_context_set_status(&s->capture, VIDIOC_STREAMOFF);
     if (ret)
         av_log(avctx, AV_LOG_ERROR, "capture VIDIOC_STREAMOFF failed\n");
-    s->draining = 0;
+    if (!(s->quirks & FF_V4L2_QUIRK_CAPTURE_BOUNDARY))
+        s->draining = 0;
 
     if (!reinit) {
         /* Buffers are OK so just stream off to ack */
@@ -453,7 +454,9 @@
     }
 
     ret = ff_v4l2_context_set_status(&s->capture, VIDIOC_STREAMON);
-    return 1;
+    if (ret == 0)
+        s->source_change_pending = 0;
+    return ret < 0 ? ret : 1;
 }
 
 static int v4l2_stop_decode(V4L2Context *ctx)
@@ -613,7 +616,8 @@
 
     if (evt.type == V4L2_EVENT_EOS) {
         av_log(avctx, AV_LOG_TRACE, "V4L2 VIDIOC_EVENT_EOS\n");
-        if ((m->quirks & FF_V4L2_QUIRK_FIXED_CAPTURE) &&
+        if ((m->quirks & (FF_V4L2_QUIRK_FIXED_CAPTURE |
+                          FF_V4L2_QUIRK_CAPTURE_BOUNDARY)) &&
             !ff_v4l2_ctx_eos(&m->capture))
             return 0;
         return AVERROR_EOF;
@@ -692,7 +696,8 @@
             return AVERROR(ENOSPC);
         }
 
-        if (is_cap && (m->quirks & FF_V4L2_QUIRK_FIXED_CAPTURE) &&
+        if (is_cap && (m->quirks & (FF_V4L2_QUIRK_FIXED_CAPTURE |
+                                   FF_V4L2_QUIRK_CAPTURE_BOUNDARY)) &&
             !m->source_change_pending)
             pfd.events |= poll_event;
 
--- a/libavcodec/v4l2_m2m_dec.c
+++ b/libavcodec/v4l2_m2m_dec.c
@@ -1442,8 +1442,10 @@
         s->quirks |= FF_V4L2_QUIRK_FIXED_CAPTURE;
     if (strcmp(cap.driver, "meson-sc2-vdec") == 0 &&
         (avctx->codec_id == AV_CODEC_ID_MPEG1VIDEO ||
-         avctx->codec_id == AV_CODEC_ID_MPEG2VIDEO))
+         avctx->codec_id == AV_CODEC_ID_MPEG2VIDEO || avctx->codec_id == AV_CODEC_ID_H264))
         s->quirks |= FF_V4L2_QUIRK_CAPTURE_BOUNDARY;
+    if (strcmp(cap.driver, "meson-sc2-vdec") == 0 && avctx->codec_id == AV_CODEC_ID_H264)
+        s->quirks |= FF_V4L2_QUIRK_REINIT_ALWAYS;
     if (strcmp(cap.driver, "meson-sc2-vdec") == 0 &&
         avctx->codec_id == AV_CODEC_ID_MPEG4 &&
         avctx->framerate.num > 0 && avctx->framerate.den > 0) {
@@ -1826,12 +1828,20 @@
     h264_field_pair_flush(priv);
 #endif
 
-    // Native abort marks both VB2 queues in error. Cancel both queues even
-    // without LAST/EOS, or CAPTURE keeps returning EIO after OUTPUT restarts.
-    // STREAMON requeues only AVAILABLE buffers; downstream-held surfaces keep
-    // their references and cannot be reused by the new decoder epoch.
-    if (ff_v4l2_ctx_eos(capture) ||
-        ((s->quirks & FF_V4L2_QUIRK_EXPLICIT_DRAIN) && capture->streamon)) {
+    // An OUTPUT reset has no old decoded sequence to terminate with LAST.
+    // Leave variable CAPTURE stopped and orphan held exports; the next initial
+    // SOURCE_CHANGE allocates a fresh generation rather than waiting on them.
+    if ((s->quirks & FF_V4L2_QUIRK_CAPTURE_BOUNDARY) &&
+        !(s->quirks & FF_V4L2_QUIRK_FIXED_CAPTURE)) {
+        struct v4l2_event event;
+        ff_v4l2_context_set_status(capture, VIDIOC_STREAMOFF);
+        ff_v4l2_context_release(capture);
+        while (ioctl(s->fd, VIDIOC_DQEVENT, &event) == 0 || errno == EINTR)
+            ;
+        if (errno != EAGAIN)
+            av_log(avctx, AV_LOG_ERROR, "Failed to clear reset V4L2 events: %s\n", av_err2str(AVERROR(errno)));
+    } else if (ff_v4l2_ctx_eos(capture) ||
+               ((s->quirks & FF_V4L2_QUIRK_EXPLICIT_DRAIN) && capture->streamon)) {
         ff_v4l2_context_set_status(capture, VIDIOC_STREAMOFF);
         ff_v4l2_context_set_status(capture, VIDIOC_STREAMON);
     }
