Subject: [PATCH] avcodec: retain frame ownership on failed Request submission

A failed CAPTURE QBUF has not acquired a queue reference. Wake its waiter
as an error without releasing the frame owner. Preserve previously queued
owners when rejecting duplicate or incomplete submissions.

If OUTPUT QBUF or request QUEUE fails after partial submission, actually
cancel both kernel queues before retiring their pins. Make that controller
terminal; retain queue pins if cancellation fails rather than inventing DMA
completion. Keep the submission lock through request QUEUE.

--- a/libavcodec/v4l2_req_media.c
+++ b/libavcodec/v4l2_req_media.c
@@ -624,6 +624,7 @@
 
 struct mediabufs_ctl {
     atomic_int ref_count;  /* 0 is single ref for easier atomics */
+    atomic_bool failed;
     void * dc;
     int vfd;
     bool stream_on;
@@ -760,6 +761,40 @@
     qent_dst_unref(&dst_be);
 }
 
+/* No queue reference is implied: this also retires a failed QBUF attempt. */
+static void qe_dst_failed(struct qent_dst *const dst_be)
+{
+    pthread_mutex_lock(&dst_be->lock);
+    dst_be->base.timestamp = (struct timeval){0};
+    dst_be->base.status = QENT_ERROR;
+    dst_be->waiting = false;
+    pthread_cond_broadcast(&dst_be->cond);
+    pthread_mutex_unlock(&dst_be->lock);
+}
+
+/* mbc->lock excludes submission and dequeue. Retain queue pins if the kernel
+ * cannot cancel; destruction still owns them. Never invent DMA completion. */
+static void mediabufs_fail_queued(struct mediabufs_ctl *const mbc)
+{
+    struct qent_base *src;
+    struct qent_dst *dst;
+    int dst_error, src_error;
+
+    atomic_store(&mbc->failed, true);
+    dst_error = set_stream(mbc->vfd, mbc->dst_fmt.type, false);
+    src_error = set_stream(mbc->vfd, mbc->src_fmt.type, false);
+    if (dst_error || src_error)
+        return;
+
+    mbc->stream_on = false;
+    while ((src = bq_get_inuse(mbc->src)) != NULL)
+        queue_put_free(mbc->src, src);
+    while ((dst = base_to_dst(bq_get_inuse(mbc->dst))) != NULL) {
+        qe_dst_failed(dst);
+        qent_dst_unref(&dst);
+    }
+}
+
 static bool qe_dst_waiting(struct qent_dst *const dst_be)
 {
     bool waiting;
@@ -884,6 +919,10 @@
 {
     struct media_request * mreq = *pmreq;
     struct qent_src *const src_be = *psrc_be;
+    bool dst_wait_owned = false;
+    bool dst_queued = false;
+    bool src_queued = false;
+    bool cancel_queues = false;
 
     // Req & src are always both "consumed"
     *pmreq = NULL;
@@ -891,7 +930,7 @@
 
     pthread_mutex_lock(&mbc->lock);
 
-    if (!src_be)
+    if (atomic_load(&mbc->failed) || !src_be)
         goto fail1;
 
     if (dst_be) {
@@ -899,17 +938,24 @@
             request_info(mbc->dc, "Request buffer already waiting on start\n");
             goto fail1;
         }
+        dst_wait_owned = true;
         dst_be->base.timestamp = (struct timeval){0,0};
         if (qe_v4l2_queue(&dst_be->base, mbc->vfd, NULL, &mbc->dst_fmt, true, false))
             goto fail1;
 
         qent_dst_ref(dst_be);
         queue_put_inuse(mbc->dst, &dst_be->base);
-    }
-
+        dst_queued = true;
+    }
+
+    cancel_queues = true;
     if (qe_v4l2_queue(&src_be->base, mbc->vfd, mreq, &mbc->src_fmt, false, !is_final))
         goto fail1;
     queue_put_inuse(mbc->src, &src_be->base);
+    src_queued = true;
+
+    if (media_request_start(mreq))
+        goto fail1;
 
     if (!mbc->polling && mediabufs_wants_poll(mbc)) {
         mbc->polling = true;
@@ -917,21 +963,17 @@
     }
     pthread_mutex_unlock(&mbc->lock);
 
-    if (media_request_start(mreq))
-        return MEDIABUFS_ERROR_OPERATION_FAILED;
-
     return MEDIABUFS_STATUS_SUCCESS;
 
 fail1:
+    if (cancel_queues)
+        mediabufs_fail_queued(mbc);
     media_request_abort(&mreq);
-    if (src_be)
+    if (src_be && !src_queued)
         queue_put_free(mbc->src, &src_be->base);
 
-// *** TODO: If src Q fails this doesnt unwind properly - separate dst Q from src Q
-    if (dst_be) {
-        dst_be->base.status = QENT_ERROR;
-        qe_dst_done(dst_be);
-    }
+    if (dst_wait_owned && !dst_queued)
+        qe_dst_failed(dst_be);
     pthread_mutex_unlock(&mbc->lock);
     return MEDIABUFS_ERROR_OPERATION_FAILED;
 }
@@ -1270,6 +1312,8 @@
             be_dst->base.status = QENT_IMPORT;
         return be_dst;
     }
+    if (atomic_load(&mbc->failed))
+        return NULL;
 
     if (mbc->dst_fixed) {
         be_dst = base_to_dst(queue_get_free(mbc->dst));
@@ -1392,7 +1436,13 @@
 
 struct qent_src *mediabufs_src_qent_get(struct mediabufs_ctl *const mbc)
 {
-    struct qent_base * buf = queue_get_free(mbc->src);
+    struct qent_base *buf;
+
+    if (atomic_load(&mbc->failed))
+        return NULL;
+    buf = queue_get_free(mbc->src);
+    if (!buf)
+        return NULL;
     buf->status = QENT_PENDING;
     return base_to_src(buf);
 }
@@ -1528,6 +1578,8 @@
 */
 MediaBufsStatus mediabufs_stream_on(struct mediabufs_ctl *const mbc)
 {
+    if (atomic_load(&mbc->failed))
+        return MEDIABUFS_ERROR_OPERATION_FAILED;
     if (mbc->stream_on)
         return MEDIABUFS_STATUS_SUCCESS;
 
@@ -1750,6 +1802,7 @@
         return NULL;
 
     mbc->dc = dc;
+    atomic_init(&mbc->failed, false);
     // Default mono planar
     mbc->pq = pq;
     pthread_mutex_init(&mbc->lock, NULL);
