Subject: [PATCH] avcodec: retire HEVC output before request reinitialization

An SPS size change keeps reordered pictures in the HEVC DPB while replacing
the Request backend. decode_q_wait only joins CPU submission; it does not
wait for CAPTURE completion. Deleting the old controller then cancels its
queued tail pictures, which correctly fail their later post-process check.

Wait for the old backend's still-required output pictures before deleting
its controller. Retain the existing completion/error checks and buffer
ownership. Close/flush removes OUTPUT first, so abandoned frames are not
drained. No input rewriting, increased buffer pool or synthetic completion.

--- a/libavcodec/v4l2_req_hevc_vx.c
+++ b/libavcodec/v4l2_req_hevc_vx.c
@@ -724,6 +724,33 @@
         }
     }
 
+    return 0;
+}
+
+/* SPS reconfiguration retains reordered output in the DPB. Complete those
+ * requests before deleting their controller; STREAMOFF would cancel them.
+ * A close or flush has already removed OUTPUT, so abandoned work is not drained.
+ */
+static int wait_output(AVCodecContext *avctx)
+{
+    const HEVCContext *h = avctx->priv_data;
+    unsigned int i;
+
+    for (i = 0; i < FF_ARRAY_ELEMS(h->DPB); i++) {
+        AVFrame *frame = h->DPB[i].frame;
+        FrameDecodeData *fdd;
+        int ret;
+
+        if (!(h->DPB[i].flags & HEVC_FRAME_FLAG_OUTPUT) || !frame ||
+            frame->format != AV_PIX_FMT_DRM_PRIME || !frame->private_ref)
+            continue;
+        fdd = (FrameDecodeData *)frame->private_ref->data;
+        if (fdd->post_process != frame_post_process)
+            continue;
+        ret = frame_post_process(avctx, frame);
+        if (ret < 0)
+            return ret;
+    }
     return 0;
 }
 
@@ -1515,6 +1542,7 @@
     .start_frame    = v4l2_request_hevc_start_frame,
     .decode_slice   = v4l2_request_hevc_decode_slice,
     .end_frame      = v4l2_request_hevc_end_frame,
+    .wait_output    = wait_output,
     .abort_frame    = v4l2_request_hevc_abort_frame,
     .frame_params   = frame_params,
     .alloc_frame    = alloc_frame,
--- a/libavcodec/v4l2_request_hevc.c
+++ b/libavcodec/v4l2_request_hevc.c
@@ -97,10 +97,13 @@
 static int v4l2_request_hevc_uninit(AVCodecContext *avctx)
 {
     V4L2RequestContextHEVC * const ctx = avctx->internal->hwaccel_priv_data;
+    int ret = 0;
 
     av_log(avctx, AV_LOG_DEBUG, "<<< %s\n", __func__);
 
     decode_q_wait(&ctx->decode_q, NULL);  // Wait for all other threads to be out of decode
+    if (ctx->fns)
+        ret = ctx->fns->wait_output(avctx);
 
     mediabufs_ctl_unref(&ctx->mbufs);
     media_pool_delete(&ctx->mpool);
@@ -114,7 +117,7 @@
 //        AVHWFramesContext *hwfc = (AVHWFramesContext*)avctx->hw_frames_ctx->data;
 //        av_buffer_pool_flush(hwfc->pool);
 //    }
-    return 0;
+    return ret;
 }
 
 static int dst_fmt_accept_cb(void * v, const struct v4l2_fmtdesc *fmtdesc)
--- a/libavcodec/v4l2_request_hevc.h
+++ b/libavcodec/v4l2_request_hevc.h
@@ -95,6 +95,7 @@
     int (*start_frame)(AVCodecContext *avctx, const uint8_t *buf, uint32_t buf_size);
     int (*decode_slice)(AVCodecContext *avctx, const uint8_t *buf, uint32_t buf_size);
     int (*end_frame)(AVCodecContext *avctx);
+    int (*wait_output)(AVCodecContext *avctx);
     void (*abort_frame)(AVCodecContext *avctx);
     int (*frame_params)(AVCodecContext *avctx, AVBufferRef *hw_frames_ctx);
     int (*alloc_frame)(AVCodecContext * avctx, AVFrame *frame);
