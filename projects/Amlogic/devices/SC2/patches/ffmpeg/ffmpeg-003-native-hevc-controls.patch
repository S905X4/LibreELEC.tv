+#else
+static int raw_payload_offset(const HEVCContext *h, const uint8_t *buffer,
+                              uint32_t size, uint32_t *offset)
+{
+    GetBitContext aligned = h->HEVClc->gb;
+    unsigned int rbsp = 0, raw = 0, zeros = 0, target;
+
+    if (get_bits_left(&aligned) < 1 || get_bits1(&aligned) != 1)
+        return AVERROR_INVALIDDATA;
+    while (get_bits_count(&aligned) & 7) {
+        if (get_bits_left(&aligned) < 1 || get_bits1(&aligned))
+            return AVERROR_INVALIDDATA;
+    }
+    target = get_bits_count(&aligned) / 8;
+    while (rbsp < target) {
+        unsigned int byte;
+        if (raw >= size)
+            return AVERROR_INVALIDDATA;
+        byte = buffer[raw++];
+        if (zeros == 2 && byte == 3) {
+            if (raw >= size || buffer[raw] > 3)
+                return AVERROR_INVALIDDATA;
+            zeros = 0;
+            byte = buffer[raw++];
+        }
+        zeros = byte ? 0 : zeros + 1;
+        rbsp++;
+    }
+    if (raw >= size)
+        return AVERROR_INVALIDDATA;
+    *offset = raw;
+    return 0;
+}
+#endif
 
