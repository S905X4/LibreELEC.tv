From: hiper25 <whydonit@gmail.com>
Subject: [PATCH] avfilter: import native planar JPEG surfaces into SC2 EI

Accept distinct Y/U/V planes, validate their actual extents and preserve
all three pitches across session changes. Negotiate native semiplanar
capture and attach matching output metadata, not the source planar layout.
Keep the existing two-field completion and independent export lifetime.

--- a/libavfilter/vf_sc2_deinterlace.c
+++ b/libavfilter/vf_sc2_deinterlace.c
@@ -28,6 +28,38 @@
 
 #define SC2_BUFFERS 8
 
+typedef struct SC2Format {
+    uint32_t drm, v4l2, capture_drm, capture_v4l2;
+    enum AVPixelFormat sw, capture_sw;
+    unsigned planes, chroma_shift;
+} SC2Format;
+
+static const SC2Format sc2_formats[] = {
+    { DRM_FORMAT_NV12, V4L2_PIX_FMT_NV12M,
+      DRM_FORMAT_NV12, V4L2_PIX_FMT_NV12M,
+      AV_PIX_FMT_NV12, AV_PIX_FMT_NV12, 2, 1 },
+    { DRM_FORMAT_NV21, V4L2_PIX_FMT_NV21M,
+      DRM_FORMAT_NV21, V4L2_PIX_FMT_NV21M,
+      AV_PIX_FMT_NV21, AV_PIX_FMT_NV21, 2, 1 },
+    { DRM_FORMAT_YUV420, V4L2_PIX_FMT_YUV420M,
+      DRM_FORMAT_NV12, V4L2_PIX_FMT_NV12M,
+      AV_PIX_FMT_YUV420P, AV_PIX_FMT_NV12, 3, 1 },
+    { DRM_FORMAT_YUV422, V4L2_PIX_FMT_YUV422M,
+      DRM_FORMAT_NV16, V4L2_PIX_FMT_NV16M,
+      AV_PIX_FMT_YUV422P, AV_PIX_FMT_NV16, 3, 0 },
+};
+
+static const SC2Format *sc2_format(uint32_t drm)
+{
+    switch (drm) {
+    case DRM_FORMAT_NV12:   return &sc2_formats[0];
+    case DRM_FORMAT_NV21:   return &sc2_formats[1];
+    case DRM_FORMAT_YUV420: return &sc2_formats[2];
+    case DRM_FORMAT_YUV422: return &sc2_formats[3];
+    default:               return NULL;
+    }
+}
+
 typedef struct SC2Session SC2Session;
 typedef struct SC2Buffer {
     SC2Session *session;
