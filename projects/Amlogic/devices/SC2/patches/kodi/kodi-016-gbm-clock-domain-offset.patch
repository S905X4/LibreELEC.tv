From: SC2 bring-up <sc2@localhost>
Subject: [PATCH] gbm: derive the clock offset from contemporary clock samples

DRM sequence_ns is the last vblank's CLOCK_MONOTONIC timestamp, not the
current time. After an idle display it can be seconds old. Subtracting
that event timestamp from the current host counter incorporates its age
into the clock-domain offset; subsequent fresh vblanks are then reported
to the reference clock in the future.

Sample CLOCK_MONOTONIC alongside the host counter instead. Keep the real
vblank sequence deltas and event timestamps; do not synthesize ticks or
change presentation deadlines.

--- a/xbmc/windowing/gbm/VideoSyncGbm.cpp
+++ b/xbmc/windowing/gbm/VideoSyncGbm.cpp
@@ -22,6 +22,7 @@
 #include <assert.h>
 #include <stdint.h>
 #include <stdlib.h>
+#include <time.h>
 
 #include <unistd.h>
 
@@ -62,14 +63,24 @@
   uint64_t ns = 0;
   m_crtcId = crtc->GetCrtcId();
   m_fd = drm->GetFileDescriptor();
   int s = drmCrtcGetSequence(m_fd, m_crtcId, &m_sequence, &ns);
-  m_offset = CurrentHostCounter() - ns;
   if (s != 0)
   {
     CLog::Log(LOGWARNING, "CVideoSyncGbm::{}: drmCrtcGetSequence failed ({})", __FUNCTION__, s);
     return false;
   }
 
+  // The last vblank may be old; sample the clock domain, not the event age.
+  timespec now;
+  if (clock_gettime(CLOCK_MONOTONIC, &now) != 0)
+  {
+    CLog::Log(LOGWARNING, "CVideoSyncGbm::{}: clock_gettime failed", __FUNCTION__);
+    return false;
+  }
+
+  m_offset = CurrentHostCounter() -
+             (static_cast<uint64_t>(now.tv_sec) * 1000000000ULL + now.tv_nsec);
+
   CLog::Log(LOGINFO, "CVideoSyncGbm::{}: opened (fd:{} crtc:{} seq:{} ns:{}:{})", __FUNCTION__,
             m_fd, m_crtcId, m_sequence, ns, m_offset + ns);
   return true;
