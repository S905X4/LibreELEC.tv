+bool CVideoPlayerVideo::ProcessOutput(double& frametime, double& pts, bool notifyStarted)
+{
+  m_outputSate = OutputPicture(&m_picture);
+  if (m_outputSate == OUTPUT_AGAIN)
+    return true;
+  if (m_outputSate == OUTPUT_ABORT)
+  {
+    FinishDrain(CDVDMsgVideoDrain::State::Failed);
+    return false;
+  }
+  if (m_outputSate == OUTPUT_DROPPED && !(m_picture.iFlags & DVP_FLAG_DROPPED))
+  {
+    m_iDroppedFrames++;
+    m_ptsTracker.Flush();
+  }
+  if (notifyStarted && m_syncState == IDVDStreamPlayer::SYNC_STARTING &&
+      m_outputSate != OUTPUT_DROPPED && !(m_picture.iFlags & DVP_FLAG_DROPPED))
+  {
+    m_syncState = IDVDStreamPlayer::SYNC_WAITSYNC;
+    SStartMsg msg;
+    msg.player = VideoPlayer_VIDEO;
+    msg.cachetime = DVD_MSEC_TO_TIME(50);
+    msg.cachetotal = DVD_MSEC_TO_TIME(100);
+    msg.timestamp = m_pictureHasTimestamp ? pts + m_renderManager.GetDelay() * 1000
+                                          : DVD_NOPTS_VALUE;
+    m_messageParent.Put(std::make_shared<CDVDMsgType<SStartMsg>>(CDVDMsg::PLAYER_STARTED, msg));
+  }
+  frametime = (double)DVD_TIME_BASE / m_fFrameRate;
+  return true;
+}
+
+void CVideoPlayerVideo::StartDrain(std::shared_ptr<CDVDMsgVideoDrain> request)
+{
+  FinishDrain(CDVDMsgVideoDrain::State::Canceled);
+  m_drainRequest = std::move(request);
+  if (!m_pVideoCodec)
+    FinishDrain(CDVDMsgVideoDrain::State::Failed);
+  else if (m_decoderDrained)
+    FinishDrain(CDVDMsgVideoDrain::State::Complete);
+  else
+    m_pVideoCodec->SetCodecControl(DVD_CODEC_CTRL_DRAIN);
+}
+
+void CVideoPlayerVideo::FinishDrain(CDVDMsgVideoDrain::State state)
+{
+  if (m_drainRequest)
+  {
+    m_decoderDrained = state != CDVDMsgVideoDrain::State::Canceled;
+    m_drainRequest->Finish(state);
+    m_drainRequest.reset();
+  }
+}
+
 void CVideoPlayerVideo::OnExit()
 {
+  FinishDrain(CDVDMsgVideoDrain::State::Canceled);
   CLog::Log(LOGINFO, "thread end: video_thread");
 }
 
