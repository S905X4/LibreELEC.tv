+// A drain belongs to the queued stream epoch, not to the current queue size.
+class CDVDMsgVideoDrain : public CDVDMsg
+{
+public:
+  enum class State { Pending, Complete, Failed, Canceled };
+  CDVDMsgVideoDrain() : CDVDMsg(VIDEO_DRAIN) {}
+  State GetState() const { return m_state.load(); }
+  void Finish(State state)
+  {
+    m_state.store(state);
+    m_finished.Set();
+  }
+  bool Wait()
+  {
+    // Match the existing queue-drain deadline; completion wakes immediately.
+    return m_finished.Wait(std::chrono::seconds(40)) && GetState() == State::Complete;
+  }
+
+private:
+  std::atomic<State> m_state{State::Pending};
+  CEvent m_finished;
+};
