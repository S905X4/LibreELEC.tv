   double m_DAR = 1.0;
   AVCodecContext* m_pCodecContext = nullptr;
   AVFrame* m_pFrame = nullptr;
+  bool m_drainSubmitted = false;
+  bool m_decoderError = false;
   struct AVFilterGraph* m_deinterlaceGraph = nullptr;
   struct AVFilterContext* m_deinterlaceSource = nullptr;
   struct AVFilterContext* m_deinterlaceSink = nullptr;
