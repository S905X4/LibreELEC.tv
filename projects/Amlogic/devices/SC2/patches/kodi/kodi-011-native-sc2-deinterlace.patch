+void CDVDVideoCodecDRMPRIME::ResetDeinterlace()
+{
+  avfilter_graph_free(&m_deinterlaceGraph);
+  m_deinterlaceSource = nullptr;
+  m_deinterlaceSink = nullptr;
+  m_deinterlaceDraining = false;
+  m_deinterlaceWidth = m_deinterlaceHeight = 0;
+  m_processInfo.SetVideoDeintMethod("none");
+}
+
+int CDVDVideoCodecDRMPRIME::EnsureDeinterlace()
+{
+  if (m_deinterlaceGraph && m_deinterlaceWidth == m_pFrame->width &&
+      m_deinterlaceHeight == m_pFrame->height)
+    return 0;
+
+  ResetDeinterlace();
+  const AVFilter* deinterlace = avfilter_get_by_name("sc2_deinterlace");
+  if (!deinterlace)
+    return AVERROR(ENOSYS);
+
+  m_deinterlaceGraph = avfilter_graph_alloc();
+  if (!m_deinterlaceGraph)
+    return AVERROR(ENOMEM);
+
+  m_deinterlaceSource = avfilter_graph_alloc_filter(
+      m_deinterlaceGraph, avfilter_get_by_name("buffer"), "sc2-input");
+  AVFilterContext* hardware =
+      avfilter_graph_alloc_filter(m_deinterlaceGraph, deinterlace, "sc2-hardware-ei");
+  m_deinterlaceSink = avfilter_graph_alloc_filter(
+      m_deinterlaceGraph, avfilter_get_by_name("buffersink"), "sc2-output");
+  if (!m_deinterlaceSource || !hardware || !m_deinterlaceSink)
+  {
+    ResetDeinterlace();
+    return AVERROR(ENOMEM);
+  }
+
+  AVBufferSrcParameters* params = av_buffersrc_parameters_alloc();
+  if (!params)
+  {
+    ResetDeinterlace();
+    return AVERROR(ENOMEM);
+  }
+  params->format = AV_PIX_FMT_DRM_PRIME;
+  params->time_base = AVRational{1, AV_TIME_BASE};
+  params->width = m_pFrame->width;
+  params->height = m_pFrame->height;
+  params->sample_aspect_ratio = m_pFrame->sample_aspect_ratio;
+  params->frame_rate = m_pCodecContext->framerate;
+  if (params->frame_rate.num <= 0 && m_hints.fpsrate > 0 && m_hints.fpsscale > 0)
+    params->frame_rate = AVRational{m_hints.fpsrate, m_hints.fpsscale};
+  params->hw_frames_ctx = m_pFrame->hw_frames_ctx;
+  int ret = av_buffersrc_parameters_set(m_deinterlaceSource, params);
+  av_free(params);
+  if (ret >= 0)
+    ret = avfilter_init_str(m_deinterlaceSource, nullptr);
+  if (ret >= 0)
+    ret = avfilter_init_str(hardware, nullptr);
+  if (ret >= 0)
+    ret = avfilter_init_str(m_deinterlaceSink, nullptr);
+  if (ret >= 0)
+    ret = avfilter_link(m_deinterlaceSource, 0, hardware, 0);
+  if (ret >= 0)
+    ret = avfilter_link(hardware, 0, m_deinterlaceSink, 0);
+  if (ret >= 0)
+    ret = avfilter_graph_config(m_deinterlaceGraph, nullptr);
+  if (ret < 0)
+  {
+    ResetDeinterlace();
+    return ret;
+  }
+
+  m_deinterlaceWidth = m_pFrame->width;
+  m_deinterlaceHeight = m_pFrame->height;
+  return 0;
+}
+
+int CDVDVideoCodecDRMPRIME::ReceiveFrame()
+{
+  av_frame_unref(m_pFrame);
+  for (;;)
+  {
+    if (m_deinterlaceGraph)
+    {
+      const int ret = av_buffersink_get_frame(m_deinterlaceSink, m_pFrame);
+      if (ret >= 0)
+      {
+        const AVRational timeBase = av_buffersink_get_time_base(m_deinterlaceSink);
+        if (m_pFrame->pts != AV_NOPTS_VALUE)
+          m_pFrame->pts = av_rescale_q(m_pFrame->pts, timeBase, AVRational{1, AV_TIME_BASE});
+        m_pFrame->best_effort_timestamp = m_pFrame->pts;
+        m_pFrame->duration = av_rescale_q(m_pFrame->duration, timeBase,
+                                        AVRational{1, AV_TIME_BASE});
+        // This label is set only after a completed hardware field reaches the sink.
+        m_processInfo.SetVideoDeintMethod("SC2 hardware EI full-rate (not MA/MC)");
+        return 0;
+      }
+      if (ret != AVERROR(EAGAIN))
+        return ret;
+    }
+
+    int ret = avcodec_receive_frame(m_pCodecContext, m_pFrame);
+    if (ret == AVERROR_EOF && m_deinterlaceGraph && !m_deinterlaceDraining)
+    {
+      ret = av_buffersrc_add_frame_flags(m_deinterlaceSource, nullptr, 0);
+      if (ret < 0)
+        return ret;
+      m_deinterlaceDraining = true;
+      continue;
+    }
+    if (ret < 0)
+      return ret;
+
+    if (m_pFrame->format != AV_PIX_FMT_DRM_PRIME || !m_pFrame->interlaced_frame)
+    {
+      ResetDeinterlace();
+      // A progressive frame bypasses DI and retains the existing timing path.
+      return 0;
+    }
+    ret = EnsureDeinterlace();
+    if (ret < 0)
+    {
+      CLog::Log(LOGERROR, "DRM PRIME native SC2 hardware deinterlace unavailable: {}", ret);
+      av_frame_unref(m_pFrame);
+      return ret; // Never substitute software pixels or pretend DI completed.
+    }
+
+    if (m_pFrame->best_effort_timestamp != AV_NOPTS_VALUE)
+      m_pFrame->pts = m_pFrame->best_effort_timestamp;
+    ret = av_buffersrc_add_frame_flags(m_deinterlaceSource, m_pFrame,
+                                      AV_BUFFERSRC_FLAG_KEEP_REF);
+    av_frame_unref(m_pFrame);
+    if (ret < 0)
+      return ret;
+  }
+}
