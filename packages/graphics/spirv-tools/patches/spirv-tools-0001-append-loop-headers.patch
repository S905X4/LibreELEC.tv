From: hiper25 <whydonit@gmail.com>
Subject: [PATCH] val: append loop headers through the default-constructed vector

RegisterLoopMerge appends a header whether a continue target is new or
already known. unordered_map::operator[] supplies an empty vector for a
new target, so both cases can use push_back directly. This also avoids
GCC 12's array-bounds diagnostic in the initializer-list assignment path
without disabling warnings or changing the compatible SPIR-V revision.

diff --git a/source/val/function.cpp b/source/val/function.cpp
--- a/source/val/function.cpp
+++ b/source/val/function.cpp
@@ -86,12 +86,7 @@ spv_result_t Function::RegisterLoopMerge(uint32_t merge_id,
   continue_construct.set_corresponding_constructs({&loop_construct});
   loop_construct.set_corresponding_constructs({&continue_construct});
   merge_block_header_[&merge_block] = current_block_;
-  if (continue_target_headers_.find(&continue_target_block) ==
-      continue_target_headers_.end()) {
-    continue_target_headers_[&continue_target_block] = {current_block_};
-  } else {
-    continue_target_headers_[&continue_target_block].push_back(current_block_);
-  }
+  continue_target_headers_[&continue_target_block].push_back(current_block_);
 
   return SPV_SUCCESS;
 }
