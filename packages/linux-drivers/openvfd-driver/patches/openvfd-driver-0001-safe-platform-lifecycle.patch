+/* Called with mutex held, after all public interfaces are removed. */
+static void free_platform_data(void)
+{
+	struct vfd_dev *dev = pdata->dev;
+	struct vfd_pin *pins[] = {
+		&dev->clk_pin, &dev->dat_pin, &dev->stb_pin,
+		&dev->gpio0_pin, &dev->gpio1_pin, &dev->gpio2_pin,
+		&dev->gpio3_pin,
+	};
+	size_t i;
+
