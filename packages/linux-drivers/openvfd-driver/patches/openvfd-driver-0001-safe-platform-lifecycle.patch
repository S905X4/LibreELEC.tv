+static void openvfd_dev_free(struct kref *ref)
+{
+	struct vfd_dev *dev = container_of(ref, struct vfd_dev, refcount);
+
+	kfree(dev);
+}
+
+/* The caller holds mutex; an open file may outlive platform unbind. */
+static bool openvfd_dev_active(struct vfd_dev *dev)
+{
+	return ready && pdata && pdata->dev == dev;
+}
 
